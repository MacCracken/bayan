# toml_tree.cyr — TOML 1.0.0 into the shared tagged value tree (1.11.0).
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-toml-tree.cyr" (sublib).
#
# bayan_toml_v_parse(src) reads a TOML document into the same 24-byte JTAG_* cells
# bayan_json_v_parse and bayan_yaml_parse return (ADR 0013). A consumer walks a TOML file with the
# bayan_json_v_* accessors, and looks a key up with bayan_json_v_obj_get_by_cstr / _by_str, the one
# lookup the three formats share.
#
#   TOML                          the tree
#   table, inline table           JTAG_OBJ, its keys in document order
#   array, array of tables        JTAG_ARR
#   string, all four forms        JTAG_STR, escapes decoded; CR LF in a multi-line string reads as LF
#   integer                       JTAG_INT
#   float                         JTAG_FLOAT, correctly rounded; inf and nan keep their sign
#   boolean                       JTAG_BOOL
#   date-time, date, time         JTAG_STR holding the text as written, and
#                                 bayan_toml_v_datetime_kind(v) says which kind (TOML_DT_*)
#
# STRICT. The flat parser in toml.cyr has no error channel and degrades. This one answers what
# Python's tomllib answers: a document tomllib accepts parses to the tree tomllib builds, and one
# it refuses is refused, with a message and a byte offset. tests/fixtures/toml/tree.vec holds
# tomllib's answers (scripts/gen-toml-tree-vectors.py). It disagrees in three places, each because
# the tree cannot hold what tomllib holds:
#   * an integer outside i64 is refused ("integer out of range"); tomllib returns a Python int;
#   * nesting past _JP_MAX_DEPTH (128) containers is refused ("nesting too deep"), counting the
#     root table, as json and yaml count; tomllib stops at Python's recursion limit;
#   * the input is bytes, so invalid UTF-8 in a string, a key or a comment is refused
#     ("invalid utf-8"), where tomllib.load raises UnicodeDecodeError before it parses.
#
# The flat parser's two subset edges (toml.cyr's header) have answers here. `a."b.c".d = 1` is three
# nested tables, the middle one named `b.c`, and `[[a.b]]` under a dotted parent is one array.
#
# The tables a document may define, and when, follow tomllib's model, kept as three flags in a
# container's reserved word (+16) while the parse runs and cleared before it returns:
#   EXPLICIT  a [header] named it, or a dotted key opened it in an EARLIER section: no header may
#             name it again, and no dotted key may extend it;
#   FROZEN    an inline table or a static array: nothing extends it;
#   PENDING   a dotted key opened it in this section; it becomes EXPLICIT at the next header.
# An array of tables never takes a [header], and a dotted key never passes through one.
#
# Reentrant, as json and yaml are: the per-call state is json's (bayan_json_parse_state_size()),
# read with bayan_toml_v_state_error(ps) / _pos(ps), and the globals-compat entries mirror it into
# bayan_toml_v_last_error() / _pos(). Every allocation goes through the allocator given
# (default_alloc() for the forms that take none), strings are copies, so the tree does not borrow
# the source, and a refused allocation returns 0 with "out of memory". Key lookups during the parse
# go through a hash index, so a table of n keys costs O(n), not O(n^2).
#
# NOTE (single-pass bundle order): this module calls json.cyr's constructors and parser state and
# math.cyr's f64_parse_n, so it comes after src/json.cyr in [lib].modules and in include lists.

# === Public kinds ================================================================================

# What bayan_toml_v_datetime_kind returns for a string cell this parser made from a date or time.
const TOML_DT_OFFSET = 1;   # 1979-05-27T07:32:00Z, 1979-05-27 00:32:00-07:00
const TOML_DT_LOCAL  = 2;   # 1979-05-27T07:32:00
const TOML_DT_DATE   = 3;   # 1979-05-27
const TOML_DT_TIME   = 4;   # 07:32:00

# === Parse context ===============================================================================
#
# Beside json's 48-byte state, one per call, on the caller's stack.
const _TC_A      = 0;    # the allocator
const _TC_PS     = 8;    # json's per-call state: buf, len, error
const _TC_SLOTS  = 16;   # key index: slots of {parent, key Str, value}, 24 bytes each
const _TC_CAP    = 24;   # slot count, a power of two
const _TC_COUNT  = 32;   # slots in use
const _TC_PEND   = 40;   # vec of the containers a dotted key opened since the last header
const _TC_PARTS  = 48;   # vec of the current key's parts, reused key to key
const _TC_HEAD   = 56;   # the table the current section writes into
const _TC_HLEVEL = 64;   # its level: the root table is 1
const _TC_ROOT   = 72;   # the root table, where every header's walk starts
const _TC_SIZE   = 80;

# Container flags, in the cell's reserved word during a parse.
const _TF_EXPLICIT = 1;
const _TF_FROZEN   = 2;
const _TF_PENDING  = 4;

var _toml_v_err_msg = 0;
var _toml_v_err_pos = 0;

# Return the last tree-parse error message (cstr), set on a bayan_toml_v_parse* failure through
# the globals-compat entries. Concurrent callers use the ctx path and bayan_toml_v_state_error().
fn bayan_toml_v_last_error(): i64 {
    if (_toml_v_err_msg == 0) { return ""; }
    return _toml_v_err_msg;
}

# Return the last tree-parse error's byte offset.
fn bayan_toml_v_last_error_pos(): i64 { return _toml_v_err_pos; }

# Read the parse error from a caller-owned parser state (race-free).
fn bayan_toml_v_state_error(ps): i64 { return bayan_json_state_error(ps); }

# Byte offset companion of bayan_toml_v_state_error.
fn bayan_toml_v_state_error_pos(ps): i64 { return bayan_json_state_error_pos(ps); }

# The TOML_DT_* kind of a string cell bayan_toml_v_parse made from a date or time, or 0 for any
# other cell, for 0, and for every cell json or yaml made (their reserved word is 0).
fn bayan_toml_v_datetime_kind(v): i64 {
    if (v == 0) { return 0; }
    if (load64(v) != JTAG_STR) { return 0; }
    return load64(v + 16);
}

# === Small helpers ===============================================================================

# Record the error and return -1, the failure every scanner here returns.
fn _tv_err(c, msg, pos): i64 {
    _jp_set_err(load64(c + _TC_PS), msg, pos);
    return 0 - 1;
}

fn _tv_oom(c, pos): i64 { return _tv_err(c, "out of memory", pos); }

# Skip spaces and tabs.
fn _tv_ws(buf, pos, end): i64 {
    while (pos < end) {
        var ch = load8(buf + pos);
        if (ch != 32 && ch != 9) { break; }
        pos = pos + 1;
    }
    return pos;
}

# The length of the newline at pos: 1 for LF, 2 for CR LF, 0 for anything else, a lone CR included.
fn _tv_nl(buf, pos, end): i64 {
    if (pos >= end) { return 0; }
    var ch = load8(buf + pos);
    if (ch == 10) { return 1; }
    if (ch == 13 && pos + 1 < end && load8(buf + pos + 1) == 10) { return 2; }
    return 0;
}

# True for a byte TOML forbids in a string body or a comment: a control byte other than tab, or DEL.
fn _tv_ctl(ch): bool {
    if (ch == 9) { return false; }
    return ch < 32 || ch == 127;
}

# A bare key byte: A-Z a-z 0-9 - _.
fn _tv_bare(ch): bool {
    if (ch >= 97 && ch <= 122) { return true; }
    if (ch >= 65 && ch <= 90) { return true; }
    if (ch >= 48 && ch <= 57) { return true; }
    return ch == 45 || ch == 95;
}

fn _tv_isdig(ch): bool { return ch >= 48 && ch <= 57; }

# The value of `ch` as a digit of `base` (2, 8, 10 or 16), or -1.
fn _tv_digit(ch, base): i64 {
    var v = 0 - 1;
    if (ch >= 48 && ch <= 57) { v = ch - 48; }
    elif (ch >= 97 && ch <= 102) { v = ch - 87; }
    elif (ch >= 65 && ch <= 70) { v = ch - 55; }
    if (v >= base) { return 0 - 1; }
    return v;
}

# True if the bytes at pos spell `w`.
fn _tv_word(buf, pos, end, w): bool {
    var n = strlen(w);
    if (pos + n > end) { return false; }
    return memeq(buf + pos, w, n) == 1;
}

# The length of the well-formed UTF-8 sequence at pos, whose first byte is 0x80 or above, or 0. The
# rules are Python's strict decoder's: no overlong form, no surrogate, nothing past U+10FFFF.
fn _tv_utf8(buf, pos, end): i64 {
    var b0 = load8(buf + pos);
    var n = 0;
    var lo = 128;
    var hi = 191;
    if (b0 >= 194 && b0 <= 223) { n = 2; }
    elif (b0 >= 224 && b0 <= 239) {
        n = 3;
        if (b0 == 224) { lo = 160; }
        if (b0 == 237) { hi = 159; }
    }
    elif (b0 >= 240 && b0 <= 244) {
        n = 4;
        if (b0 == 240) { lo = 144; }
        if (b0 == 244) { hi = 143; }
    }
    else { return 0; }
    if (pos + n > end) { return 0; }
    var b1 = load8(buf + pos + 1);
    if (b1 < lo || b1 > hi) { return 0; }
    var k = 2;
    while (k < n) {
        var bk = load8(buf + pos + k);
        if (bk < 128 || bk > 191) { return 0; }
        k = k + 1;
    }
    return n;
}

# Write code point cp as UTF-8 at dst; return its length.
fn _tv_put_utf8(dst, cp): i64 {
    if (cp < 128) {
        store8(dst, cp);
        return 1;
    }
    if (cp < 2048) {
        store8(dst, 192 | (cp >> 6));
        store8(dst + 1, 128 | (cp & 63));
        return 2;
    }
    if (cp < 65536) {
        store8(dst, 224 | (cp >> 12));
        store8(dst + 1, 128 | ((cp >> 6) & 63));
        store8(dst + 2, 128 | (cp & 63));
        return 3;
    }
    store8(dst, 240 | (cp >> 18));
    store8(dst + 1, 128 | ((cp >> 12) & 63));
    store8(dst + 2, 128 | ((cp >> 6) & 63));
    store8(dst + 3, 128 | (cp & 63));
    return 4;
}

# At a `#`: check the comment and return the position of the newline that ends it, or the end of
# the input, or -1. A comment holds tab, printable ASCII and well-formed UTF-8; any other control
# byte is refused, DEL included, and a CR is allowed only as the first half of CR LF.
fn _tv_comment(c, buf, pos, end): i64 {
    pos = pos + 1;
    while (pos < end) {
        var ch = load8(buf + pos);
        if (ch == 10) { return pos; }
        if (ch >= 128) {
            var n = _tv_utf8(buf, pos, end);
            if (n == 0) { return _tv_err(c, "invalid utf-8", pos); }
            pos = pos + n;
        }
        elif (ch == 13) {
            if (_tv_nl(buf, pos, end) == 2) { return pos; }
            return _tv_err(c, "illegal character in a comment", pos);
        }
        elif (_tv_ctl(ch)) { return _tv_err(c, "illegal character in a comment", pos); }
        else { pos = pos + 1; }
    }
    return pos;
}

# Skip what may sit between an array's values: spaces, tabs, newlines and comments.
fn _tv_skip_array_ws(c, buf, pos, end): i64 {
    loop {
        if (pos >= end) { break; }
        var ch = load8(buf + pos);
        if (ch == 32 || ch == 9 || ch == 10) { pos = pos + 1; }
        elif (ch == 13 && _tv_nl(buf, pos, end) == 2) { pos = pos + 2; }
        elif (ch == 35) {
            pos = _tv_comment(c, buf, pos, end);
            if (pos < 0) { return pos; }
        }
        else { break; }
    }
    return pos;
}

# === The key index ===============================================================================
#
# One open-addressing table for the whole parse, keyed by (parent cell, key bytes). Every key a
# document defines goes in, so finding a table's child, and refusing a duplicate, costs O(1) where
# a walk of the object's pairs would make a table of n keys cost O(n^2).

fn _tv_hash(parent, data, len): i64 {
    var h = 0xCBF29CE484222325;
    var i = 0;
    while (i < len) {
        h = (h ^ load8(data + i)) * 0x100000001B3;
        i = i + 1;
    }
    h = (h ^ parent) * 0x9E3779B97F4A7C15;
    return h ^ (h >> 29);
}

# A zeroed slot array of `cap` slots, or 0.
fn _tv_slots_new(a, cap): i64 {
    var s = alloc_via(a, cap * 24);
    if (s == 0) { return 0; }
    memset(s, 0, cap * 24);
    return s;
}

# The child of `parent` named data[0, len), or 0.
fn _tv_find(c, parent, data, len): i64 {
    var slots = load64(c + _TC_SLOTS);
    var mask = load64(c + _TC_CAP) - 1;
    var i = _tv_hash(parent, data, len) & mask;
    loop {
        var s = slots + i * 24;
        var sp = load64(s);
        if (sp == 0) { return 0; }
        if (sp == parent) {
            var k = load64(s + 8);
            if (str_len(k) == len) {
                if (memeq(str_data(k), data, len) == 1) { return load64(s + 16); }
            }
        }
        i = (i + 1) & mask;
    }
    return 0;
}

# The child of `parent` named by the Str `key`, or 0.
fn _tv_find_str(c, parent, key): i64 {
    return _tv_find(c, parent, str_data(key), str_len(key));
}

# Put a slot into `slots` (mask `mask`) without growing.
fn _tv_slot_put(slots, mask, parent, key, val): i64 {
    var i = _tv_hash(parent, str_data(key), str_len(key)) & mask;
    while (load64(slots + i * 24) != 0) { i = (i + 1) & mask; }
    var s = slots + i * 24;
    store64(s, parent);
    store64(s + 8, key);
    store64(s + 16, val);
    return 0;
}

# Index key -> val under parent, doubling the table at half full. 0, or -1 when refused.
fn _tv_index(c, parent, key, val): i64 {
    var cap = load64(c + _TC_CAP);
    var n = load64(c + _TC_COUNT);
    if ((n + 1) * 2 > cap) {
        var ncap = cap * 2;
        var ns = _tv_slots_new(load64(c + _TC_A), ncap);
        if (ns == 0) { return 0 - 1; }
        var old = load64(c + _TC_SLOTS);
        var i = 0;
        while (i < cap) {
            var s = old + i * 24;
            if (load64(s) != 0) { _tv_slot_put(ns, ncap - 1, load64(s), load64(s + 8), load64(s + 16)); }
            i = i + 1;
        }
        store64(c + _TC_SLOTS, ns);
        store64(c + _TC_CAP, ncap);
        cap = ncap;
    }
    _tv_slot_put(load64(c + _TC_SLOTS), cap - 1, parent, key, val);
    store64(c + _TC_COUNT, n + 1);
    return 0;
}

# Add key -> val to the object obj, and to the index. 0, or -1 when an allocation is refused.
fn _tv_set(c, obj, key, val): i64 {
    if (bayan_json_v_obj_set_a(load64(c + _TC_A), obj, key, val) < 0) { return 0 - 1; }
    return _tv_index(c, obj, key, val);
}

# A new empty table under parent, named key, at `level`. The table, or -1 (the error is set).
fn _tv_new_table(c, parent, key, level, pos): i64 {
    if (level > _JP_MAX_DEPTH) { return _tv_err(c, "nesting too deep", pos); }
    var t = bayan_json_v_obj_new_a(load64(c + _TC_A));
    if (t == 0) { return _tv_oom(c, pos); }
    if (_tv_set(c, parent, key, t) < 0) { return _tv_oom(c, pos); }
    return t;
}

# === Strings =====================================================================================

# The length of the escape at pos (a backslash), checked, or -1. In a multi-line basic string a
# backslash may end its line, after any spaces and tabs: the escape is then the run to that line's
# newline. The spaces, tabs and newlines after it are ordinary body bytes to this scan, and
# _tv_decode drops the whole run.
fn _tv_escape_len(c, buf, pos, end, ml): i64 {
    if (pos + 1 >= end) { return _tv_err(c, "unterminated string", end); }
    var e = load8(buf + pos + 1);
    if (e == 98 || e == 116 || e == 110 || e == 102 || e == 114 || e == 34 || e == 92) { return 2; }
    if (e == 117 || e == 85) {
        var nd = 4;
        if (e == 85) { nd = 8; }
        if (pos + 2 + nd > end) { return _tv_err(c, "invalid unicode escape", pos); }
        var cp = 0;
        var i = 0;
        while (i < nd) {
            var h = _tv_digit(load8(buf + pos + 2 + i), 16);
            if (h < 0) { return _tv_err(c, "invalid unicode escape", pos); }
            cp = cp * 16 + h;
            i = i + 1;
        }
        if ((cp >= 55296 && cp <= 57343) || cp > 1114111) {
            return _tv_err(c, "escape is not a unicode scalar value", pos);
        }
        return 2 + nd;
    }
    if (ml == 1 && (e == 32 || e == 9 || e == 10 || e == 13)) {
        var q = _tv_ws(buf, pos + 1, end);
        var nl = _tv_nl(buf, q, end);
        if (nl == 0) {
            if (q >= end) { return _tv_err(c, "unterminated string", end); }
            return _tv_err(c, "invalid escape", pos);
        }
        return q + nl - pos;
    }
    return _tv_err(c, "invalid escape", pos);
}

# Scan a string body from pos, just past its opening quote or quotes, to its closing delimiter;
# return the delimiter's position, or -1. `q` is the quote (34 basic, 39 literal), `ml` 1 for a
# multi-line string. Every byte and escape is checked here, so _tv_decode writes without checking.
fn _tv_scan(c, buf, pos, end, q, ml): i64 {
    loop {
        if (pos >= end) { return _tv_err(c, "unterminated string", pos); }
        var ch = load8(buf + pos);
        if (ch == q) {
            if (ml == 0) { return pos; }
            if (pos + 2 < end && load8(buf + pos + 1) == q && load8(buf + pos + 2) == q) { return pos; }
            pos = pos + 1;
        }
        elif (ch == 92 && q == 34) {
            var e = _tv_escape_len(c, buf, pos, end, ml);
            if (e < 0) { return e; }
            pos = pos + e;
        }
        elif (ch >= 128) {
            var n = _tv_utf8(buf, pos, end);
            if (n == 0) { return _tv_err(c, "invalid utf-8", pos); }
            pos = pos + n;
        }
        elif (ml == 1 && ch == 10) { pos = pos + 1; }
        elif (ml == 1 && _tv_nl(buf, pos, end) == 2) { pos = pos + 2; }
        elif (_tv_ctl(ch)) { return _tv_err(c, "illegal character in a string", pos); }
        else { pos = pos + 1; }
    }
    return 0 - 1;
}

# Write the checked body buf[from, to) to dst; return the bytes written. A basic body has its
# escapes decoded; a CR, which _tv_scan allows only before an LF, is dropped, so CR LF reads as LF.
fn _tv_decode(buf, from, to, dst, q): i64 {
    var o = 0;
    var p = from;
    while (p < to) {
        var ch = load8(buf + p);
        if (ch == 92 && q == 34) {
            var e = load8(buf + p + 1);
            var b = 0 - 1;
            if (e == 98) { b = 8; }
            elif (e == 116) { b = 9; }
            elif (e == 110) { b = 10; }
            elif (e == 102) { b = 12; }
            elif (e == 114) { b = 13; }
            elif (e == 34) { b = 34; }
            elif (e == 92) { b = 92; }
            if (b >= 0) {
                store8(dst + o, b);
                o = o + 1;
                p = p + 2;
            }
            elif (e == 117 || e == 85) {
                var nd = 4;
                if (e == 85) { nd = 8; }
                var cp = 0;
                var i = 0;
                while (i < nd) {
                    cp = cp * 16 + _tv_digit(load8(buf + p + 2 + i), 16);
                    i = i + 1;
                }
                o = o + _tv_put_utf8(dst + o, cp);
                p = p + 2 + nd;
            }
            else {
                # A line-ending backslash: skip to the next byte that is not whitespace.
                p = p + 1;
                while (p < to) {
                    var w = load8(buf + p);
                    if (w != 32 && w != 9 && w != 10 && w != 13) { break; }
                    p = p + 1;
                }
            }
        }
        elif (ch == 13) { p = p + 1; }
        else {
            store8(dst + o, ch);
            o = o + 1;
            p = p + 1;
        }
    }
    return o;
}

# Parse the string at pos (an opening quote) into *out, a new Str; return the position after it,
# or -1. `allow_ml` 0 is a key: `"""` there is the empty string `""` followed by a stray quote,
# which is tomllib's reading too.
fn _tv_string(c, buf, pos, end, allow_ml, out): i64 {
    var q = load8(buf + pos);
    var ml = 0;
    if (allow_ml == 1 && pos + 2 < end) {
        if (load8(buf + pos + 1) == q && load8(buf + pos + 2) == q) { ml = 1; }
    }
    var from = pos + 1;
    if (ml == 1) {
        from = pos + 3;
        from = from + _tv_nl(buf, from, end);    # a newline right after the opening is trimmed
    }
    var close = _tv_scan(c, buf, from, end, q, ml);
    if (close < 0) { return close; }
    var to = close;
    var next = close + 1;
    if (ml == 1) {
        # Up to two more quotes after the closing three belong to the body: `"""a""""` is `a"`.
        next = close + 3;
        if (next < end && load8(buf + next) == q) {
            to = to + 1;
            next = next + 1;
            if (next < end && load8(buf + next) == q) {
                to = to + 1;
                next = next + 1;
            }
        }
    }
    var a = load64(c + _TC_A);
    var cap = to - from;
    if (cap < 1) { cap = 1; }
    var dst = alloc_via(a, cap);
    if (dst == 0) { return _tv_oom(c, pos); }
    var n = _tv_decode(buf, from, to, dst, q);
    var s = str_new_a(a, dst, n);
    if (s == 0) { return _tv_oom(c, pos); }
    store64(out, s);
    return next;
}

# === Keys ========================================================================================

# Parse a dotted key at pos into the context's parts vec (emptied first); return the position after
# it and after any spaces or tabs that follow, or -1. A part is bare (A-Z a-z 0-9 - _) or a
# single-line string. A key of more parts than the depth cap allows is refused here, before its
# parts are built: every part but the last is a table.
fn _tv_key(c, buf, pos, end): i64 {
    var parts = load64(c + _TC_PARTS);
    var a = load64(c + _TC_A);
    vec_truncate(parts, 0);
    loop {
        if (pos >= end) { return _tv_err(c, "expected a key", pos); }
        if (vec_len(parts) >= _JP_MAX_DEPTH) { return _tv_err(c, "nesting too deep", pos); }
        var ch = load8(buf + pos);
        var seg[8];
        if (ch == 34 || ch == 39) {
            pos = _tv_string(c, buf, pos, end, 0, &seg);
            if (pos < 0) { return pos; }
        }
        elif (_tv_bare(ch)) {
            var s = pos;
            while (pos < end && _tv_bare(load8(buf + pos))) { pos = pos + 1; }
            var kb = alloc_via(a, pos - s);
            if (kb == 0) { return _tv_oom(c, s); }
            memcpy(kb, buf + s, pos - s);
            var ks = str_new_a(a, kb, pos - s);
            if (ks == 0) { return _tv_oom(c, s); }
            store64(&seg, ks);
        }
        else { return _tv_err(c, "invalid key", pos); }
        if (vec_push_a(a, parts, load64(&seg)) < 0) { return _tv_oom(c, pos); }
        pos = _tv_ws(buf, pos, end);
        if (pos < end && load8(buf + pos) == 46) { pos = _tv_ws(buf, pos + 1, end); }
        else { return pos; }
    }
    return pos;
}

# === Dates and times =============================================================================

# Two decimal digits at p, or -1.
fn _tv_dig2(buf, p): i64 {
    var d0 = load8(buf + p);
    var d1 = load8(buf + p + 1);
    if (!_tv_isdig(d0) || !_tv_isdig(d1)) { return 0 - 1; }
    return (d0 - 48) * 10 + d1 - 48;
}

# The end of HH:MM:SS(.fraction) at p, or 0. Hours 00-23, minutes and seconds 00-59 (tomllib's
# pattern: no leap second). A fraction is a `.` and at least one digit; it may be any length.
fn _tv_time_end(buf, p, end): i64 {
    if (p + 8 > end) { return 0; }
    var hh = _tv_dig2(buf, p);
    var mm = _tv_dig2(buf, p + 3);
    var ss = _tv_dig2(buf, p + 6);
    if (hh < 0 || hh > 23 || mm < 0 || mm > 59 || ss < 0 || ss > 59) { return 0; }
    if (load8(buf + p + 2) != 58 || load8(buf + p + 5) != 58) { return 0; }
    p = p + 8;
    if (p + 1 < end && load8(buf + p) == 46 && _tv_isdig(load8(buf + p + 1))) {
        p = p + 1;
        while (p < end && _tv_isdig(load8(buf + p))) { p = p + 1; }
    }
    return p;
}

# The length of a time offset at p (Z, z, or +HH:MM / -HH:MM), or 0.
fn _tv_offset_len(buf, p, end): i64 {
    if (p >= end) { return 0; }
    var ch = load8(buf + p);
    if (ch == 90 || ch == 122) { return 1; }
    if (ch != 43 && ch != 45) { return 0; }
    if (p + 6 > end) { return 0; }
    var hh = _tv_dig2(buf, p + 1);
    var mm = _tv_dig2(buf, p + 4);
    if (hh < 0 || hh > 23 || mm < 0 || mm > 59 || load8(buf + p + 3) != 58) { return 0; }
    return 6;
}

# Days in month mo of year y, proleptic Gregorian (Python's datetime).
fn _tv_mdays(y, mo): i64 {
    if (mo == 2) {
        if (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) { return 29; }
        return 28;
    }
    if (mo == 4 || mo == 6 || mo == 9 || mo == 11) { return 30; }
    return 31;
}

# The date, date-time or time at pos into *out, a JTAG_STR holding its text with its TOML_DT_*
# kind in the reserved word. Return the position after it, 0 when no date or time starts here, or
# -1. tomllib's patterns decide the form; then the date must exist: year 1 or later (Python's
# datetime has no year 0), and a day the month has.
fn _tv_datetime(c, buf, pos, end, out): i64 {
    var p = pos;
    var kind = 0;
    var y = 0 - 1;
    if (pos + 10 <= end) {
        var y0 = _tv_dig2(buf, pos);
        var y1 = _tv_dig2(buf, pos + 2);
        var mo = _tv_dig2(buf, pos + 5);
        var dd = _tv_dig2(buf, pos + 8);
        if (y0 >= 0 && y1 >= 0 && mo >= 1 && mo <= 12 && dd >= 1 && dd <= 31) {
            if (load8(buf + pos + 4) == 45 && load8(buf + pos + 7) == 45) {
                y = y0 * 100 + y1;
                if (y == 0 || dd > _tv_mdays(y, mo)) { return _tv_err(c, "invalid date", pos); }
                p = pos + 10;
                kind = TOML_DT_DATE;
                if (p < end) {
                    var sep = load8(buf + p);
                    if (sep == 84 || sep == 116 || sep == 32) {
                        var te = _tv_time_end(buf, p + 1, end);
                        if (te > 0) {
                            p = te;
                            kind = TOML_DT_LOCAL;
                            var off = _tv_offset_len(buf, p, end);
                            if (off > 0) {
                                p = p + off;
                                kind = TOML_DT_OFFSET;
                            }
                        }
                    }
                }
            }
        }
    }
    if (kind == 0) {
        var t = _tv_time_end(buf, pos, end);
        if (t == 0) { return 0; }
        p = t;
        kind = TOML_DT_TIME;
    }
    var a = load64(c + _TC_A);
    var db = alloc_via(a, p - pos);
    if (db == 0) { return _tv_oom(c, pos); }
    memcpy(db, buf + pos, p - pos);
    var s = str_new_a(a, db, p - pos);
    if (s == 0) { return _tv_oom(c, pos); }
    var v = bayan_json_v_str_new_a(a, s);
    if (v == 0) { return _tv_oom(c, pos); }
    store64(v + 16, kind);
    store64(out, v);
    return p;
}

# === Numbers =====================================================================================

# The end of a digit run that may have single underscores between digits: [0-9](_?[0-9])*, the run
# starting with the digit at p.
fn _tv_digits(buf, p, end): i64 {
    p = p + 1;
    loop {
        if (p < end && _tv_isdig(load8(buf + p))) { p = p + 1; }
        elif (p + 1 < end && load8(buf + p) == 95 && _tv_isdig(load8(buf + p + 1))) { p = p + 2; }
        else { break; }
    }
    return p;
}

# The integer, float, inf or nan at pos into *out; the position after it, or -1. The forms are
# tomllib's: a 0x / 0o / 0b integer takes no sign and may have leading zeros after its prefix; a
# decimal integer part is 0 or starts with 1-9; a fraction is `.` and a digit; an exponent is e or
# E, a sign, a digit. Like tomllib this reads the longest such prefix, so `01` reads 0 and leaves
# `1`, which the caller then refuses.
fn _tv_number(c, buf, pos, end, out): i64 {
    var a = load64(c + _TC_A);
    var ch = load8(buf + pos);
    var v = 0;
    if (ch == 48 && pos + 2 < end) {
        var pc = load8(buf + pos + 1);
        var base = 0;
        if (pc == 120) { base = 16; }
        elif (pc == 111) { base = 8; }
        elif (pc == 98) { base = 2; }
        if (base != 0 && _tv_digit(load8(buf + pos + 2), base) >= 0) {
            var p = pos + 2;
            var val = 0;
            loop {
                var dv = _tv_digit(load8(buf + p), base);
                if (val > (0x7FFFFFFFFFFFFFFF - dv) / base) { return _tv_err(c, "integer out of range", pos); }
                val = val * base + dv;
                p = p + 1;
                if (p < end && _tv_digit(load8(buf + p), base) >= 0) { continue; }
                if (p + 1 < end && load8(buf + p) == 95 && _tv_digit(load8(buf + p + 1), base) >= 0) {
                    p = p + 1;
                    continue;
                }
                break;
            }
            v = bayan_json_v_int_new_a(a, val);
            if (v == 0) { return _tv_oom(c, pos); }
            store64(out, v);
            return p;
        }
    }
    var p2 = pos;
    var neg = 0;
    if (ch == 43 || ch == 45) {
        if (ch == 45) { neg = 1; }
        p2 = p2 + 1;
    }
    if (p2 < end && _tv_isdig(load8(buf + p2))) {
        if (load8(buf + p2) == 48) { p2 = p2 + 1; }
        else { p2 = _tv_digits(buf, p2, end); }
        var isf = 0;
        if (p2 + 1 < end && load8(buf + p2) == 46 && _tv_isdig(load8(buf + p2 + 1))) {
            p2 = _tv_digits(buf, p2 + 1, end);
            isf = 1;
        }
        if (p2 < end && (load8(buf + p2) == 101 || load8(buf + p2) == 69)) {
            var q = p2 + 1;
            if (q < end && (load8(buf + q) == 43 || load8(buf + q) == 45)) { q = q + 1; }
            if (q < end && _tv_isdig(load8(buf + q))) {
                p2 = _tv_digits(buf, q, end);
                isf = 1;
            }
        }
        if (isf == 0) {
            # Accumulate toward the sign, so -9223372036854775808 fits.
            var iv = 0;
            var k = pos;
            while (k < p2) {
                var d = load8(buf + k);
                if (_tv_isdig(d)) {
                    d = d - 48;
                    if (neg == 1) {
                        if (iv < (0x8000000000000000 + d) / 10) { return _tv_err(c, "integer out of range", pos); }
                        iv = iv * 10 - d;
                    } else {
                        if (iv > (0x7FFFFFFFFFFFFFFF - d) / 10) { return _tv_err(c, "integer out of range", pos); }
                        iv = iv * 10 + d;
                    }
                }
                k = k + 1;
            }
            v = bayan_json_v_int_new_a(a, iv);
        } else {
            # The float's digits without their underscores, through the stdlib's correctly
            # rounded parser. A value past the f64 range is +/-inf, as Python's float() reads it.
            var n = p2 - pos;
            var fb = alloc_via(a, n);
            if (fb == 0) { return _tv_oom(c, pos); }
            var fl = 0;
            var j = pos;
            while (j < p2) {
                var fc = load8(buf + j);
                if (fc != 95) {
                    store8(fb + fl, fc);
                    fl = fl + 1;
                }
                j = j + 1;
            }
            v = bayan_json_v_float_new_a(a, f64_parse_n(fb, fl));
        }
        if (v == 0) { return _tv_oom(c, pos); }
        store64(out, v);
        return p2;
    }
    # inf and nan, either optionally signed.
    var sp = pos;
    if (ch == 43 || ch == 45) { sp = pos + 1; }
    var bits = 0;
    if (_tv_word(buf, sp, end, "inf")) {
        bits = 0x7FF0000000000000;
        if (neg == 1) { bits = 0xFFF0000000000000; }
    }
    elif (_tv_word(buf, sp, end, "nan")) {
        bits = 0x7FF8000000000000;
        if (neg == 1) { bits = 0xFFF8000000000000; }
    }
    else { return _tv_err(c, "invalid value", pos); }
    v = bayan_json_v_float_new_a(a, bits);
    if (v == 0) { return _tv_oom(c, pos); }
    store64(out, v);
    return sp + 3;
}

# === Values ======================================================================================

# Parse the value at pos into *out; `level` is the level a table or array here takes. Return the
# position after the value, or -1. The order of the tests is tomllib's: strings, booleans, arrays,
# inline tables, dates and times, then numbers, so `1979-05-27` is a date, never 1979 and a stray
# `-05-27`.
fn _tv_value(c, buf, pos, end, level, out): i64 {
    if (pos >= end) { return _tv_err(c, "expected a value", pos); }
    var a = load64(c + _TC_A);
    var ch = load8(buf + pos);
    if (ch == 34 || ch == 39) {
        var sv[8];
        var np = _tv_string(c, buf, pos, end, 1, &sv);
        if (np < 0) { return np; }
        var v = bayan_json_v_str_new_a(a, load64(&sv));
        if (v == 0) { return _tv_oom(c, pos); }
        store64(out, v);
        return np;
    }
    if (ch == 116 && _tv_word(buf, pos, end, "true")) {
        var vt = bayan_json_v_bool_new_a(a, 1);
        if (vt == 0) { return _tv_oom(c, pos); }
        store64(out, vt);
        return pos + 4;
    }
    if (ch == 102 && _tv_word(buf, pos, end, "false")) {
        var vf = bayan_json_v_bool_new_a(a, 0);
        if (vf == 0) { return _tv_oom(c, pos); }
        store64(out, vf);
        return pos + 5;
    }
    if (ch == 91) { return _tv_array(c, buf, pos, end, level, out); }
    if (ch == 123) { return _tv_inline(c, buf, pos, end, level, out); }
    var dt = _tv_datetime(c, buf, pos, end, out);
    if (dt != 0) { return dt; }
    return _tv_number(c, buf, pos, end, out);
}

# A static array at pos (its `[`) into *out, FROZEN once complete. Values are separated by commas;
# newlines and comments may sit anywhere between them, and one trailing comma is allowed.
fn _tv_array(c, buf, pos, end, level, out): i64 {
    if (level > _JP_MAX_DEPTH) { return _tv_err(c, "nesting too deep", pos); }
    var a = load64(c + _TC_A);
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0) { return _tv_oom(c, pos); }
    var p = _tv_skip_array_ws(c, buf, pos + 1, end);
    if (p < 0) { return p; }
    if (p < end && load8(buf + p) == 93) {
        store64(arr + 16, _TF_FROZEN);
        store64(out, arr);
        return p + 1;
    }
    loop {
        var ev[8];
        p = _tv_value(c, buf, p, end, level + 1, &ev);
        if (p < 0) { return p; }
        if (bayan_json_v_arr_push_a(a, arr, load64(&ev)) < 0) { return _tv_oom(c, p); }
        p = _tv_skip_array_ws(c, buf, p, end);
        if (p < 0) { return p; }
        if (p >= end) { return _tv_err(c, "unclosed array", p); }
        var ch = load8(buf + p);
        if (ch == 93) {
            p = p + 1;
            break;
        }
        if (ch != 44) { return _tv_err(c, "unclosed array", p); }
        p = _tv_skip_array_ws(c, buf, p + 1, end);
        if (p < 0) { return p; }
        if (p < end && load8(buf + p) == 93) {
            p = p + 1;
            break;
        }
    }
    store64(arr + 16, _TF_FROZEN);
    store64(out, arr);
    return p;
}

# An inline table at pos (its `{`) into *out, FROZEN once complete. It is one line: pairs separated
# by commas, no trailing comma, no newline. A dotted key inside it opens tables of its own, which a
# later key of the same inline table may extend; a nested inline table or array may not be.
fn _tv_inline(c, buf, pos, end, level, out): i64 {
    if (level > _JP_MAX_DEPTH) { return _tv_err(c, "nesting too deep", pos); }
    var a = load64(c + _TC_A);
    var tbl = bayan_json_v_obj_new_a(a);
    if (tbl == 0) { return _tv_oom(c, pos); }
    var p = _tv_ws(buf, pos + 1, end);
    if (p < end && load8(buf + p) == 125) {
        store64(tbl + 16, _TF_FROZEN);
        store64(out, tbl);
        return p + 1;
    }
    loop {
        var kpos = p;
        p = _tv_key(c, buf, p, end);
        if (p < 0) { return p; }
        if (p >= end || load8(buf + p) != 61) { return _tv_err(c, "expected '=' after a key", p); }
        # Walk the key's tables now: the value may hold inline tables, whose keys reuse the parts vec.
        var parts = load64(c + _TC_PARTS);
        var np = vec_len(parts);
        var cur = tbl;
        var lvl = level;
        var i = 0;
        while (i < np - 1) {
            var part = vec_get(parts, i);
            var child = _tv_find_str(c, cur, part);
            if (child == 0) {
                child = _tv_new_table(c, cur, part, lvl + 1, kpos);
                if (child < 0) { return child; }
            }
            elif (load64(child) != JTAG_OBJ) { return _tv_err(c, "key exists and is not a table", kpos); }
            elif ((load64(child + 16) & _TF_FROZEN) != 0) { return _tv_err(c, "cannot extend an inline table", kpos); }
            cur = child;
            lvl = lvl + 1;
            i = i + 1;
        }
        var stem = vec_get(parts, np - 1);
        if (_tv_find_str(c, cur, stem) != 0) { return _tv_err(c, "duplicate key", kpos); }
        var vv[8];
        p = _tv_value(c, buf, _tv_ws(buf, p + 1, end), end, lvl + 1, &vv);
        if (p < 0) { return p; }
        if (_tv_set(c, cur, stem, load64(&vv)) < 0) { return _tv_oom(c, p); }
        p = _tv_ws(buf, p, end);
        if (p >= end) { return _tv_err(c, "unclosed inline table", p); }
        var ch = load8(buf + p);
        if (ch == 125) {
            p = p + 1;
            break;
        }
        if (ch != 44) { return _tv_err(c, "unclosed inline table", p); }
        p = _tv_ws(buf, p + 1, end);
    }
    store64(tbl + 16, _TF_FROZEN);
    store64(out, tbl);
    return p;
}

# === Statements ==================================================================================

# Mark every table a dotted key opened in the section just ended EXPLICIT: from the next header on,
# no header names them and no dotted key extends them.
fn _tv_finalize(c): i64 {
    var pend = load64(c + _TC_PEND);
    var n = vec_len(pend);
    var i = 0;
    while (i < n) {
        var t = vec_get(pend, i);
        store64(t + 16, (load64(t + 16) & (0 - 1 - _TF_PENDING)) | _TF_EXPLICIT);
        i = i + 1;
    }
    vec_truncate(pend, 0);
    return 0;
}

# A key/value pair at pos, into the current section's table. Return the position after the value,
# or -1. A dotted key walks (or opens) a table per part but the last; a table it walks may not be
# FROZEN or EXPLICIT, and each it walks becomes PENDING. The last part must be new.
fn _tv_keyval(c, buf, pos, end): i64 {
    var p = _tv_key(c, buf, pos, end);
    if (p < 0) { return p; }
    if (p >= end || load8(buf + p) != 61) { return _tv_err(c, "expected '=' after a key", p); }
    var a = load64(c + _TC_A);
    var parts = load64(c + _TC_PARTS);
    var np = vec_len(parts);
    var cur = load64(c + _TC_HEAD);
    var lvl = load64(c + _TC_HLEVEL);
    var i = 0;
    while (i < np - 1) {
        var part = vec_get(parts, i);
        var child = _tv_find_str(c, cur, part);
        if (child == 0) {
            child = _tv_new_table(c, cur, part, lvl + 1, pos);
            if (child < 0) { return child; }
        }
        elif (load64(child) != JTAG_OBJ) {
            if (load64(child) == JTAG_ARR) { return _tv_err(c, "cannot extend an array with a dotted key", pos); }
            return _tv_err(c, "key exists and is not a table", pos);
        }
        else {
            var f = load64(child + 16);
            if ((f & _TF_FROZEN) != 0) { return _tv_err(c, "cannot extend an inline table", pos); }
            if ((f & _TF_EXPLICIT) != 0) {
                return _tv_err(c, "cannot extend a table defined earlier with a dotted key", pos);
            }
        }
        if ((load64(child + 16) & _TF_PENDING) == 0) {
            store64(child + 16, load64(child + 16) | _TF_PENDING);
            if (vec_push_a(a, load64(c + _TC_PEND), child) < 0) { return _tv_oom(c, pos); }
        }
        cur = child;
        lvl = lvl + 1;
        i = i + 1;
    }
    var stem = vec_get(parts, np - 1);
    if (_tv_find_str(c, cur, stem) != 0) { return _tv_err(c, "duplicate key", pos); }
    var vv[8];
    p = _tv_value(c, buf, _tv_ws(buf, p + 1, end), end, lvl + 1, &vv);
    if (p < 0) { return p; }
    if (_tv_set(c, cur, stem, load64(&vv)) < 0) { return _tv_oom(c, p); }
    return p;
}

# Walk parts[0, n) of the current key from the root for a header: open what is missing, pass
# through tables, and through an array of tables to its last element. Return the table reached, or
# -1; its level goes to *lvl_out. The table reached is NOT checked here; the caller decides.
fn _tv_walk_header(c, n, pos, lvl_out): i64 {
    var parts = load64(c + _TC_PARTS);
    var cur = load64(c + _TC_ROOT);
    var lvl = 1;
    var i = 0;
    while (i < n) {
        var part = vec_get(parts, i);
        var child = _tv_find_str(c, cur, part);
        if (child == 0) {
            child = _tv_new_table(c, cur, part, lvl + 1, pos);
            if (child < 0) { return child; }
            lvl = lvl + 1;
        }
        elif (load64(child) == JTAG_OBJ) {
            if ((load64(child + 16) & _TF_FROZEN) != 0) { return _tv_err(c, "cannot extend an inline table", pos); }
            lvl = lvl + 1;
        }
        elif (load64(child) == JTAG_ARR) {
            if ((load64(child + 16) & _TF_FROZEN) != 0) { return _tv_err(c, "cannot extend an array", pos); }
            child = bayan_json_v_arr_get(child, bayan_json_v_arr_len(child) - 1);
            lvl = lvl + 2;
        }
        else { return _tv_err(c, "key exists and is not a table", pos); }
        cur = child;
        i = i + 1;
    }
    store64(lvl_out, lvl);
    return cur;
}

# `[key]` at pos: the table becomes the current section, EXPLICIT. It may not have been named by
# a header, opened by a dotted key in an earlier section, or be an array.
fn _tv_table_header(c, buf, pos, end): i64 {
    _tv_finalize(c);
    var p = _tv_key(c, buf, _tv_ws(buf, pos + 1, end), end);
    if (p < 0) { return p; }
    if (p >= end || load8(buf + p) != 93) { return _tv_err(c, "expected ']' at the end of a table header", p); }
    var np = vec_len(load64(c + _TC_PARTS));
    var lv[8];
    var parent = _tv_walk_header(c, np - 1, pos, &lv);
    if (parent < 0) { return parent; }
    var lvl = load64(&lv);
    var stem = vec_get(load64(c + _TC_PARTS), np - 1);
    var t = _tv_find_str(c, parent, stem);
    if (t == 0) {
        t = _tv_new_table(c, parent, stem, lvl + 1, pos);
        if (t < 0) { return t; }
    }
    elif (load64(t) == JTAG_OBJ) {
        var f = load64(t + 16);
        if ((f & _TF_FROZEN) != 0) { return _tv_err(c, "cannot extend an inline table", pos); }
        if ((f & _TF_EXPLICIT) != 0) { return _tv_err(c, "table defined twice", pos); }
    }
    elif (load64(t) == JTAG_ARR) { return _tv_err(c, "table defined twice: it is an array", pos); }
    else { return _tv_err(c, "key exists and is not a table", pos); }
    store64(t + 16, load64(t + 16) | _TF_EXPLICIT);
    store64(c + _TC_HEAD, t);
    store64(c + _TC_HLEVEL, lvl + 1);
    return p + 1;
}

# `[[key]]` at pos: a new table appended to the array named key, opened if missing, becomes the
# current section. The name may not hold a table, an inline table, a static array or a value.
fn _tv_aot_header(c, buf, pos, end): i64 {
    _tv_finalize(c);
    var p = _tv_key(c, buf, _tv_ws(buf, pos + 2, end), end);
    if (p < 0) { return p; }
    if (p + 1 >= end || load8(buf + p) != 93 || load8(buf + p + 1) != 93) {
        return _tv_err(c, "expected ']]' at the end of an array-of-tables header", p);
    }
    var a = load64(c + _TC_A);
    var np = vec_len(load64(c + _TC_PARTS));
    var lv[8];
    var parent = _tv_walk_header(c, np - 1, pos, &lv);
    if (parent < 0) { return parent; }
    var lvl = load64(&lv);
    var stem = vec_get(load64(c + _TC_PARTS), np - 1);
    var arr = _tv_find_str(c, parent, stem);
    if (arr == 0) {
        if (lvl + 1 > _JP_MAX_DEPTH) { return _tv_err(c, "nesting too deep", pos); }
        arr = bayan_json_v_arr_new_a(a);
        if (arr == 0) { return _tv_oom(c, pos); }
        if (_tv_set(c, parent, stem, arr) < 0) { return _tv_oom(c, pos); }
    }
    elif (load64(arr) == JTAG_ARR) {
        if ((load64(arr + 16) & _TF_FROZEN) != 0) { return _tv_err(c, "cannot extend an array", pos); }
    }
    elif (load64(arr) == JTAG_OBJ) { return _tv_err(c, "key exists and is not an array of tables", pos); }
    else { return _tv_err(c, "key exists and is not an array of tables", pos); }
    if (lvl + 2 > _JP_MAX_DEPTH) { return _tv_err(c, "nesting too deep", pos); }
    var t = bayan_json_v_obj_new_a(a);
    if (t == 0) { return _tv_oom(c, pos); }
    if (bayan_json_v_arr_push_a(a, arr, t) < 0) { return _tv_oom(c, pos); }
    store64(c + _TC_HEAD, t);
    store64(c + _TC_HLEVEL, lvl + 2);
    return p + 2;
}

# The document: statements, one per line. A statement is a key/value pair, a `[table]` or a
# `[[array of tables]]` header, or nothing; any may end in a comment, and a newline (LF or CR LF)
# or the end of the input must follow it. Return 0, or -1.
fn _tv_doc(c, buf, end): i64 {
    var pos = 0;
    loop {
        pos = _tv_ws(buf, pos, end);
        if (pos >= end) { break; }
        var nl = _tv_nl(buf, pos, end);
        if (nl > 0) {
            pos = pos + nl;
            continue;
        }
        var ch = load8(buf + pos);
        if (_tv_bare(ch) || ch == 34 || ch == 39) {
            pos = _tv_keyval(c, buf, pos, end);
            if (pos < 0) { return pos; }
            pos = _tv_ws(buf, pos, end);
        }
        elif (ch == 91) {
            if (pos + 1 < end && load8(buf + pos + 1) == 91) { pos = _tv_aot_header(c, buf, pos, end); }
            else { pos = _tv_table_header(c, buf, pos, end); }
            if (pos < 0) { return pos; }
            pos = _tv_ws(buf, pos, end);
        }
        elif (ch != 35) { return _tv_err(c, "invalid statement", pos); }
        if (pos < end && load8(buf + pos) == 35) {
            pos = _tv_comment(c, buf, pos, end);
            if (pos < 0) { return pos; }
        }
        if (pos >= end) { break; }
        nl = _tv_nl(buf, pos, end);
        if (nl == 0) { return _tv_err(c, "expected a newline after the statement", pos); }
        pos = pos + nl;
    }
    return 0;
}

# Clear the flags the parse kept in every table's and array's reserved word, which is 0 again when
# the tree is handed back. A string's reserved word keeps its TOML_DT_* kind. The recursion is
# bounded by the depth cap.
fn _tv_clear(v): i64 {
    var t = load64(v);
    if (t == JTAG_OBJ) {
        store64(v + 16, 0);
        var n = bayan_json_v_obj_len(v);
        var i = 0;
        while (i < n) {
            _tv_clear(bayan_json_v_obj_val(v, i));
            i = i + 1;
        }
    }
    elif (t == JTAG_ARR) {
        store64(v + 16, 0);
        var m = bayan_json_v_arr_len(v);
        var j = 0;
        while (j < m) {
            _tv_clear(bayan_json_v_arr_get(v, j));
            j = j + 1;
        }
    }
    return 0;
}

# === Public parse entries ========================================================================

# Reentrant parse of buf[0, len) into a caller-owned state (bayan_json_parse_state_size() bytes),
# every allocation through `a`. Returns the root table, or 0 with the error in
# bayan_toml_v_state_error(ps) / _pos(ps). Touches no globals.
fn bayan_toml_v_parse_ctx_a(a, ps, buf, len): i64 {
    _jp_state_init(ps, buf, len);
    if (buf == 0 && len != 0) {
        _jp_set_err(ps, "null source", 0);
        return 0;
    }
    var ctx[_TC_SIZE];
    var c = &ctx;
    store64(c + _TC_A, a);
    store64(c + _TC_PS, ps);
    var slots = _tv_slots_new(a, 64);
    var pend = vec_new_a(a);
    var parts = vec_new_a(a);
    var root = bayan_json_v_obj_new_a(a);
    if (slots == 0 || pend == 0 || parts == 0 || root == 0) {
        _jp_set_err(ps, "out of memory", 0);
        return 0;
    }
    store64(c + _TC_SLOTS, slots);
    store64(c + _TC_CAP, 64);
    store64(c + _TC_COUNT, 0);
    store64(c + _TC_PEND, pend);
    store64(c + _TC_PARTS, parts);
    store64(c + _TC_HEAD, root);
    store64(c + _TC_HLEVEL, 1);
    store64(c + _TC_ROOT, root);
    if (_tv_doc(c, buf, len) < 0) { return 0; }
    _tv_clear(root);
    return root;
}

# Reentrant parse through default_alloc().
fn bayan_toml_v_parse_ctx(ps, buf, len): i64 {
    return bayan_toml_v_parse_ctx_a(default_alloc(), ps, buf, len);
}

# Parse buf[0, len) through `a`. Globals-compat: the parse state is a stack local, and its error
# is mirrored into bayan_toml_v_last_error() / _pos() after the parse.
#
# NAMED `_buf`, NOT `_str` (bayan_json_v_parse_buf's note): cyrius routes `X(<Str>, ..)` to `X_str`.
fn bayan_toml_v_parse_buf_a(a, buf, len): i64 {
    var ps[_JP_STATE_SIZE];
    var v = bayan_toml_v_parse_ctx_a(a, &ps, buf, len);
    _toml_v_err_msg = load64(&ps + 24);
    _toml_v_err_pos = load64(&ps + 32);
    return v;
}

# Parse buf[0, len) through default_alloc().
fn bayan_toml_v_parse_buf(buf, len): i64 {
    return bayan_toml_v_parse_buf_a(default_alloc(), buf, len);
}

# Parse the Str src through `a`. Returns the root table (a JTAG_OBJ), or 0.
fn bayan_toml_v_parse_a(a, src: Str): i64 {
    if (src == 0) {
        _toml_v_err_msg = "null source";
        _toml_v_err_pos = 0;
        return 0;
    }
    return bayan_toml_v_parse_buf_a(a, str_data(src), str_len(src));
}

# Parse the Str src. Returns the root table (a JTAG_OBJ), or 0 with the reason in
# bayan_toml_v_last_error() and its byte offset in bayan_toml_v_last_error_pos().
fn bayan_toml_v_parse(src: Str): i64 {
    return bayan_toml_v_parse_a(default_alloc(), src);
}
