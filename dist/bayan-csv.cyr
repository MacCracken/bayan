# bayan.cyr -- bundled distribution
# Version: 1.11.0
# Profile: csv
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/bayan-csv.deps):
include "lib/vec.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"

# --- csv.cyr ---

# csv.cyr — RFC 4180 records, one line at a time
#
# As of 1.7.0 this reads and writes what Python's `csv` module does with its
# defaults (QUOTE_MINIMAL, a `"` quote, CRLF records), and tests/vectors.tcyr
# checks it against vectors that module wrote (scripts/gen-csv-vectors.py).
# Until 1.7.0 it was an RFC 4180 subset that a caller could hit in four ways,
# documented from 1.5.3:
#   * a TRAILING EMPTY FIELD was not emitted: `a,` parsed to one field where
#     the RFC has two, so a round trip lost a column;
#   * records ended in a lone LF where RFC 4180 s2.1 says CRLF, and the parser
#     kept a line's own terminator as data in its last field;
#   * a field holding CR was not quoted, so it came back as a line break;
#   * the text after a closing quote began a NEW field: `"a"b,c` parsed to
#     a, b, c (Python: ab, c), shifting every later column.
#
# ONE RECORD PER CALL. bayan_csv_parse_line reads one line. A CR or LF outside
# quotes ends the record only as the line's terminator: its last byte, or CRLF
# as its last two. Anywhere else it is kept as data, where Python's reader would
# start a second record; a caller splitting a file into lines never passes one.
# Inside quotes CR and LF are data, as the RFC says, so a whole quoted record
# that spans lines parses whole when it is passed whole.
# Usage: include "lib/bayan.cyr" (full bundle) or "lib/bayan-csv.cyr" (sublib).
#        `lib/csv.cyr` was the pre-carve stdlib module and no longer ships —
#        this content moved into bayan at 1.0.0 / cyrius 6.1.25.
# Requires: alloc.cyr, string.cyr, vec.cyr, str.cyr
#
# A REFUSED ALLOCATION IS 0 (1.7.1). Each public function returns 0 when an
# allocation is refused, and every allocation goes through default_alloc()
# (the global bump allocator, as before), so tests/bayan.tcyr can refuse each
# allocation point alone. Until 1.7.1 a refusal gave a different wrong answer
# in each place: bayan_csv_parse_line returned the fields it had so far (a
# short row), bayan_csv_escape stored through address 0, bayan_csv_write_line
# passed a refused escape's 0 to strlen, and a refused growth of either
# function's vec ended the process (the default vec_push does).

# Parse a CSV line into a vec of field strings (C strings).
# Handles quoted fields, escaped quotes (""), and commas within quotes.
#
# SIZING (fixed in 1.5.1 — this was a heap buffer overflow). Each field used to
# get a fixed `alloc(1024)` and was then filled one byte per input byte with no
# bound, so any field longer than 1023 bytes wrote past its allocation with
# attacker-controlled data. Verified before the fix: a 4,000-byte field wrote
# 4,000 bytes into the 1,024-byte block.
#
# A field can never be longer than the line that contains it, so one scratch
# buffer of `len + 1` is always sufficient for every field. It is allocated
# once and reused, and each field is then copied out at its exact length —
# which is also why this is not a per-field `alloc(len + 1)`: that would be
# quadratic in memory for a line of many short fields, trading an overflow for
# a memory-exhaustion DoS.
fn bayan_csv_parse_line(line): i64 {
    var fields = vec_new();
    if (fields == 0) { return 0; }
    var len = strlen(line);
    var scratch = alloc_via(default_alloc(), len + 1);
    if (scratch == 0) { return 0; }
    # The RFC 4180 grammar as Python's reader runs it (1.7.0). state:
    #   0 at the start of a field   1 in an unquoted field
    #   2 inside quotes             3 just after a quote inside quotes
    # In state 3 a second quote is an escaped one, and anything else but a
    # comma or the terminator continues the field unquoted: `"a"b` is ab.
    var pos = 0;
    var fi = 0;
    var state = 0;
    while (pos < len) {
        var c = load8(line + pos);
        if (state == 2) {
            if (c == 34) { state = 3; }
            else { store8(scratch + fi, c); fi = fi + 1; }
        } elif (c == 44) {
            if (_csv_push_field(fields, scratch, fi) < 0) { return 0; }
            fi = 0;
            state = 0;
        } elif ((c == 13 || c == 10) && _csv_is_terminator(line, len, pos) == 1) {
            pos = len;                           # the record's own line ending
        } elif (c == 34 && state == 0) {
            state = 2;
        } elif (c == 34 && state == 3) {
            store8(scratch + fi, 34); fi = fi + 1;
            state = 2;
        } else {
            store8(scratch + fi, c); fi = fi + 1;
            state = 1;
        }
        pos = pos + 1;
    }
    # The last field. A record that ends in a comma ends in an empty field
    # (`a,` is a and ""), and a line with no field at all is a record of none.
    if (state != 0 || vec_len(fields) > 0) {
        if (_csv_push_field(fields, scratch, fi) < 0) { return 0; }
    }
    return fields;
}

# 1 when the CR or LF at line[pos] is the line's terminator: the last byte, or
# a CR followed by the last byte, LF.
fn _csv_is_terminator(line, len, pos): i64 {
    if (pos + 1 == len) { return 1; }
    if (pos + 2 == len && load8(line + pos) == 13 && load8(line + pos + 1) == 10) { return 1; }
    return 0;
}

# Copy scratch[0..n) out at its exact length and push it. -1 when the copy or
# the vec's growth is refused. `scratch` is shared by every field, so it cannot
# be pushed directly: the next field would overwrite it.
fn _csv_push_field(fields, scratch, n): i64 {
    var out = alloc_via(default_alloc(), n + 1);
    if (out == 0) { return 0 - 1; }
    memcpy(out, scratch, n);
    store8(out + n, 0);
    if (vec_push_a(default_alloc(), fields, out) < 0) { return 0 - 1; }
    return 0;
}

# Escape a field for CSV output: quoted, with each `"` doubled, when it holds a
# comma, a quote, a CR or an LF (QUOTE_MINIMAL). A CR did not trigger quoting
# until 1.7.0, so a field holding one came back from a reader as a line break.
fn bayan_csv_escape(field): i64 {
    var len = strlen(field);
    var needs_quote = 0;
    var i = 0;
    while (i < len) {
        var c = load8(field + i);
        if (c == 44) { needs_quote = 1; }
        if (c == 34) { needs_quote = 1; }
        if (c == 10) { needs_quote = 1; }
        if (c == 13) { needs_quote = 1; }
        i = i + 1;
    }
    if (needs_quote == 0) { return field; }
    # Quote and escape internal quotes
    var out = alloc_via(default_alloc(), len * 2 + 3);
    if (out == 0) { return 0; }
    var oi = 0;
    store8(out + oi, 34); oi = oi + 1;
    i = 0;
    while (i < len) {
        var c = load8(field + i);
        if (c == 34) { store8(out + oi, 34); oi = oi + 1; }
        store8(out + oi, c); oi = oi + 1;
        i = i + 1;
    }
    store8(out + oi, 34); oi = oi + 1;
    store8(out + oi, 0);
    return out;
}

# Write a vec of fields as one CSV record, ending in CRLF (returns a
# NUL-terminated string). Until 1.7.0 records ended in a lone LF, where RFC
# 4180 s2.1 says CRLF. A row of one empty field is written `""`, as Python's
# writer does: written bare it would be an empty line, which reads back as a
# record of no fields.
fn bayan_csv_write_line(fields): i64 {
    # SIZING (fixed in 1.5.1 — the write side of the same overflow). This used
    # a fixed `alloc(4096)` and memcpy'd every escaped field into it with no
    # bound, so any row totalling more than 4,095 bytes wrote past the block.
    # Measure first: escape each field once, sum the exact lengths, allocate,
    # then copy. Escaping twice would be wasteful and — worse — would let the
    # measured and copied lengths disagree if escaping were ever non-
    # deterministic, so the escaped forms are kept.
    var n = vec_len(fields);
    if (n == 1) {
        if (strlen(vec_get(fields, 0)) == 0) {
            var lone = alloc_via(default_alloc(), 5);
            if (lone == 0) { return 0; }
            memcpy(lone, "\"\"\r\n", 4);
            store8(lone + 4, 0);
            return lone;
        }
    }
    var esc = vec_new();
    if (esc == 0) { return 0; }
    var total = 0;
    var i = 0;
    while (i < n) {
        var e = bayan_csv_escape(vec_get(fields, i));
        if (e == 0) { return 0; }
        if (vec_push_a(default_alloc(), esc, e) < 0) { return 0; }
        total = total + strlen(e);
        if (i > 0) { total = total + 1; }        # the separating comma
        i = i + 1;
    }
    var buf = alloc_via(default_alloc(), total + 3);   # + CRLF + NUL
    if (buf == 0) { return 0; }
    var pos = 0;
    i = 0;
    while (i < n) {
        if (i > 0) { store8(buf + pos, 44); pos = pos + 1; }
        var escaped = vec_get(esc, i);
        var elen = strlen(escaped);
        memcpy(buf + pos, escaped, elen);
        pos = pos + elen;
        i = i + 1;
    }
    store8(buf + pos, 13); pos = pos + 1;
    store8(buf + pos, 10); pos = pos + 1;
    store8(buf + pos, 0);
    return buf;
}
