# tests/json_slice_trap.cyr — json's parsers read the document through bounds-checked slices
# (1.11.1; cyrius 6.7.18 D1).
#
# Each mode calls one of the parsers' readers with an index past the input, the read a dropped or
# off-by-one guard would make. Through raw load8 it read whatever byte followed, and answered on
# it; through the slice it is "slice bounds violation" on stderr and exit 134, in every build. CI
# runs each mode and wants exactly that.
#
#   mode 1: _jp_word, the tree and streaming parsers' compare of `true` / `false` / `null`, asked
#           for "rue" one byte past a 3-byte input ("tru" of "true").
#   mode 2: _json_flat_key_dec, the flat parser's key scan, asked to scan past a 3-byte input.
#
#   cyrius build tests/json_slice_trap.cyr build/json-slice-trap && ./build/json-slice-trap 1
#   (exit 134); with no mode it exits 2.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/slice.cyr"
include "lib/hashseed.cyr"
include "lib/math.cyr"
include "lib/fnptr.cyr"
include "lib/args.cyr"

include "src/dtoa.cyr"
include "src/json.cyr"

fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 2) { return 2; }
    var mode = str_to_int(str_from(argv(1)));
    # The input is the first 3 bytes of a longer buffer, so a raw read past it finds a byte.
    var doc = "true\"ab\\\"cd\"";
    if (mode == 1) {
        if (_jp_word(doc, 3, 1, "rue", 3) == 1) { return 1; }
        return 0;
    }
    if (mode == 2) {
        if (_json_flat_key_dec(default_alloc(), doc + 4, 3, 0, 10) != 0) { return 1; }
        return 0;
    }
    return 2;
}

var r = main();
syscall(SYS_EXIT, r);
