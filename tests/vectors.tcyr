# vectors.tcyr — oracle-driven arithmetic vectors (v1.5.2).
#
# The expected values in tests/fixtures/numeric/ come from Python: its
# arbitrary-precision integers for u128, and its shortest-round-trip float
# formatter for f64. That independence is the point. bayan_u256_mul shipped for
# five releases with 46% of its 256-bit products wrong while every test passed,
# because every test compared bayan against bayan; the vectors that caught it
# came from an outside implementation.
#
# Kept in its own file so ~14,000 machine-generated checks do not swamp the
# hand-written assertion counts in bayan.tcyr. It contributes a handful of
# asserts — "0 of 13,843 wrong" — rather than one per vector.
#
# Regenerate the vectors with:
#   python3 scripts/gen-numeric-vectors.py tests/fixtures/numeric
#   python3 scripts/gen-toml-vectors.py    tests/fixtures/toml
#   python3 scripts/gen-csv-vectors.py     tests/fixtures/csv
#   python3 scripts/gen-yaml-vectors.py    tests/fixtures/yaml
#   python3 scripts/gen-markdown-vectors.py tests/fixtures/markdown
#   python3 scripts/gen-toml-tree-vectors.py tests/fixtures/toml
#
# 1.5.3 adds a third set for the same reason the first two exist. src/toml.cyr
# returned the RAW bytes between the quotes for six releases — escapes
# unresolved, literal strings still wearing their quotes — and the suite stayed
# green throughout, because every TOML assertion in it had been written by
# reading bayan's output and writing it down. `tomllib` does not care what
# bayan does.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/math.cyr"
include "lib/assert.cyr"
include "lib/unicode/categories.cyr"
include "lib/unicode/casefold.cyr"

include "src/u128.cyr"
include "src/dtoa.cyr"
include "src/toml.cyr"
include "src/csv.cyr"
include "src/json.cyr"
include "src/yaml.cyr"
include "src/toml_tree.cyr"
include "src/markdown_entities.cyr"
include "src/markdown.cyr"

alloc_init();


fn u_say(m: cstring): i64 { print(m, strlen(m)); return 0; }
fn u_num(n): i64 { var b[24]; var l = fmt_int_buf(n, &b); print(&b, l); return 0; }

var g_total = 0;
var g_bad = 0;
var g_first = 0;

# Parse a lowercase hex field starting at `p`, stopping at space or newline.
# Writes the value to out8 and returns the position after the field.
fn hexf(buf, p, len, out8): i64 {
    var v = 0;
    while (p < len) {
        var c = load8(buf + p);
        var d = 0 - 1;
        if (c >= 48 && c <= 57)  { d = c - 48; }
        if (c >= 97 && c <= 102) { d = c - 87; }
        if (d < 0) { break; }
        v = (v << 4) | d;
        p = p + 1;
    }
    store64(out8, v);
    while (p < len && load8(buf + p) == 32) { p = p + 1; }
    return p;
}

fn fail(op: cstring, idx): i64 {
    g_bad = g_bad + 1;
    if (g_first == 0) {
        g_first = 1;
        u_say("  first failure: "); u_say(op); u_say(" at vector "); u_num(idx); u_say("\n");
    }
    return 0;
}

fn check(op: cstring, idx, got_lo, got_hi, want_lo, want_hi): i64 {
    g_total = g_total + 1;
    if (got_lo != want_lo || got_hi != want_hi) { fail(op, idx); }
    return 0;
}

fn run_u128(): i64 {
    alloc_init();
    var cap = 1 << 20;
    var buf = alloc(cap);
    var len = file_read_all("tests/fixtures/numeric/u128.vec", buf, cap);
    if (len <= 0) { u_say("cannot read the vector file\n"); return 1; }

    var a[16]; var b[16]; var r[16]; var q[16]; var m[16];
    var f[8];
    var pos = 0;
    var idx = 0;

    while (pos < len) {
        # operation mnemonic
        var ops = pos;
        while (pos < len && load8(buf + pos) != 32) { pos = pos + 1; }
        var oplen = pos - ops;
        while (pos < len && load8(buf + pos) == 32) { pos = pos + 1; }
        idx = idx + 1;

        if (oplen == 2 && memeq(buf + ops, "MM", 2) == 1) {
            pos = hexf(buf, pos, len, &f); var ma = load64(&f);
            pos = hexf(buf, pos, len, &f); var mb = load64(&f);
            pos = hexf(buf, pos, len, &f); var mm = load64(&f);
            pos = hexf(buf, pos, len, &f); var mr = load64(&f);
            g_total = g_total + 1;
            if (bayan_u64_mulmod(ma, mb, mm) != mr) { fail("u64_mulmod", idx); }
        } elif (oplen == 2 && memeq(buf + ops, "PM", 2) == 1) {
            pos = hexf(buf, pos, len, &f); var pb = load64(&f);
            pos = hexf(buf, pos, len, &f); var pe = load64(&f);
            pos = hexf(buf, pos, len, &f); var pm = load64(&f);
            pos = hexf(buf, pos, len, &f); var pr = load64(&f);
            g_total = g_total + 1;
            if (bayan_u64_powmod(pb, pe, pm) != pr) { fail("u64_powmod", idx); }
        } elif (oplen == 3 && memeq(buf + ops, "SHL", 3) == 1) {
            pos = hexf(buf, pos, len, &f); var slo = load64(&f);
            pos = hexf(buf, pos, len, &f); var shi = load64(&f);
            pos = hexf(buf, pos, len, &f); var sn  = load64(&f);
            pos = hexf(buf, pos, len, &f); var wlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var whi = load64(&f);
            bayan_u128_set(&a, slo, shi);
            bayan_u128_shl(&r, &a, sn);
            check("shl", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), wlo, whi);
            # the in-place form must agree with the out-of-place one
            bayan_u128_set(&b, slo, shi);
            bayan_u128_shleq(&b, sn);
            check("shleq", idx, bayan_u128_lo(&b), bayan_u128_hi(&b), wlo, whi);
        } elif (oplen == 3 && memeq(buf + ops, "SHR", 3) == 1) {
            pos = hexf(buf, pos, len, &f); var rlo0 = load64(&f);
            pos = hexf(buf, pos, len, &f); var rhi0 = load64(&f);
            pos = hexf(buf, pos, len, &f); var rn   = load64(&f);
            pos = hexf(buf, pos, len, &f); var rwlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var rwhi = load64(&f);
            bayan_u128_set(&a, rlo0, rhi0);
            bayan_u128_shr(&r, &a, rn);
            check("shr", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), rwlo, rwhi);
            bayan_u128_set(&b, rlo0, rhi0);
            bayan_u128_shreq(&b, rn);
            check("shreq", idx, bayan_u128_lo(&b), bayan_u128_hi(&b), rwlo, rwhi);
        } elif (oplen == 3 && memeq(buf + ops, "NOT", 3) == 1) {
            pos = hexf(buf, pos, len, &f); var nlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var nhi = load64(&f);
            pos = hexf(buf, pos, len, &f);
            pos = hexf(buf, pos, len, &f);
            pos = hexf(buf, pos, len, &f); var nwlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var nwhi = load64(&f);
            bayan_u128_set(&a, nlo, nhi);
            bayan_u128_not(&r, &a);
            check("not", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), nwlo, nwhi);
        } elif (oplen == 3 && memeq(buf + ops, "CMP", 3) == 1) {
            pos = hexf(buf, pos, len, &f); var clo = load64(&f);
            pos = hexf(buf, pos, len, &f); var chi = load64(&f);
            pos = hexf(buf, pos, len, &f); var dlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var dhi = load64(&f);
            pos = hexf(buf, pos, len, &f); var wgt = load64(&f);
            pos = hexf(buf, pos, len, &f); var wge = load64(&f);
            pos = hexf(buf, pos, len, &f); var wlt = load64(&f);
            pos = hexf(buf, pos, len, &f); var wle = load64(&f);
            bayan_u128_set(&a, clo, chi);
            bayan_u128_set(&b, dlo, dhi);
            g_total = g_total + 4;
            if (bayan_u128_ugt(&a, &b) != wgt) { fail("ugt", idx); }
            if (bayan_u128_uge(&a, &b) != wge) { fail("uge", idx); }
            if (bayan_u128_ult(&a, &b) != wlt) { fail("ult", idx); }
            if (bayan_u128_ule(&a, &b) != wle) { fail("ule", idx); }
        } elif (oplen == 2 && memeq(buf + ops, "DV", 2) == 1) {
            pos = hexf(buf, pos, len, &f); var vlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var vhi = load64(&f);
            pos = hexf(buf, pos, len, &f); var wlo2 = load64(&f);
            pos = hexf(buf, pos, len, &f); var whi2 = load64(&f);
            pos = hexf(buf, pos, len, &f); var qlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var qhi = load64(&f);
            pos = hexf(buf, pos, len, &f); var mlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var mhi = load64(&f);
            bayan_u128_set(&a, vlo, vhi);
            bayan_u128_set(&b, wlo2, whi2);
            bayan_u128_divmod(&q, &m, &a, &b);
            check("divmod-q", idx, bayan_u128_lo(&q), bayan_u128_hi(&q), qlo, qhi);
            check("divmod-r", idx, bayan_u128_lo(&m), bayan_u128_hi(&m), mlo, mhi);
            bayan_u128_div(&r, &a, &b);
            check("div", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), qlo, qhi);
            bayan_u128_mod(&r, &a, &b);
            check("mod", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), mlo, mhi);
        } else {
            # the six binary ops share a layout
            pos = hexf(buf, pos, len, &f); var xlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var xhi = load64(&f);
            pos = hexf(buf, pos, len, &f); var ylo = load64(&f);
            pos = hexf(buf, pos, len, &f); var yhi = load64(&f);
            pos = hexf(buf, pos, len, &f); var zlo = load64(&f);
            pos = hexf(buf, pos, len, &f); var zhi = load64(&f);
            bayan_u128_set(&a, xlo, xhi);
            bayan_u128_set(&b, ylo, yhi);
            if (memeq(buf + ops, "ADD", 3) == 1) {
                bayan_u128_add(&r, &a, &b);
                check("add", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
                bayan_u128_copy(&r, &a); bayan_u128_addeq(&r, &b);
                check("addeq", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
            } elif (memeq(buf + ops, "SUB", 3) == 1) {
                bayan_u128_sub(&r, &a, &b);
                check("sub", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
                bayan_u128_copy(&r, &a); bayan_u128_subeq(&r, &b);
                check("subeq", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
            } elif (memeq(buf + ops, "MUL", 3) == 1) {
                bayan_u128_mul(&r, &a, &b);
                check("mul", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
                bayan_u128_copy(&r, &a); bayan_u128_muleq(&r, &b);
                check("muleq", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
            } elif (memeq(buf + ops, "AND", 3) == 1) {
                bayan_u128_and(&r, &a, &b);
                check("and", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
                bayan_u128_copy(&r, &a); bayan_u128_andeq(&r, &b);
                check("andeq", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
            } elif (memeq(buf + ops, "OR", 2) == 1) {
                bayan_u128_or(&r, &a, &b);
                check("or", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
                bayan_u128_copy(&r, &a); bayan_u128_oreq(&r, &b);
                check("oreq", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
            } elif (memeq(buf + ops, "XOR", 3) == 1) {
                bayan_u128_xor(&r, &a, &b);
                check("xor", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
                bayan_u128_copy(&r, &a); bayan_u128_xoreq(&r, &b);
                check("xoreq", idx, bayan_u128_lo(&r), bayan_u128_hi(&r), zlo, zhi);
            }
        }
        # advance past the newline
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        pos = pos + 1;
    }

    u_say("u128 checks: "); u_num(g_total);
    u_say("   wrong: "); u_num(g_bad); u_say("\n");
    if (g_bad > 0) { return 1; }
    return 42;
}


fn f_say(m: cstring): i64 { print(m, strlen(m)); return 0; }
fn f_num(n): i64 { var b[24]; var l = fmt_int_buf(n, &b); print(&b, l); return 0; }

var g_rt = 0;      # to_json -> parse round-trips to identical bits
var g_rt_bad = 0;
var g_py = 0;      # bayan's parser agrees with Python's formatter
var g_py_bad = 0;
var g_shown = 0;

fn show_fail(label: cstring, text, bits, got): i64 {
    if (g_shown < 4) {
        g_shown = g_shown + 1;
        f_say("    "); f_say(label); f_say(" text=["); print(text, strlen(text));
        f_say("] want_bits="); f_num(bits); f_say(" got="); f_num(got); f_say("\n");
    }
    return 0;
}

fn run_f64(): i64 {
    alloc_init();
    var cap = 1 << 18;
    var buf = alloc(cap);
    var len = file_read_all("tests/fixtures/numeric/f64.vec", buf, cap);
    if (len <= 0) { f_say("cannot read tests/fixtures/numeric/f64.vec\n"); return 1; }

    var out = alloc(64);
    var pytext = alloc(64);
    var pos = 0;

    while (pos < len) {
        # hex bits
        var bits = 0;
        while (pos < len) {
            var c = load8(buf + pos);
            var d = 0 - 1;
            if (c >= 48 && c <= 57)  { d = c - 48; }
            if (c >= 97 && c <= 102) { d = c - 87; }
            if (d < 0) { break; }
            bits = (bits << 4) | d;
            pos = pos + 1;
        }
        while (pos < len && load8(buf + pos) == 32) { pos = pos + 1; }
        # Python's repr, to end of line
        var ts = pos;
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        var tlen = pos - ts;
        pos = pos + 1;
        if (tlen <= 0) { break; }
        if (tlen > 60) { tlen = 60; }
        memcpy(pytext, buf + ts, tlen);
        store8(pytext + tlen, 0);

        # 1. bayan formats, bayan parses: the bits MUST come back identical.
        #    This is the property that matters — Grisu2 is documented as
        #    shortest-OR-NEAR-shortest, so its text may differ from Python's
        #    while still being a faithful representation.
        var n = bayan_f64_to_json(bits, out);
        store8(out + n, 0);
        var back = bayan_f64_parse(out, n);
        g_rt = g_rt + 1;
        if (back != bits) { g_rt_bad = g_rt_bad + 1; show_fail("round-trip", out, bits, back); }

        # 2. bayan parses what Python formatted: an independent check that the
        #    PARSER is right, not merely self-consistent with the formatter.
        var pb = bayan_f64_parse(pytext, strlen(pytext));
        g_py = g_py + 1;
        if (pb != bits) { g_py_bad = g_py_bad + 1; show_fail("parse(py)", pytext, bits, pb); }
    }

    f_say("f64 to_json->parse round-trips: "); f_num(g_rt);
    f_say("   wrong: "); f_num(g_rt_bad); f_say("\n");
    f_say("f64 parse(python repr):         "); f_num(g_py);
    f_say("   wrong: "); f_num(g_py_bad); f_say("\n");
    if (g_rt_bad > 0) { return 1; }
    if (g_py_bad > 0) { return 2; }
    return 42;
}

# --- f64 PARSING, aimed at the hard inputs (1.5.7) ---------------------------
#
# f64.vec is 328 shortest-repr strings, and the parser misrounded ~2 in 10^5 of
# those, so it passed by luck of size (issue 2026-09-22). f64parse.vec aims
# instead: decimals within a few units of a rounding midpoint, full-length exact
# ties, inputs past the exact tier's 800-digit buffer, and the subnormal and
# overflow seams. The pre-1.5.7 parser gets 355 of them wrong. Lines are
# `<hexbits> <text>` with text up to ~830 bytes, so no length cap here.

var g_fp = 0;
var g_fp_bad = 0;

fn run_f64_parse(): i64 {
    var cap = 1 << 20;
    var buf = alloc(cap);
    var len = file_read_all("tests/fixtures/numeric/f64parse.vec", buf, cap);
    if (len <= 0) { f_say("cannot read tests/fixtures/numeric/f64parse.vec\n"); return 1; }
    if (len >= cap) { f_say("tests/fixtures/numeric/f64parse.vec outgrew its buffer\n"); return 1; }
    var pos = 0;
    var shown = 0;
    while (pos < len) {
        var bits = 0;
        while (pos < len) {
            var c = load8(buf + pos);
            var d = 0 - 1;
            if (c >= 48 && c <= 57)  { d = c - 48; }
            if (c >= 97 && c <= 102) { d = c - 87; }
            if (d < 0) { break; }
            bits = (bits << 4) | d;
            pos = pos + 1;
        }
        while (pos < len && load8(buf + pos) == 32) { pos = pos + 1; }
        var ts = pos;
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        var tlen = pos - ts;
        pos = pos + 1;
        if (tlen <= 0) { break; }
        g_fp = g_fp + 1;
        var got = bayan_f64_parse(buf + ts, tlen);
        if (got != bits) {
            g_fp_bad = g_fp_bad + 1;
            if (shown < 4) {
                shown = shown + 1;
                f_say("    parse text=[");
                if (tlen > 60) { print(buf + ts, 60); f_say("..."); } else { print(buf + ts, tlen); }
                f_say("] want_bits="); f_num(bits); f_say(" got="); f_num(got); f_say("\n");
            }
        }
    }
    f_say("f64 parse(python float()):      "); f_num(g_fp);
    f_say("   wrong: "); f_num(g_fp_bad); f_say("\n");
    if (g_fp_bad > 0) { return 1; }
    return 42;
}



# --- TOML string decoding, against Python's tomllib -------------------------
#
# Each vector is a whole TOML document and the value `tomllib` decodes for key
# `x`, both hex-encoded because both routinely contain newlines, quotes and
# backslashes. A leading `S` reads the value with bayan_toml_get; an `A` reads
# it with bayan_toml_get_array and takes element 0, so the element splitter —
# which keeps its own quote-tracking state and got the escaped-quote rule wrong
# independently of the scalar parsers — is checked against the oracle too
# rather than assumed to agree with them. A `P` (1.5.4) carries a table name
# and a key as well, and checks WHERE the pair landed: quoted keys, dotted keys
# naming a table, and trimmed header names are all invisible to S and A,
# because all three are about placement rather than value.

fn t_say(m: cstring): i64 { print(m, strlen(m)); return 0; }
fn t_num(n): i64 { var b[24]; var l = fmt_int_buf(n, &b); print(&b, l); return 0; }

var g_tv = 0;
var g_tv_bad = 0;
var g_tv_shown = 0;

# The test's OWN hex decoder. Reusing src/toml.cyr's would let a defect in the
# module under test corrupt the fixture it is being judged against.
fn t_hexd(c): i64 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70)  { return c - 55; }
    return 0 - 1;
}

# Decode the hex field at `p` into `dst`. Returns the position just after the
# field; the decoded byte count is stored through `outn`.
fn t_hexfield(buf, p, len, dst, outn): i64 {
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (p + 1 >= len) { go = 0; }
        else {
            var h = t_hexd(load8(buf + p));
            var l = t_hexd(load8(buf + p + 1));
            if (h < 0 || l < 0) { go = 0; }
            else {
                store8(dst + n, (h << 4) | l);
                n = n + 1;
                p = p + 2;
            }
        }
    }
    store64(outn, n);
    return p;
}

# Print a byte span with non-printables as '.', so a failure report is legible
# without turning the harness into a formatter.
fn t_dump(p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        var b[1];
        if (c < 32 || c > 126) { store8(&b, 46); } else { store8(&b, c); }
        print(&b, 1);
        i = i + 1;
    }
    return 0;
}

fn t_fail(idx, kind, dbuf, dn, vbuf, vn, got): i64 {
    g_tv_bad = g_tv_bad + 1;
    if (g_tv_shown < 5) {
        g_tv_shown = g_tv_shown + 1;
        t_say("    vector "); t_num(idx); t_say(" kind=");
        var kb[1]; store8(&kb, kind); print(&kb, 1);
        t_say("\n      doc  ["); t_dump(dbuf, dn); t_say("]\n");
        t_say("      want ["); t_dump(vbuf, vn); t_say("] len="); t_num(vn); t_say("\n");
        t_say("      got  [");
        if (got == 0) { t_say("<no value>"); } else { t_dump(str_data(got), str_len(got)); }
        t_say("] len=");
        if (got == 0) { t_say("-"); } else { t_num(str_len(got)); }
        t_say("\n");
    }
    return 0;
}

fn run_toml(): i64 {
    alloc_init();
    var cap = 1 << 20;
    var buf = alloc(cap);
    if (buf == 0) { t_say("cannot allocate the toml vector buffer\n"); return 1; }
    var len = file_read_all("tests/fixtures/toml/strings.vec", buf, cap);
    if (len <= 0) { t_say("cannot read tests/fixtures/toml/strings.vec\n"); return 1; }

    var dbuf = alloc(8192);
    var vbuf = alloc(8192);
    var nout[8];
    var pos = 0;

    var tbuf = alloc(8192);
    var kbuf = alloc(8192);
    while (pos < len) {
        var kind = load8(buf + pos);
        if (kind != 83 && kind != 65 && kind != 80) { break; }   # 'S' / 'A' / 'P'
        pos = pos + 2;                                 # kind + the space
        pos = t_hexfield(buf, pos, len, dbuf, &nout);
        var dn = load64(&nout);
        pos = pos + 1;                                 # the separating space
        var tn = 0;
        var kn = 0;
        if (kind == 80) {
            # P <doc> <table> <key> <value> — the structural kind (1.5.4).
            # S and A can only see what a value decodes to; P sees WHERE the
            # pair landed, which is what quoted keys, dotted keys naming a
            # table, and trimmed header names are all about.
            pos = t_hexfield(buf, pos, len, tbuf, &nout);
            tn = load64(&nout);
            pos = pos + 1;
            pos = t_hexfield(buf, pos, len, kbuf, &nout);
            kn = load64(&nout);
            pos = pos + 1;
        }
        pos = t_hexfield(buf, pos, len, vbuf, &nout);
        var vn = load64(&nout);
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        pos = pos + 1;                                 # past the newline
        if (dn <= 0) { break; }

        var secs = bayan_toml_parse(str_new(dbuf, dn));
        var got = 0;
        if (kind == 80) {
            # Look the table up by NAME. The root table is named "", and it is
            # always sections[0] as of 1.5.4.
            store8(tbuf + tn, 0);
            store8(kbuf + kn, 0);
            var tsecs = bayan_toml_get_sections_by_cstr(secs, tbuf);
            if (vec_len(tsecs) > 0) {
                got = bayan_toml_get_by_cstr(bayan_toml_section_pairs(vec_get(tsecs, 0)), kbuf);
            }
        }
        elif (vec_len(secs) > 0) {
            var pairs = bayan_toml_section_pairs(vec_get(secs, 0));
            if (kind == 65) {
                var els = bayan_toml_get_array_by_cstr(pairs, "x");
                if (els != 0) { if (vec_len(els) > 0) { got = vec_get(els, 0); } }
            } else {
                got = bayan_toml_get_by_cstr(pairs, "x");
            }
        }

        var ok = 0;
        if (got != 0) {
            if (str_len(got) == vn) {
                if (vn == 0) { ok = 1; }
                elif (memeq(str_data(got), vbuf, vn) == 1) { ok = 1; }
            }
        }
        g_tv = g_tv + 1;
        if (ok == 0) { t_fail(g_tv, kind, dbuf, dn, vbuf, vn, got); }
    }

    t_say("toml string vectors: "); t_num(g_tv);
    t_say("   wrong: "); t_num(g_tv_bad); t_say("\n");
    if (g_tv_bad > 0) { return 1; }
    return 42;
}


# =============================================================================
# csv against Python's csv module (1.7.0)
# =============================================================================
#
# P <line> <n> <fields>: bayan_csv_parse_line. W <n> <fields> <line>:
# bayan_csv_write_line. E <field> <escaped>: bayan_csv_escape. Hex fields, `-`
# for an empty one (scripts/gen-csv-vectors.py). Until 1.7.0 the module dropped
# a trailing empty field, wrote LF records, left a CR unquoted and split a field
# at the text after its closing quote, and nothing in the suite compared it with
# a CSV reader that is not bayan.

var g_cv = 0;
var g_cv_bad = 0;

# t_hexfield, plus the `-` that marks an empty field.
fn c_field(buf, p, len, dst, outn): i64 {
    p = t_hexfield(buf, p, len, dst, outn);
    if (load64(outn) == 0 && p < len && load8(buf + p) == 45) { p = p + 1; }
    return p;
}

# A NUL-terminated copy of the next field, for the cstring API.
fn c_cstr(buf, p, len, scratch, outp): i64 {
    var nn[8];
    p = c_field(buf, p, len, scratch, &nn);
    var n = load64(&nn);
    var c = alloc(n + 1);
    memcpy(c, scratch, n);
    store8(c + n, 0);
    store64(outp, c);
    return p + 1;
}

fn c_fail(idx, kind): i64 {
    g_cv_bad = g_cv_bad + 1;
    if (g_cv_bad <= 5) {
        t_say("    csv vector "); t_num(idx); t_say(" kind ");
        var kb[1]; store8(&kb, kind); print(&kb, 1); t_say(" disagrees with Python\n");
    }
    return 0;
}

fn run_csv(): i64 {
    var cap = 1 << 20;
    var buf = alloc(cap);
    if (buf == 0) { t_say("cannot allocate the csv vector buffer\n"); return 1; }
    var len = file_read_all("tests/fixtures/csv/csv.vec", buf, cap);
    if (len <= 0) { t_say("cannot read tests/fixtures/csv/csv.vec\n"); return 1; }
    var scratch = alloc(8192);
    var nout[8];
    var pos = 0;
    while (pos < len) {
        var kind = load8(buf + pos);
        if (kind != 80 && kind != 87 && kind != 69) { break; }   # 'P' / 'W' / 'E'
        pos = pos + 2;
        var ok = 1;
        if (kind == 80) {
            var line = 0;
            pos = c_cstr(buf, pos, len, scratch, &line);
            pos = t_hexfield(buf, pos, len, scratch, &nout) + 1;
            var n = load8(scratch);
            var got = bayan_csv_parse_line(line);
            if (vec_len(got) != n) { ok = 0; }
            var k = 0;
            while (k < n) {
                var want = 0;
                pos = c_cstr(buf, pos, len, scratch, &want);
                if (ok == 1) { if (streq(vec_get(got, k), want) == 0) { ok = 0; } }
                k = k + 1;
            }
        } elif (kind == 87) {
            pos = t_hexfield(buf, pos, len, scratch, &nout) + 1;
            var wn = load8(scratch);
            var fields = vec_new();
            var j = 0;
            while (j < wn) {
                var f = 0;
                pos = c_cstr(buf, pos, len, scratch, &f);
                vec_push(fields, f);
                j = j + 1;
            }
            var wline = 0;
            pos = c_cstr(buf, pos, len, scratch, &wline);
            if (streq(bayan_csv_write_line(fields), wline) == 0) { ok = 0; }
        } else {
            var ef = 0;
            pos = c_cstr(buf, pos, len, scratch, &ef);
            var ee = 0;
            pos = c_cstr(buf, pos, len, scratch, &ee);
            if (streq(bayan_csv_escape(ef), ee) == 0) { ok = 0; }
        }
        # Each record ends in exactly one newline, which c_cstr has stepped past.
        g_cv = g_cv + 1;
        if (ok == 0) { c_fail(g_cv, kind); }
    }
    t_say("csv vectors: "); t_num(g_cv);
    t_say("   wrong: "); t_num(g_cv_bad); t_say("\n");
    if (g_cv_bad > 0) { return 1; }
    return 42;
}

# =============================================================================
# yaml quoted scalars against PyYAML (1.8.0)
# =============================================================================
#
# S <doc> <value>: the string at key k. K <doc> <key>: the document's one key.
# A <doc> <value>: element 0 of k's flow sequence. X <doc>: PyYAML refuses it,
# so bayan must. Hex fields, `-` for an empty one (scripts/gen-yaml-vectors.py).
# Until 1.8.0 a quoted body was verbatim, and each quote scan stopped at the
# first quote character.

var g_yv = 0;
var g_yv_bad = 0;

fn y_got_equals(got, wbuf, wn): i64 {
    if (got == 0) { return 0; }
    if (str_len(got) != wn) { return 0; }
    if (wn == 0) { return 1; }
    return memeq(str_data(got), wbuf, wn);
}

fn run_yaml(): i64 {
    var cap = 1 << 20;
    var buf = alloc(cap);
    if (buf == 0) { t_say("cannot allocate the yaml vector buffer\n"); return 1; }
    var len = file_read_all("tests/fixtures/yaml/strings.vec", buf, cap);
    if (len <= 0) { t_say("cannot read tests/fixtures/yaml/strings.vec\n"); return 1; }
    var dbuf = alloc(8192);
    var wbuf = alloc(8192);
    var nout[8];
    var pos = 0;
    while (pos < len) {
        var kind = load8(buf + pos);
        if (kind != 83 && kind != 75 && kind != 65 && kind != 88) { break; }   # S K A X
        pos = pos + 2;
        pos = c_field(buf, pos, len, dbuf, &nout);
        var dn = load64(&nout);
        var wn = 0;
        if (kind != 88) {
            pos = c_field(buf, pos + 1, len, wbuf, &nout);
            wn = load64(&nout);
        }
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        pos = pos + 1;
        var tree = bayan_yaml_parse_buf(dbuf, dn);
        var ok = 0;
        if (kind == 88) {
            if (tree == 0) { ok = 1; }
        } elif (tree != 0) {
            if (kind == 83) {
                ok = y_got_equals(bayan_json_v_str(bayan_json_v_obj_get_by_cstr(tree, "k")), wbuf, wn);
            } elif (kind == 75) {
                if (bayan_json_v_obj_len(tree) == 1) { ok = y_got_equals(bayan_json_v_obj_key(tree, 0), wbuf, wn); }
            } else {
                var seq = bayan_json_v_obj_get_by_cstr(tree, "k");
                ok = y_got_equals(bayan_json_v_str(bayan_json_v_arr_get(seq, 0)), wbuf, wn);
            }
        }
        g_yv = g_yv + 1;
        if (ok == 0) {
            g_yv_bad = g_yv_bad + 1;
            if (g_yv_bad <= 5) {
                t_say("    yaml vector "); t_num(g_yv); t_say(" kind ");
                var kb[1]; store8(&kb, kind); print(&kb, 1);
                t_say(" ["); t_dump(dbuf, dn); t_say("]\n");
            }
        }
    }
    t_say("yaml vectors: "); t_num(g_yv);
    t_say("   wrong: "); t_num(g_yv_bad); t_say("\n");
    if (g_yv_bad > 0) { return 1; }
    return 42;
}

# --- markdown: the upstream suites' own examples (1.9.0) ------------------------------------------
# Expected HTML from the CommonMark and GFM specs and from cmark's and cmark-gfm's test files, not
# from bayan; scripts/gen-markdown-vectors.py says which examples are excluded and why (raw HTML,
# which bayan writes as text, and cmark-gfm's footnotes). A `C` row has no expected output, only a
# document that must not crash the parser.
var g_mv = 0;
var g_mv_bad = 0;
var g_mv_wiki = 0;

fn m_num(buf, p, len, outv): i64 {
    var v = 0;
    while (p < len && load8(buf + p) >= 48 && load8(buf + p) <= 57) { v = v * 10 + load8(buf + p) - 48; p = p + 1; }
    store64(outv, v);
    return p;
}

# 1 when b[0..n) contains `[[`.
fn m_has_wiki(b, n): i64 {
    var i = 0;
    while (i + 1 < n) {
        if (load8(b + i) == 91 && load8(b + i + 1) == 91) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn m_render(src, n, flags): i64 {
    var doc = bayan_markdown_parse_buf_a(default_alloc(), src, n, flags);
    if (doc == 0) { return 0; }
    return bayan_markdown_to_html(doc);
}

# Run one vector file. `wiki` 1: also run every row without `[[` with MD_EXT_WIKILINKS added, which
# must change nothing.
fn run_markdown(path, wiki): i64 {
    var cap = 1 << 20;
    var buf = alloc(cap);
    if (buf == 0) { t_say("cannot allocate the markdown vector buffer\n"); return 1; }
    var len = file_read_all(path, buf, cap);
    if (len <= 0) { t_say("cannot read "); t_say(path); t_say("\n"); return 1; }
    var mbuf = alloc(65536);
    var hbuf = alloc(65536);
    var nout[8];
    var flags[8];
    var ex[8];
    var pos = 0;
    while (pos < len) {
        var kind = load8(buf + pos);
        if (kind != 86 && kind != 67) { break; }                 # V C
        pos = m_num(buf, pos + 2, len, &flags);
        pos = m_num(buf, pos + 1, len, &ex);
        pos = c_field(buf, pos + 1, len, mbuf, &nout);
        var mn = load64(&nout);
        var hn = 0;
        if (kind == 86) {
            pos = c_field(buf, pos + 1, len, hbuf, &nout);
            hn = load64(&nout);
        }
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        pos = pos + 1;
        var ok = 0;
        var got = m_render(mbuf, mn, load64(&flags));
        if (kind == 67) {
            if (got != 0) { ok = 1; }
        } elif (got != 0 && str_len(got) == hn) {
            if (memeq(str_data(got), hbuf, hn) == 1) { ok = 1; }
        }
        if (ok == 1 && wiki == 1 && m_has_wiki(mbuf, mn) == 0) {
            var gw = m_render(mbuf, mn, load64(&flags) | MD_EXT_WIKILINKS);
            if (gw == 0 || str_eq(gw, got) == 0) { ok = 0; }
            g_mv_wiki = g_mv_wiki + 1;
        }
        g_mv = g_mv + 1;
        if (ok == 0) {
            g_mv_bad = g_mv_bad + 1;
            if (g_mv_bad <= 5) {
                t_say("    "); t_say(path); t_say(" example "); t_num(load64(&ex)); t_say(" [");
                t_dump(mbuf, mn); t_say("]\n");
            }
        }
    }
    return 42;
}

fn run_markdown_all(): i64 {
    if (run_markdown("tests/fixtures/markdown/commonmark-0.31.2.vec", 1) != 42) { return 1; }
    if (run_markdown("tests/fixtures/markdown/gfm-0.29.vec", 0) != 42) { return 1; }
    if (run_markdown("tests/fixtures/markdown/cmark-gfm-extensions.vec", 0) != 42) { return 1; }
    if (run_markdown("tests/fixtures/markdown/cmark-regression.vec", 1) != 42) { return 1; }
    if (run_markdown("tests/fixtures/markdown/cmark-gfm-regression.vec", 0) != 42) { return 1; }
    t_say("markdown vectors: "); t_num(g_mv); t_say(" ("); t_num(g_mv_wiki);
    t_say(" again with wiki links on)   wrong: "); t_num(g_mv_bad); t_say("\n");
    if (g_mv_bad > 0) { return 1; }
    return 42;
}

# =============================================================================
# toml into the tree against Python's tomllib (1.11.0)
# =============================================================================
#
# <hex document> TAB <expected>: `E` when tomllib refuses the document (or bayan cannot hold what
# it returns: an integer past i64, nesting past 128), else the tree in the canonical form
# scripts/gen-toml-tree-vectors.py documents. This writes bayan's tree in that form with its own
# serializer, so nothing in src/ judges itself.

var g_ttv = 0;
var g_ttv_ok = 0;
var g_ttv_bad = 0;
var g_ttv_shown = 0;
var TT_HEX = "0123456789abcdef";

fn tt_hex(sb, p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        str_builder_add_byte(sb, load8(TT_HEX + (c >> 4)));
        str_builder_add_byte(sb, load8(TT_HEX + (c & 15)));
        i = i + 1;
    }
    return 0;
}

# A validated TOML time at p, HH:MM:SS[.fraction], as tomllib's value reads: HH:MM:SS.ffffff, the
# fraction cut or padded to six digits. Returns the end of the time.
fn tt_time(sb, p, end): i64 {
    var i = 0;
    while (i < 8) { str_builder_add_byte(sb, load8(p + i)); i = i + 1; }
    str_builder_add_byte(sb, 46);
    var q = p + 8;
    var nd = 0;
    if (q < end && load8(q) == 46) {
        q = q + 1;
        while (q < end && load8(q) >= 48 && load8(q) <= 57) {
            if (nd < 6) {
                str_builder_add_byte(sb, load8(q));
                nd = nd + 1;
            }
            q = q + 1;
        }
    }
    while (nd < 6) {
        str_builder_add_byte(sb, 48);
        nd = nd + 1;
    }
    return q;
}

# D<kind>:<value> for a date or time cell: `T` between date and time, the offset as +HH:MM.
fn tt_dt(sb, v): i64 {
    var k = bayan_toml_v_datetime_kind(v);
    var s = bayan_json_v_str(v);
    var p = str_data(s);
    var end = p + str_len(s);
    str_builder_add_byte(sb, 68);
    str_builder_add_byte(sb, 48 + k);
    str_builder_add_byte(sb, 58);
    if (k == TOML_DT_TIME) {
        tt_time(sb, p, end);
        return 0;
    }
    var i = 0;
    while (i < 10) { str_builder_add_byte(sb, load8(p + i)); i = i + 1; }
    if (k == TOML_DT_DATE) { return 0; }
    str_builder_add_byte(sb, 84);
    var q = tt_time(sb, p + 11, end);
    if (k == TOML_DT_LOCAL) { return 0; }
    var o = load8(q);
    var zero = 0;
    if (o == 90 || o == 122) { zero = 1; }
    elif (load8(q + 1) == 48 && load8(q + 2) == 48 && load8(q + 4) == 48 && load8(q + 5) == 48) { zero = 1; }
    if (zero == 1) {
        str_builder_add_cstr(sb, "+00:00");
        return 0;
    }
    i = 0;
    while (i < 6) { str_builder_add_byte(sb, load8(q + i)); i = i + 1; }
    return 0;
}

fn tt_ser(sb, v): i64 {
    var t = load64(v);
    if (t == JTAG_BOOL) {
        if (bayan_json_v_bool(v) == 1) { str_builder_add_cstr(sb, "B1"); }
        else { str_builder_add_cstr(sb, "B0"); }
    } elif (t == JTAG_INT) {
        str_builder_add_byte(sb, 73);
        var nb[24];
        var nl = fmt_int_buf(bayan_json_v_int(v), &nb);
        var j = 0;
        while (j < nl) { str_builder_add_byte(sb, load8(&nb + j)); j = j + 1; }
    } elif (t == JTAG_FLOAT) {
        str_builder_add_byte(sb, 70);
        var bits = bayan_json_v_float(v);
        var sh = 60;
        while (sh >= 0) {
            str_builder_add_byte(sb, load8(TT_HEX + ((bits >> sh) & 15)));
            sh = sh - 4;
        }
    } elif (t == JTAG_STR) {
        if (bayan_toml_v_datetime_kind(v) != 0) { tt_dt(sb, v); }
        else {
            str_builder_add_byte(sb, 83);
            var s = bayan_json_v_str(v);
            tt_hex(sb, str_data(s), str_len(s));
        }
    } elif (t == JTAG_ARR) {
        str_builder_add_byte(sb, 91);
        var n = bayan_json_v_arr_len(v);
        var i = 0;
        while (i < n) {
            tt_ser(sb, bayan_json_v_arr_get(v, i));
            str_builder_add_byte(sb, 59);
            i = i + 1;
        }
        str_builder_add_byte(sb, 93);
    } elif (t == JTAG_OBJ) {
        str_builder_add_byte(sb, 123);
        var m = bayan_json_v_obj_len(v);
        var k = 0;
        while (k < m) {
            var key = bayan_json_v_obj_key(v, k);
            tt_hex(sb, str_data(key), str_len(key));
            str_builder_add_byte(sb, 61);
            tt_ser(sb, bayan_json_v_obj_val(v, k));
            str_builder_add_byte(sb, 59);
            k = k + 1;
        }
        str_builder_add_byte(sb, 125);
    } else {
        str_builder_add_cstr(sb, "?");
    }
    return 0;
}

fn run_toml_tree(): i64 {
    alloc_init();
    var cap = 4 << 20;
    var buf = alloc(cap);
    if (buf == 0) { t_say("cannot allocate the toml tree vector buffer\n"); return 1; }
    var len = file_read_all("tests/fixtures/toml/tree.vec", buf, cap);
    if (len <= 0) { t_say("cannot read tests/fixtures/toml/tree.vec\n"); return 1; }
    if (len >= cap) { t_say("tests/fixtures/toml/tree.vec outgrew its buffer\n"); return 1; }
    var dbuf = alloc(1 << 20);
    var pos = 0;
    while (pos < len) {
        var tab = pos;
        while (tab < len && load8(buf + tab) != 9) { tab = tab + 1; }
        var nout[8];
        t_hexfield(buf, pos, tab, dbuf, &nout);
        var dn = load64(&nout);
        var ws = buf + tab + 1;
        pos = tab + 1;
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        var wn = buf + pos - ws;
        pos = pos + 1;
        var v = bayan_toml_v_parse_buf(dbuf, dn);
        var sb = str_builder_new();
        if (v == 0) { str_builder_add_byte(sb, 69); }
        else {
            tt_ser(sb, v);
            g_ttv_ok = g_ttv_ok + 1;
        }
        var got = str_builder_build(sb);
        g_ttv = g_ttv + 1;
        var ok = 0;
        if (str_len(got) == wn) {
            if (memeq(str_data(got), ws, wn) == 1) { ok = 1; }
        }
        if (ok == 0) {
            g_ttv_bad = g_ttv_bad + 1;
            if (g_ttv_shown < 5) {
                g_ttv_shown = g_ttv_shown + 1;
                t_say("    vector "); t_num(g_ttv); t_say("\n      doc  ["); t_dump(dbuf, dn);
                t_say("]\n      want ["); t_dump(ws, wn); t_say("]\n      got  [");
                t_dump(str_data(got), str_len(got));
                if (v == 0) { t_say("] "); t_say(bayan_toml_v_last_error()); }
                else { t_say("]"); }
                t_say("\n");
            }
        }
    }
    t_say("toml tree vectors: "); t_num(g_ttv); t_say(" ("); t_num(g_ttv_ok);
    t_say(" parsed)   wrong: "); t_num(g_ttv_bad); t_say("\n");
    if (g_ttv_bad > 0) { return 1; }
    return 42;
}

test_group("vectors: u128 against Python's arbitrary-precision integers");
var uv = run_u128();
assert_eq(uv, 42, "u128: the vector file loaded and every check ran");
assert_gt(g_total, 12000, "u128: the expected number of checks actually ran");
assert_eq(g_bad, 0, "u128: zero disagreements with the oracle");

test_group("vectors: f64 round-trip against Python's float formatter");
var fv = run_f64();
assert_eq(fv, 42, "f64: the vector file loaded and every check ran");
assert_gt(g_rt, 300, "f64: the expected number of round-trips ran");
assert_eq(g_rt_bad, 0, "f64: every value survives to_json -> parse unchanged");
assert_eq(g_py_bad, 0, "f64: and bayan's parser agrees with Python's formatter");

test_group("vectors: f64 parsing of near-midpoint decimals against Python's float()");
var fpv = run_f64_parse();
assert_eq(fpv, 42, "f64 parse: the vector file loaded and every check ran");
assert_gt(g_fp, 7700, "f64 parse: the expected number of vectors actually ran");
assert_eq(g_fp_bad, 0, "f64 parse: every one is correctly rounded");

test_group("vectors: toml string decoding against Python's tomllib");
var tv = run_toml();
assert_eq(tv, 42, "toml: the vector file loaded and every check ran");
assert_gt(g_tv, 1480, "toml: the expected number of vectors actually ran");
assert_eq(g_tv_bad, 0, "toml: zero disagreements with the oracle");

test_group("vectors: csv against Python's csv module (1.7.0)");
var cvv = run_csv();
assert_eq(cvv, 42, "csv: the vector file loaded and every check ran");
assert_gt(g_cv, 4800, "csv: the expected number of vectors actually ran");
assert_eq(g_cv_bad, 0, "csv: zero disagreements with the oracle");

test_group("vectors: yaml quoted scalars against PyYAML (1.8.0)");
var yvv = run_yaml();
assert_eq(yvv, 42, "yaml: the vector file loaded and every check ran");
assert_gt(g_yv, 3400, "yaml: the expected number of vectors actually ran");
assert_eq(g_yv_bad, 0, "yaml: zero disagreements with the oracle");

test_group("vectors: markdown against the CommonMark, GFM, cmark and cmark-gfm suites (1.9.0)");
var mvv = run_markdown_all();
assert_eq(mvv, 42, "markdown: the vector files loaded and every check ran");
assert_gt(g_mv, 660, "markdown: the expected number of vectors actually ran");
assert_gt(g_mv_wiki, 580, "markdown: (and the CommonMark ones again with wiki links on)");
assert_eq(g_mv_bad, 0, "markdown: zero disagreements with the suites");

test_group("vectors: toml into the tree against Python's tomllib (1.11.0)");
var ttvv = run_toml_tree();
assert_eq(ttvv, 42, "toml tree: the vector file loaded and every check ran");
assert_gt(g_ttv, 3400, "toml tree: the expected number of vectors actually ran");
assert_gt(g_ttv_ok, 2000, "toml tree: (over two thousand of them parse; the rest are refused)");
assert_eq(g_ttv_bad, 0, "toml tree: zero disagreements with the oracle");

var r = assert_summary();
