# pdf_flate.tcyr — the FlateDecode / FlateEncode path, isolated.
#
# This is the ONLY test that pulls in lib/sankoch.cyr, and it is separate from
# tests/bayan.tcyr for a reason worth stating: src/pdf.cyr deliberately does NOT
# depend on sankoch. bayan folds into cyrius's stdlib, and a hard include of
# sankoch.cyr from a folded module would create a module-ordering hazard there
# for a filter most consumers never touch. So compression is reached through
# consumer-installed function pointers instead:
#
#     bayan_pdf_set_inflate(&zlib_decompress)
#     bayan_pdf_set_deflate(&zlib_compress)
#
# Keeping this file separate means the main suite proves the HOOK-ABSENT path
# (a valid uncompressed writer, a loud reader error) while this one proves the
# HOOK-PRESENT path, and neither can accidentally mask the other.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"
include "lib/sankoch.cyr"

include "src/pdf.cyr"

alloc_init();

test_group("pdf: the Flate hooks dispatch through fncall4 (v1.5.0)");
assert_eq(bayan_pdf_has_inflate(), 0, "flate: no inflate hook before installation");
assert_eq(bayan_pdf_has_deflate(), 0, "flate: no deflate hook before installation");

bayan_pdf_set_inflate(&zlib_decompress);
bayan_pdf_set_deflate(&zlib_compress);

assert_eq(bayan_pdf_has_inflate(), 1, "flate: the inflate hook installs");
assert_eq(bayan_pdf_has_deflate(), 1, "flate: the deflate hook installs");

test_group("pdf: reading a FlateDecode content stream");
# ref-flate.pdf's page content is a zlib stream. Without the hook the main
# suite asserts this same file reports a loud error; with it installed the
# text must come back intact.
var fl_doc = bayan_pdf_parse_file("tests/fixtures/pdf/ref-flate.pdf");
assert_neq(fl_doc, 0, "flate: a Flate file parses");
var fl_txt = bayan_pdf_extract_text(fl_doc);
assert_eq(str_contains_cstr(fl_txt, "Hello bayan"), 1, "flate: its compressed text decodes");
assert_eq(str_contains_cstr(fl_txt, "quick brown fox"), 1, "flate: all of it, not just the first run");
assert_eq(bayan_pdf_doc_error_count(fl_doc), 0, "flate: and no error is recorded");

test_group("pdf: PDF 1.5 xref streams need inflate too");
# The cross-reference of a 1.5 file is itself a Flate stream with a PNG
# predictor, so this exercises the hook on the xref path rather than content.
var fl_15 = bayan_pdf_parse_file("tests/fixtures/pdf/ref-15-objstm.pdf");
assert_neq(fl_15, 0, "flate: an xref-stream file parses with the hook installed");
assert_eq(bayan_pdf_page_count(fl_15), 1, "flate: its page tree resolves");
assert_eq(str_contains_cstr(bayan_pdf_extract_text(fl_15), "PDF 1.5"), 1,
  "flate: text from inside a compressed object stream extracts");

test_group("pdf: writing compressed output");
var fl_w = bayan_pdf_new();
var fl_pg = bayan_pdf_add_page(fl_w, bayan_pdf_page_size_w(PDF_PAGE_A4), bayan_pdf_page_size_h(PDF_PAGE_A4));
# Highly repetitive content — the shape a text PDF actually has, where every
# line repeats "BT /F1 11 Tf ... Tj ET". Measured on mneme's real output this
# compresses about 7.9x, which is why the hook is worth having at all.
var fl_i = 0;
while (fl_i < 60) {
    bayan_pdf_text_at(fl_pg, PDF_FONT_HELVETICA, 11000, 72000, 760000 - fl_i * 12000,
      str_from("the quick brown fox jumps over the lazy dog"));
    fl_i = fl_i + 1;
}

bayan_pdf_set_compress(fl_w, 0);
var fl_raw = bayan_pdf_to_bytes(fl_w);
bayan_pdf_set_compress(fl_w, 1);
var fl_zip = bayan_pdf_to_bytes(fl_w);

assert_gt(str_len(fl_raw), 0, "flate: the uncompressed form serialises");
assert_gt(str_len(fl_zip), 0, "flate: the compressed form serialises");
assert_lt(str_len(fl_zip), str_len(fl_raw), "flate: compression actually makes it smaller");
assert_eq(bayan_pdf_doc_error_count(fl_w), 0, "flate: with no writer error");

test_group("pdf: compressed output round-trips through the reader");
# The real proof is not that the bytes shrank but that they still mean the
# same thing.
var fl_back = bayan_pdf_parse(fl_zip);
assert_neq(fl_back, 0, "flate: compressed output parses back");
assert_eq(bayan_pdf_page_count(fl_back), 1, "flate: with its page intact");
assert_eq(str_contains_cstr(bayan_pdf_extract_text(fl_back), "quick brown fox"), 1,
  "flate: and its text decodes to what was written");
var fl_plain = bayan_pdf_parse(fl_raw);
assert_eq(str_eq(bayan_pdf_extract_text(fl_back), bayan_pdf_extract_text(fl_plain)), 1,
  "flate: compressed and uncompressed extract IDENTICAL text");

test_group("pdf: a failing Flate stream is decoded once, and charged (1.11.1, CYRIUS-2026-0045)");
# The audit's file: N pages naming one /FlateDecode stream the hook cannot
# inflate (sankoch's 16 MiB ceiling on 20,000,000 spaces). 1.11.0 memoised only
# a success, so every page inflated it again into fresh buffers, and a failure
# was never charged to the per-document budget: 48 pages of a 25 KB file reached
# 1.9 GB. fb_hook is that ceiling in miniature: "too small" below 1 MiB, then a
# hard error, so one stream costs 9 attempts (4096 .. 1 MiB, about 2 MiB).
var fb_calls = 0;
fn fb_hook(src, n, dst, cap): i64 {
    fb_calls = fb_calls + 1;
    if (cap < 1048576) { return 0 - 2; }
    return 0 - 1;
}

# Ten digits, zero-padded: an xref entry's offset field.
fn fb_pad10(sb, n): i64 {
    var d = 1000000000;
    while (d > 0) {
        str_builder_putc(sb, 48 + (n / d) % 10);
        d = d / 10;
    }
    return 0;
}

# A PDF of `npages` pages, each naming a 4-byte /FlateDecode stream. Objects 3,
# 4, 5, ...: odd ones are streams, even ones pages. Mode 0: pages 4, 6, ... all
# name stream 3. Mode 1: ONE page object (4) that /Kids repeats `npages` times.
# Mode 2: page 4 + 2i names its own stream, 5 + 2i.
fn fb_pdf(npages, mode): Str {
    var sb = str_builder_new();
    var offs = vec_new();
    str_builder_add_cstr(sb, "%PDF-1.4\n");
    vec_push(offs, load64(sb + 8));
    str_builder_add_cstr(sb, "1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n");
    vec_push(offs, load64(sb + 8));
    str_builder_add_cstr(sb, "2 0 obj\n<< /Type /Pages /Kids [");
    var i = 0;
    while (i < npages) {
        var kid = 4 + 2 * i;
        if (mode == 1) { kid = 4; }
        str_builder_add_int(sb, kid);
        str_builder_add_cstr(sb, " 0 R ");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "] /Count ");
    str_builder_add_int(sb, npages);
    str_builder_add_cstr(sb, " >>\nendobj\n");
    var last = 2 + 2 * npages;
    if (mode == 1) { last = 4; }
    if (mode == 2) { last = last + 1; }
    var k = 3;
    while (k <= last) {
        vec_push(offs, load64(sb + 8));
        str_builder_add_int(sb, k);
        if ((k & 1) == 1) {
            str_builder_add_cstr(sb, " 0 obj\n<< /Length 4 /Filter /FlateDecode >>\nstream\nxxxx\nendstream\nendobj\n");
        } else {
            str_builder_add_cstr(sb, " 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents ");
            if (mode == 2) { str_builder_add_int(sb, k + 1); } else { str_builder_add_int(sb, 3); }
            str_builder_add_cstr(sb, " 0 R >>\nendobj\n");
        }
        k = k + 1;
    }
    var xref = load64(sb + 8);
    var n = vec_len(offs);
    str_builder_add_cstr(sb, "xref\n0 ");
    str_builder_add_int(sb, n + 1);
    str_builder_add_cstr(sb, "\n0000000000 65535 f \n");
    i = 0;
    while (i < n) {
        fb_pad10(sb, vec_get(offs, i));
        str_builder_add_cstr(sb, " 00000 n \n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "trailer\n<< /Size ");
    str_builder_add_int(sb, n + 1);
    str_builder_add_cstr(sb, " /Root 1 0 R >>\nstartxref\n");
    str_builder_add_int(sb, xref);
    str_builder_add_cstr(sb, "\n%%EOF\n");
    return str_builder_build(sb);
}

# Parse, extract every page's text, and answer the bytes the extraction
# allocated; fb_calls counts the hook's attempts, and fb_doc keeps the document.
var fb_doc = 0;
fn fb_cost(npages, mode): i64 {
    fb_calls = 0;
    fb_doc = bayan_pdf_parse(fb_pdf(npages, mode));
    if (fb_doc == 0) { return 0 - 1; }
    var before = alloc_used();
    bayan_pdf_extract_text(fb_doc);
    return alloc_used() - before;
}

bayan_pdf_set_inflate(&fb_hook);
var fb_one = fb_cost(1, 0);
assert_gt(fb_one, 1048576, "flate bomb: one failing stream costs its attempts (over 1 MiB)");
assert_eq(fb_calls, 9, "flate bomb: nine attempts, 4096 bytes doubling to 1 MiB");
var fb_shared = fb_cost(64, 0);
assert_eq(bayan_pdf_page_count(fb_doc), 64, "flate bomb: 64 pages naming one stream all walk");
assert_eq(fb_calls, 9, "flate bomb: the failing stream is decoded ONCE for 64 pages, not 64 times");
assert_lt(fb_shared, fb_one + 262144, "flate bomb: so 64 pages allocate what one page does");
assert_eq(str_eq_cstr(str_from(bayan_pdf_doc_error(fb_doc)),
    "FlateDecode failed (the inflate hook reported an error)"), 1,
  "flate bomb: and the failure is named");
var fb_rep = fb_cost(64, 1);
assert_eq(bayan_pdf_page_count(fb_doc), 64,
  "flate bomb: one page object repeated 64 times in /Kids walks 64 pages");
assert_eq(fb_calls, 9, "flate bomb: the repeated page's stream is decoded once too");
assert_lt(fb_rep, fb_one + 262144, "flate bomb: and costs what one page does");

# Distinct failing streams: each costs its attempts, and the attempts are
# charged, so the per-document budget stops the document. At 8 MiB four streams
# (about 2 MiB each) fit and the fifth is cut short; 1.11.0 charged none of
# them, called the hook 576 times and allocated about 128 MiB.
var fb_saved = _PDF_MAX_INFTOT;
_PDF_MAX_INFTOT = 8388608;
var fb_many = fb_cost(64, 2);
_PDF_MAX_INFTOT = fb_saved;
assert_lt(fb_many, 8388608 + 1048576,
  "flate bomb: 64 distinct failing streams stop at the per-document budget");
assert_lt(fb_calls, 64, "flate bomb: and the hook is not called once the budget is spent");
assert_gt(bayan_pdf_doc_error_count(fb_doc), 60, "flate bomb: every refused page is counted");

# A stream that fits in what the budget has left still decodes: the last
# attempt is shrunk to the room left, not refused.
fn fb_ok_hook(src, n, dst, cap): i64 {
    if (cap < 3) { return 0 - 2; }
    store8(dst, 81);
    store8(dst + 1, 82);
    return 2;
}
bayan_pdf_set_inflate(&fb_ok_hook);
_PDF_MAX_INFTOT = 100;
var fb_small = bayan_pdf_parse(fb_pdf(1, 0));
assert_eq(str_len(bayan_pdf_stream_data(fb_small, bayan_pdf_obj(fb_small, 3))), 2,
  "flate budget: an output that fits the room left decodes (its buffer shrinks to it)");
assert_eq(bayan_pdf_doc_error_count(fb_small), 0, "flate budget: with no error");
_PDF_MAX_INFTOT = 50;
var fb_none = bayan_pdf_parse(fb_pdf(2, 2));
bayan_pdf_stream_data(fb_none, bayan_pdf_obj(fb_none, 3));
assert_eq(str_len(bayan_pdf_stream_data(fb_none, bayan_pdf_obj(fb_none, 5))), 0,
  "flate budget: with no room left, the next stream is refused");
assert_eq(str_eq_cstr(str_from(bayan_pdf_doc_error(fb_none)),
    "decoded stream bytes exceed the per-document limit"), 1, "flate budget: by name");
_PDF_MAX_INFTOT = fb_saved;
bayan_pdf_set_inflate(&zlib_decompress);

var r = assert_summary();
