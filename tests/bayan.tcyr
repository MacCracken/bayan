# bayan test suite — canonical bayan_* API + back-compat alias parity.
# Includes the full bundle (8 modules + _compat aliases) + stdlib prereqs,
# exactly as a consumer pulls lib/bayan.cyr. (Aliases live in _compat.cyr,
# which references every bayan_* symbol — so the whole bundle must be in
# scope to exercise them.)

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

include "src/base64.cyr"
include "src/csv.cyr"
include "src/u128.cyr"
include "src/bigint.cyr"
include "src/toml.cyr"
include "src/cyml.cyr"
include "src/dtoa.cyr"
include "src/json.cyr"
include "src/yaml.cyr"
include "src/pdf.cyr"
include "src/_compat.cyr"

alloc_init();

# Streaming-parser callback state + handlers (used by the "json streaming
# parser" group below). Defined up front: a function pointer is taken with the
# address-of operator `&fn` (see bayan_json_stream_on calls below), and the
# single-pass compiler needs each callback defined before that registration.
var _strm_obj = 0; var _strm_arr = 0; var _strm_key = 0; var _strm_str = 0;
var _strm_int = 0; var _strm_bool = 0; var _strm_null = 0; var _strm_err = 0;
var _strm_last_bool = 0 - 1; var _strm_acc = 0;
fn _strm_reset() {
    _strm_obj = 0; _strm_arr = 0; _strm_key = 0; _strm_str = 0;
    _strm_int = 0; _strm_bool = 0; _strm_null = 0; _strm_err = 0;
    _strm_last_bool = 0 - 1; _strm_acc = 0;
    return 0;
}
fn _strm_cb_obj(ctx)     { _strm_obj  = _strm_obj + 1;  return 0; }
fn _strm_cb_arr(ctx)     { _strm_arr  = _strm_arr + 1;  return 0; }
fn _strm_cb_key(ctx, k)  { _strm_key  = _strm_key + 1;  return 0; }
fn _strm_cb_str(ctx, s)  { _strm_str  = _strm_str + 1;  return 0; }
fn _strm_cb_int(ctx, n)  { _strm_int  = _strm_int + 1; _strm_acc = _strm_acc + n; return 0; }
fn _strm_cb_bool(ctx, b) { _strm_bool = _strm_bool + 1; _strm_last_bool = b; return 0; }
fn _strm_cb_null(ctx)    { _strm_null = _strm_null + 1; return 0; }
fn _strm_cb_err(ctx, m, p) { _strm_err = _strm_err + 1; return 0; }

test_group("base64 encode/decode (canonical)");
assert_eq(streq(bayan_base64_encode("foo", 3), "Zm9v"), 1, "encode foo");
assert_eq(streq(bayan_base64_encode("fo", 2), "Zm8="), 1, "encode fo (pad)");
var d = bayan_base64_decode("Zm9v", 4);
assert_eq(load64(d + 8), 3, "decode len 3");
assert_eq(memeq(load64(d), "foo", 3), 1, "decode foo");

test_group("base64 back-compat alias");
assert_eq(streq(base64_encode("foo", 3), "Zm9v"), 1, "alias encode == canonical");
var d2 = base64_decode("Zm9v", 4);
assert_eq(memeq(load64(d2), "foo", 3), 1, "alias decode == canonical");

test_group("u128 + alias parity");
var a[16]; var b[16]; var c[16];
bayan_u128_from_u64(&a, 5); bayan_u128_from_u64(&b, 7); bayan_u128_add(&c, &a, &b);
assert_eq(bayan_u128_lo(&c), 12, "canonical 5+7=12");
u128_from_u64(&a, 100); u128_from_u64(&b, 23); u128_add(&c, &a, &b);
assert_eq(u128_lo(&c), 123, "alias 100+23=123");

test_group("json value parser — reentrant per-call state (v1.0.3)");
# Nested object/array exercises recursive descent crossing sub-parser call
# boundaries — the cursor-threading regression for the thread-safety fix.
var js = "{\"name\": \"bayan\", \"ver\": 103, \"tags\": [\"json\", \"u128\"], \"meta\": {\"ok\": true}}";
var doc = bayan_json_v_parse_buf(js, strlen(js));
assert_eq(doc != 0, 1, "parse nested object");
assert_eq(bayan_json_v_is_obj(doc), 1, "root is object");
assert_eq(streq(str_data(bayan_json_v_str(bayan_json_v_obj_get(doc, "name"))), "bayan"), 1, "name == bayan");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(doc, "ver")), 103, "ver == 103");
var tags = bayan_json_v_obj_get(doc, "tags");
assert_eq(bayan_json_v_arr_len(tags), 2, "tags has 2 elements");
assert_eq(streq(str_data(bayan_json_v_str(bayan_json_v_arr_get(tags, 1))), "u128"), 1, "tags[1] == u128");
var meta = bayan_json_v_obj_get(doc, "meta");
assert_eq(bayan_json_v_bool(bayan_json_v_obj_get(meta, "ok")), 1, "meta.ok == true");

# Reentrant ctx path: caller-owned stack state, touches no module globals.
var ps[48];
var d2 = bayan_json_v_parse_ctx(&ps, js, strlen(js));
assert_eq(d2 != 0, 1, "ctx parse ok");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(d2, "ver")), 103, "ctx ver == 103");
assert_eq(streq(bayan_json_state_error(&ps), ""), 1, "ctx clean on success");
assert_eq(bayan_json_parse_state_size(), 48, "state size == 48");

# Two independent states stay independent (sequential proxy for the
# concurrency the fix enables — no shared cursor between them).
var psa[48]; var psb[48];
var sa = "[1, 2, 3]"; var sb = "{\"x\": 9}";
var da = bayan_json_v_parse_ctx(&psa, sa, strlen(sa));
var db = bayan_json_v_parse_ctx(&psb, sb, strlen(sb));
assert_eq(bayan_json_v_arr_len(da), 3, "state A array len 3");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(db, "x")), 9, "state B x == 9");

# Error reporting lives in the per-call state (not the globals).
var pse[48];
var se = "{\"k\": }";
var bad = bayan_json_v_parse_ctx(&pse, se, strlen(se));
assert_eq(bad, 0, "malformed object rejected");
assert_eq(streq(bayan_json_state_error(&pse), ""), 0, "error message recorded");
assert_eq(bayan_json_state_error_pos(&pse) >= 0, 1, "error pos recorded");

# Trailing content after a complete value is rejected.
var pst[48];
var st = "42 oops";
assert_eq(bayan_json_v_parse_ctx(&pst, st, strlen(st)), 0, "trailing content rejected");

test_group("json streaming parser — reentrant callbacks (v1.0.3)");
# Register real callbacks (fnptr via `&fn`) and assert per-event dispatch — this
# exercises the fncallN(fp, ...) path through every reentrant _js_* helper, not
# just the driver's return value.
var sh = bayan_json_stream_handler_new(0);
assert_eq(bayan_json_stream_on(sh, JS_EV_OBJECT_START, &_strm_cb_obj), 0, "register obj_start");
bayan_json_stream_on(sh, JS_EV_ARRAY_START, &_strm_cb_arr);
bayan_json_stream_on(sh, JS_EV_KEY,         &_strm_cb_key);
bayan_json_stream_on(sh, JS_EV_STRING,      &_strm_cb_str);
bayan_json_stream_on(sh, JS_EV_INT,         &_strm_cb_int);
bayan_json_stream_on(sh, JS_EV_BOOL,        &_strm_cb_bool);
bayan_json_stream_on(sh, JS_EV_NULL,        &_strm_cb_null);
bayan_json_stream_on(sh, JS_EV_ERROR,       &_strm_cb_err);
assert_eq(bayan_json_stream_on(sh, JS_EV_COUNT, &_strm_cb_int), 0 - 1, "out-of-range event_id rejected");

# Nested doc: root {a,b,d,e} + nested {c}; values exercise int/bool/null/string.
_strm_reset();
var sjs = "{\"a\": [1, 2, 3], \"b\": {\"c\": true}, \"d\": \"x\\ny\", \"e\": null}";
assert_eq(bayan_json_stream_parse(sjs, strlen(sjs), sh), 0, "stream-parse nested doc ok");
assert_eq(_strm_obj, 2, "2 object starts (root + nested)");
assert_eq(_strm_arr, 1, "1 array start");
assert_eq(_strm_key, 5, "5 keys (a,b,d,e,c)");
assert_eq(_strm_int, 3, "3 int events");
assert_eq(_strm_acc, 6, "int values summed via callback dispatch (1+2+3)");
assert_eq(_strm_bool, 1, "1 bool event");
assert_eq(_strm_last_bool, 1, "bool value = true");
assert_eq(_strm_null, 1, "1 null event");
assert_eq(_strm_str, 1, "1 string value (\"x\\ny\")");

# Float values fire on_float, never on_int (exercises _js_parse_number's path).
_strm_reset();
var sflt = "[1, 2.5, -3.0e2]";
assert_eq(bayan_json_stream_parse(sflt, strlen(sflt), sh), 0, "stream-parse mixed numbers ok");
assert_eq(_strm_int, 1, "1 int (the bare 1)");
assert_eq(_strm_acc, 1, "int accumulator = 1 (floats not summed as ints)");

# Malformed input fires on_error and returns -1, with the error mirrored into
# the legacy last-error slots.
_strm_reset();
var sbad = "{\"k\": }";
assert_eq(bayan_json_stream_parse(sbad, strlen(sbad), sh), 0 - 1, "malformed -> -1");
assert_eq(_strm_err, 1, "on_error callback fired");
assert_eq(streq(bayan_json_last_error(), ""), 0, "error mirrored to last_error");

# Convenience Str entry; a subsequent success clears the legacy last-error slots.
_strm_reset();
assert_eq(bayan_json_stream_parse_str(str_from("[10, 20]"), sh), 0, "parse_str ok after error");
assert_eq(_strm_int, 2, "2 ints from parse_str");
assert_eq(_strm_acc, 30, "parse_str int sum = 30");
assert_eq(streq(bayan_json_last_error(), ""), 1, "last_error cleared after success");
assert_eq(bayan_json_stream_parse_str(0, sh), 0 - 1, "null Str returns -1");

# Build an n-deep nested-array doc: n `[` then n `]` (NUL-terminated cstr).
fn _mk_nested(n): i64 {
    var buf = alloc(n * 2 + 1);
    var i = 0;
    while (i < n)     { store8(buf + i, 91); i = i + 1; }
    while (i < n * 2) { store8(buf + i, 93); i = i + 1; }
    store8(buf + n * 2, 0);
    return buf;
}

test_group("json recursion-depth cap — 128, serde_json parity");
# Deep untrusted input must fail the parse through the normal error path, not
# out-recurse the thread stack. Cap is 128 (serde_json's default) so Rust →
# Cyrius ports keep wire parity. See
# docs/development/issues/2026-07-16-agnosai-json-no-recursion-depth-cap.md.
var jd_deep = _mk_nested(200);
var jd_ok   = _mk_nested(100);
var psd[48];
assert_eq(bayan_json_v_parse_ctx(&psd, jd_deep, strlen(jd_deep)), 0, "value: 200-deep rejected");
assert_eq(streq(bayan_json_state_error(&psd), "nesting too deep"), 1, "value: depth error recorded");
var psk[48];
var jd_v = bayan_json_v_parse_ctx(&psk, jd_ok, strlen(jd_ok));
assert_eq(jd_v != 0, 1, "value: 100-deep parses");
assert_eq(streq(bayan_json_state_error(&psk), ""), 1, "value: no error at 100-deep");

# Exact boundary: 128 open containers parse; the 129th fails.
var psl[48]; var psm[48];
var jd_at   = _mk_nested(128);
var jd_over = _mk_nested(129);
assert_eq(bayan_json_v_parse_ctx(&psl, jd_at, strlen(jd_at)) != 0, 1, "value: 128-deep (at cap) parses");
assert_eq(bayan_json_v_parse_ctx(&psm, jd_over, strlen(jd_over)), 0, "value: 129-deep (past cap) rejected");

# Legacy value entry inherits the cap; error mirrors into last_error.
assert_eq(bayan_json_v_parse_buf(jd_deep, strlen(jd_deep)), 0, "v_parse_str: 200-deep rejected");
assert_eq(streq(bayan_json_last_error(), "nesting too deep"), 1, "v_parse_str: depth error mirrored");

# Streaming parser: same bound; fails via on_error + mirrored last_error.
_strm_reset();
assert_eq(bayan_json_stream_parse(jd_deep, strlen(jd_deep), sh), 0 - 1, "stream: 200-deep rejected");
assert_eq(_strm_err, 1, "stream: on_error fired for depth");
assert_eq(streq(bayan_json_last_error(), "nesting too deep"), 1, "stream: depth error mirrored");
_strm_reset();
assert_eq(bayan_json_stream_parse(jd_ok, strlen(jd_ok), sh), 0, "stream: 100-deep parses");
assert_eq(_strm_arr, 100, "stream: 100 array-start events");

# _compat aliases forward to the capped parsers (alias parity).
assert_eq(json_v_parse_buf(jd_deep, strlen(jd_deep)), 0, "alias json_v_parse_buf: rejected");
_strm_reset();
assert_eq(json_stream_parse(jd_deep, strlen(jd_deep), sh), 0 - 1, "alias json_stream_parse: rejected");

test_group("toml: triple-quoted strings — \"\"\" (basic) + ''' (literal)");
# Regression guard for the """-drops-body bug: a """...""" value used to fall
# through to the single-line `"` branch and parse to "" (body silently lost).
# One optional leading newline after the opening delimiter is skipped.
#
# 1.5.3 changed two expectations in this block, and both were bayan being
# WRONG, not the test being rewritten to match new code. Checked against
# Python `tomllib`, which is the oracle for every value below:
#   * `mk` ends its first line with a backslash — the multi-line line-ending
#     backslash, which trims the newline and the next line's indent. bayan
#     used to keep all of it, so the value carried a stray `\` and a newline.
#   * `lit` used to lose its TRAILING newline. The spec trims the newline
#     AFTER the opening delimiter and says nothing about the one before the
#     closer, so `'''\nraw$stuff\n'''` is `raw$stuff\n`. bayan trimmed it
#     anyway, silently dropping a byte from every such value.
var tdoc = "title = \"cfg\"\nmk = \"\"\"\ncargo build \\\n  --release\n\"\"\"\nlit = '''\nraw$stuff\n'''\nafter = \"tail\"\nq = \"\"\"a\"b\"c\"\"\"\ne = \"\"\n";
var tsecs = bayan_toml_parse(str_from(tdoc));
assert_eq(vec_len(tsecs) >= 1, 1, "toml: parsed a section");
var tp = bayan_toml_section_pairs(vec_get(tsecs, 0));
var mk = bayan_toml_get(tp, "mk");
assert_eq(mk != 0, 1, "toml: \"\"\" key present");
assert_eq(str_len(mk) > 0, 1, "toml: \"\"\" body not dropped (the fix)");
assert_eq(str_eq_cstr(mk, "cargo build --release\n"), 1, "toml: \"\"\" line-ending backslash folds the newline + indent (1.5.3)");
assert_eq(str_eq_cstr(bayan_toml_get(tp, "lit"), "raw$stuff\n"), 1, "toml: ''' body verbatim INCLUDING the trailing newline (1.5.3)");
assert_eq(str_eq_cstr(bayan_toml_get(tp, "title"), "cfg"), 1, "toml: single-line \" before a triple");
assert_eq(str_eq_cstr(bayan_toml_get(tp, "after"), "tail"), 1, "toml: key after a triple parses");
assert_eq(str_eq_cstr(bayan_toml_get(tp, "q"), "a\"b\"c"), 1, "toml: embedded \" inside \"\"\" preserved");
var ev = bayan_toml_get(tp, "e");
assert_eq(ev != 0, 1, "toml: empty-string key present");
assert_eq(str_len(ev), 0, "toml: \"\" stays empty single-line, not mis-read as triple");

test_group("toml: basic-string escapes are DECODED (1.5.3 — mneme 2026-08-22)");
# Every expected value below is Python `tomllib`'s answer for the same
# document, generated rather than hand-derived — the same oracle discipline
# tests/vectors.tcyr uses. Before 1.5.3 each came back with its backslashes
# intact, which is a WRONG ANSWER and not a documented subset limit:
# nothing on bayan_toml_parse or bayan_toml_get said so, and a value with no
# escapes round-tripped perfectly, so the gap only showed once a user typed
# a quote.
var e3doc = "q = \"say \\\"hi\\\"\"\nbs = \"C:\\\\tmp\"\ntb = \"a\\tb\"\nnl = \"a\\nb\"\ncr = \"a\\rb\"\nff = \"a\\fb\"\nbp = \"a\\bb\"\nu4 = \"\\u00e9!\"\nu8 = \"\\U0001F600!\"\n";
var e3s = bayan_toml_parse(str_from(e3doc));
var e3p = bayan_toml_section_pairs(vec_get(e3s, 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "q"), "say \"hi\""), 1, "toml: escaped quote");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "bs"), "C:\\tmp"), 1, "toml: escaped backslash");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "tb"), "a\tb"), 1, "toml: tab escape");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "nl"), "a\nb"), 1, "toml: newline escape");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "cr"), "a\rb"), 1, "toml: carriage-return escape");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "ff"), "a\fb"), 1, "toml: form-feed escape");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "bp"), "a\bb"), 1, "toml: backspace escape");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "u4"), "\xC3\xA9!"), 1, "toml: 4-hex escape -> UTF-8 e-acute");
assert_eq(str_eq_cstr(bayan_toml_get(e3p, "u8"), "\xF0\x9F\x98\x80!"), 1, "toml: 8-hex escape -> UTF-8 astral (TOML-only form)");

# TOML has no `\/` escape (JSON does), and tomllib REJECTS a document
# containing one — so this expectation is bayan POLICY, stated here, not an
# oracle value. bayan has no error channel in this parser, so an unknown
# escape is preserved VERBATIM rather than deleted: a caller can still see
# what was written, and a mis-escaped path is a recoverable annoyance
# instead of silent data loss.
var e3sl = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\/b\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3sl, "x"), "a\\/b"), 1, "toml: unknown escape preserved verbatim");

# Degenerate escapes. None may read out of bounds, emit invalid UTF-8, or
# lose the rest of the value — a lone surrogate in particular must never
# reach _toml_emit_utf8, which would encode it as valid-looking CESU-8.
var e3h1 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\uZZZZb\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3h1, "x"), "a\\uZZZZb"), 1, "toml: bad hex digits");
var e3h2 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\u00\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3h2, "x"), "a\\u00"), 1, "toml: too few hex digits before the closing quote");
var e3h3 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\ud800b\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3h3, "x"), "a\\ud800b"), 1, "toml: lone surrogate is never encoded");
var e3h4 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\U0011FFFFb\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3h4, "x"), "a\\U0011FFFFb"), 1, "toml: codepoint past U+10FFFF");
var e3h5 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\\\\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3h5, "x"), "a\\"), 1, "toml: trailing escaped backslash is a real escape");
var e3h6 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"a\\\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(e3h6, "x"), ""), 1, "toml: a lone trailing backslash leaves the string unterminated");

test_group("toml: single-line LITERAL strings '...' (1.5.3)");
# There was no '...' branch at all before 1.5.3: a literal string fell
# through to the "unquoted value, read to end of line" arm and came back
# WITH ITS QUOTES. `'hello'` was 7 bytes where the spec says 5, and
# `'C:\tmp'` — the form literal strings exist FOR — was wrong twice over.
# A literal string has no escapes, so nothing here is decoded.
var l3doc = "a = 'C:\\tmp'\nb = 'hello'\nc = ''\nd = 'say \"hi\"'\ne = 'tail'\n";
var l3p = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from(l3doc)), 0));
assert_eq(str_eq_cstr(bayan_toml_get(l3p, "a"), "C:\\tmp"), 1, "toml: a backslash in '...' is an ordinary byte");
assert_eq(str_eq_cstr(bayan_toml_get(l3p, "b"), "hello"), 1, "toml: quotes are stripped, body kept");
assert_eq(str_eq_cstr(bayan_toml_get(l3p, "c"), ""), 1, "toml: '' is empty, not two bytes");
assert_eq(str_eq_cstr(bayan_toml_get(l3p, "d"), "say \"hi\""), 1, "toml: a double quote inside '...' is an ordinary byte");
assert_eq(str_eq_cstr(bayan_toml_get(l3p, "e"), "tail"), 1, "toml: the key after a literal string still parses");
assert_eq(str_len(bayan_toml_get(l3p, "c")), 0, "toml: '' has length 0");

test_group("toml: multi-line string conformance (1.5.3)");
# Four separate defects, each measured against `tomllib`:
#  a — an escaped quote next to the closer made the delimiter scan stop ONE
#      BYTE EARLY, so the value lost its final character. That is a DROPPED
#      character, not merely an undecoded one (mneme repro 2).
#  b/c — TOML lets a body end in one or two delimiter chars unescaped; the
#      closer is the LAST three of the run. bayan took the first three.
#  d — the newline BEFORE the closer is part of the string. bayan trimmed
#      it, dropping a byte from every such value ever parsed.
#  f — the line-ending backslash (trim the newline and the next line's
#      indent) was not implemented, so the backslash survived into the value.
var m3doc = "a = \"\"\"he said \\\"hi\\\"\"\"\"\nb = \"\"\"he said \"hi\"\"\"\"\nc = '''a''''\nd = \"\"\"\nline1\n\"\"\"\ne = \"\"\"\nline1\"\"\"\nf = \"\"\"\\\n     foo \\\n     bar\"\"\"\ng = \"\"\"\"\"\"\nh = '''raw \\n stays'''\n";
var m3p = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from(m3doc)), 0));
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "a"), "he said \"hi\""), 1, "toml: escaped quote adjacent to the closer (mneme repro 2)");
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "b"), "he said \"hi\""), 1, "toml: the closer is the LAST three of a quote run");
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "c"), "a'"), 1, "toml: the same run rule applies to '''");
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "d"), "line1\n"), 1, "toml: a trailing newline is part of the value");
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "e"), "line1"), 1, "toml: ...and absent when the source has none");
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "f"), "foo bar"), 1, "toml: the line-ending backslash folds newline + indent");
assert_eq(str_eq_cstr(bayan_toml_get(m3p, "h"), "raw \\n stays"), 1, "toml: a ''' body is verbatim — literals decode nothing");
assert_eq(str_len(bayan_toml_get(m3p, "g")), 0, "toml: an empty multi-line string is empty");
# Case `a` above does NOT actually isolate the delimiter scan's backslash rule:
# with the rule removed, the last-3-of-the-run rule lands on the same body by
# coincidence and the value still comes out right. Mutation testing found that;
# this is the shape where the two cannot mask each other. Without the backslash
# rule the scan sees the escaped quote plus the two raw ones as a closing run
# and the body stops at `a\`, which the run rule cannot rescue.
var m3b = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"\"\"a\\\"\"\"b\"\"\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(m3b, "x"), "a\"\"\"b"), 1, "toml: an escaped quote before two raw ones is not a closing run");
# CRLF after the opening delimiter is trimmed as a UNIT (1.5.3). A file
# written on Windows used to keep a stray leading CR in every """ value.
var m3c = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"\"\"\r\nline1\"\"\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(m3c, "x"), "line1"), 1, "toml: CRLF after the opening delimiter is trimmed");
# A raw CRLF INSIDE the body normalises to LF — a different code path from the
# opening-delimiter trim above, and a deliberate choice: TOML lets a parser
# normalise newlines, and every mainstream implementation does. An ESCAPED \r
# is NOT normalised, because the author asked for that byte by name.
var m3n = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = \"\"\"a\r\nb\"\"\"\ny = \"\"\"a\\r\\nb\"\"\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(m3n, "x"), "a\nb"), 1, "toml: a raw CRLF in a multi-line body normalises to LF");
assert_eq(str_eq_cstr(bayan_toml_get(m3n, "y"), "a\r\nb"), 1, "toml: an ESCAPED \\r survives normalisation");

# 1.5.1 stopped an unterminated string swallowing the next line; the
# BACKSLASH-ESCAPED newline was the hole left in that rule, because the scan
# stepped over "the escaped byte" without looking at it. That is the exact
# shape 1.5.1 called the worst one this can take: a malformed line silently
# removing a security-relevant key two lines later.
var xn = bayan_toml_parse(str_from("a = \"oops\\\nadmin = false\nb = \"x\"\nc = 1\n"));
var xnp = bayan_toml_section_pairs(vec_get(xn, 0));
assert_eq(bayan_toml_get(xnp, "admin") != 0, 1, "toml: an escaped newline does not delete the next key");
assert_eq(str_eq_cstr(bayan_toml_get(xnp, "c"), "1"), 1, "toml: parsing resynchronises after it");
# _toml_parse_str and _toml_str_end BOTH have to stop at the escaped newline,
# and the document above cannot tell them apart: with the guard removed from
# _toml_parse_str alone, the scan crosses one line and is then stopped by the
# NEXT newline, so the value comes out empty either way and every assertion
# stays green. Mutation testing surfaced that. This document puts a closing
# quote on the following line, which is the only shape where the value the
# scan returns differs — `oops` + newline + `zzz` if the guard is gone,
# nothing if it holds.
var xn2 = bayan_toml_parse(str_from("a = \"oops\\\nzzz\"\nadmin = false\nc = 1\n"));
var xn2p = bayan_toml_section_pairs(vec_get(xn2, 0));
assert_eq(str_len(bayan_toml_get(xn2p, "a")), 0, "toml: an escaped newline leaves the value unterminated, not spliced");
assert_eq(str_eq_cstr(bayan_toml_get(xn2p, "c"), "1"), 1, "toml: and the keys after it still parse");

test_group("toml: array elements follow the same escape rules (1.5.3)");
# The issue named bayan_toml_get_array among the affected entry points, so
# the element splitter decodes a basic-quoted element and leaves a
# literal-quoted one verbatim, exactly as the scalar parsers do.
var a3p = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("xs = [\"a\\\"b\", 'c\\d', \"plain\"]\n")), 0));
var a3 = bayan_toml_get_array(a3p, "xs");
assert_eq(vec_len(a3), 3, "toml: the array splits into 3 elements");
# Three separate loops track quote state over an array — the VALUE capture in
# bayan_toml_parse, the element splitter, and the content-end walk in
# _toml_arr_flush_a — and all three needed the escaped-quote rule. The splitter
# and the walk are covered by the element assertions below; the CAPTURE is only
# visible from outside when the value runs past its own `]`, because a `"` read
# as closing leaves the real `]` "inside a string", depth never returns to 0,
# and the capture eats the rest of the document. So the guard is that the NEXT
# KEY still exists. (Found by mutation testing: without this, reverting the
# capture fix alone left the whole suite green.)
var a3c = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("xs = [\"a\\\"b\"]\nafter = \"tail\"\nn = 7\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(a3c, "after"), "tail"), 1, "toml: an escaped quote in an array does not swallow the next key");
assert_eq(str_eq_cstr(bayan_toml_get(a3c, "n"), "7"), 1, "toml: ...or the one after that");
assert_eq(str_eq_cstr(vec_get(a3, 0), "a\"b"), 1, "toml: a basic element is decoded");
assert_eq(str_eq_cstr(vec_get(a3, 1), "c\\d"), 1, "toml: a literal element is verbatim");
assert_eq(str_eq_cstr(vec_get(a3, 2), "plain"), 1, "toml: an escape-free element is unchanged");

test_group("toml: bayan_toml_escape / bayan_toml_unescape (1.5.3)");
# The other half of the mneme report. Values from bayan_toml_get are now
# decoded, but a consumer WRITING TOML still needs the escaping direction.
# mneme hand-rolled both (`_cfg_toml_esc` / `_cfg_toml_unesc`) after finding
# it was emitting malformed TOML whenever a vault name held a quote —
# reading it back through bayan cancelled the error out, so the round trip
# looked correct while the file on disk was invalid. Shipping both halves is
# what makes that hand-roll deletable.
var esc_in = "say \"hi\"\\\ttab\nnl";
var esc_out = bayan_toml_escape(str_from(esc_in));
assert_eq(str_eq_cstr(esc_out, "say \\\"hi\\\"\\\\\\ttab\\nnl"), 1, "toml: escape produces a TOML basic-string body");
# The round trip is the assertion mneme actually needs to hold: escape ->
# wrap in quotes -> parse -> the original bytes back.
var rt_sb = str_builder_new();
str_builder_add(rt_sb, str_from("k = \""));
str_builder_add(rt_sb, esc_out);
str_builder_add(rt_sb, str_from("\"\n"));
var rt_p = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_builder_build(rt_sb)), 0));
assert_eq(str_eq_cstr(bayan_toml_get(rt_p, "k"), esc_in), 1, "toml: escape -> parse round-trips to the original bytes");
# Python agrees the escaped form is valid TOML carrying the same value;
# the generator for this file asserted it before writing the line.
# C0 controls and DEL take the 4-hex form.
assert_eq(str_eq_cstr(bayan_toml_escape(str_from("a\x01b\x7Fc")), "a\\u0001b\\u007Fc"), 1, "toml: escape emits a 4-hex escape for C0 and DEL");
# Bytes >= 128 pass through: a UTF-8 sequence must not be split per byte.
assert_eq(str_eq_cstr(bayan_toml_escape(str_from("\xC3\xA9")), "\xC3\xA9"), 1, "toml: escape leaves UTF-8 alone");
assert_eq(str_len(bayan_toml_escape(str_from(""))), 0, "toml: escape of the empty string is empty");
# `\\c` is an ESCAPED BACKSLASH followed by `c`, so the decoded tail is
# `\c` and not `c` — the expected value here is tomllib's, after the
# hand-written one got it wrong and this assertion caught it.
assert_eq(str_eq_cstr(bayan_toml_unescape(str_from("a\\tb\\u00e9\\\\c")), "a\tb\xC3\xA9\\c"), 1, "toml: unescape is the inverse");
assert_eq(str_len(bayan_toml_unescape(str_from(""))), 0, "toml: unescape of the empty string is empty");
# The _a twins thread an allocator and must agree byte for byte.
var esc_ar = arena_allocator(4096);
assert_eq(str_eq(bayan_toml_escape_a(esc_ar, str_from(esc_in)), esc_out), 1, "toml: escape_a matches escape");
assert_eq(str_eq(bayan_toml_unescape_a(esc_ar, esc_out), str_from(esc_in)), 1, "toml: unescape_a matches unescape");

# Decoding needs a destination, so a value carrying a backslash is now a
# COPY. A value WITHOUT one must still be a zero-copy VIEW into the source —
# that is the property the whole module is built on, and a decode step added
# carelessly would have silently ended it for every string in every file.
var zc_src = str_from("plain = \"nothing to decode\"\nesc = \"has \\\"one\\\"\"\n");
var zc_p = bayan_toml_section_pairs(vec_get(bayan_toml_parse(zc_src), 0));
var zc_lo = str_data(zc_src);
var zc_hi = zc_lo + str_len(zc_src);
var zc_v = str_data(bayan_toml_get(zc_p, "plain"));
assert_eq((zc_v >= zc_lo) && (zc_v < zc_hi), 1, "toml: an escape-free value is still a view into the source");
var zc_e = str_data(bayan_toml_get(zc_p, "esc"));
assert_eq((zc_e >= zc_lo) && (zc_e < zc_hi), 0, "toml: a decoded value is a fresh copy, not a view");

test_group("toml: the value arms return the VALUE and nothing else (1.5.3)");
# Four silent wrong answers found by an adversarial review of the 1.5.3 escape
# work, all in the most ordinary lines a TOML file contains. Each expectation
# is Python `tomllib`'s, except where noted.

# 1. A comment may follow a value on the same line. The unquoted arm read to
#    the newline, so `port = 8080 # default` was the 14-byte string
#    `8080 # default`. A consumer converting that to an integer got a
#    different number.
var vc1 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("port = 8080 # default\nname = 5#c\nk = \"a # b\"\na = [1, 2] # c\nz = 9\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(vc1, "port"), "8080"), 1, "toml: an inline comment is not part of the value");
assert_eq(str_eq_cstr(bayan_toml_get(vc1, "name"), "5"), 1, "toml: ...with or without a space before the #");
assert_eq(str_eq_cstr(bayan_toml_get(vc1, "k"), "a # b"), 1, "toml: a # INSIDE a string is an ordinary byte");
assert_eq(str_eq_cstr(bayan_toml_get(vc1, "a"), "[1, 2]"), 1, "toml: a # after an array value is not captured");
assert_eq(str_eq_cstr(bayan_toml_get(vc1, "z"), "9"), 1, "toml: and the following keys still parse");

# 2. CRLF. The trailing-trim removed SPACES only, so every unquoted value in a
#    file written on Windows carried a stray CR — invisible when printed and
#    unequal to the obvious literal. Tabs were never trimmed either.
var vc2 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("flag = true\r\nport = 80\r\nn = 5\t\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(vc2, "flag"), "true"), 1, "toml: a CRLF line ending leaves no CR on the value");
assert_eq(str_eq_cstr(bayan_toml_get(vc2, "port"), "80"), 1, "toml: ...on any of them");
assert_eq(str_eq_cstr(bayan_toml_get(vc2, "n"), "5"), 1, "toml: a trailing tab is trimmed too");

# 3. A line beginning with `=` pushed a pair with a ZERO-LENGTH key that every
#    later lookup had to walk past. tomllib rejects the document; bayan has no
#    error channel, so it degrades to "no pair", which is what it already does
#    for every other malformed line.
var vc3 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("= 5\nk = 1\n")), 0));
assert_eq(vec_len(vc3), 1, "toml: a keyless `= value` line produces no pair");
assert_eq(str_eq_cstr(bayan_toml_get(vc3, "k"), "1"), 1, "toml: and the real key is unaffected");

# 4. Document-swallowing, the shape 1.5.1 called the worst one this can take.
#    Two scanners that fix did not reach: the array capture (a quote opened
#    inside `[` ran to the end of the FILE) and the table-header name scan (an
#    unclosed `[abc` made every following line part of the section name).
var vc4 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("a = [\"oops\nadmin = false\nb = 1\n")), 0));
assert_eq(bayan_toml_get(vc4, "admin") != 0, 1, "toml: an unterminated quote in an array does not delete the next key");
assert_eq(str_eq_cstr(bayan_toml_get(vc4, "b"), "1"), 1, "toml: ...nor the one after that");
# sections[0] is the ROOT table as of 1.5.4 — always present, even empty — so
# a header is at index 1. Before that, a file opening with `[a]` made
# sections[0] the section `a`, and a consumer reading sections[0] as "the root
# pairs" silently got `a`'s.
var vc5 = bayan_toml_parse(str_from("[abc\nx = 1\ny = 2\n"));
assert_eq(str_len(bayan_toml_section_name(vec_get(vc5, 0))), 0, "toml: sections[0] is the root table, not the first header");
var vc5p = bayan_toml_section_pairs(vec_get(vc5, 1));
assert_eq(str_eq_cstr(bayan_toml_section_name(vec_get(vc5, 1)), "abc"), 1, "toml: an unclosed [header stops at the newline");
assert_eq(vec_len(vc5p), 2, "toml: and does not swallow the keys under it");
var vc6 = bayan_toml_parse(str_from("[[abc\nx = 1\n"));
assert_eq(str_eq_cstr(bayan_toml_section_name(vec_get(vc6, 1)), "abc"), 1, "toml: same bound on the [[header]] branch");
assert_eq(vec_len(bayan_toml_section_pairs(vec_get(vc6, 1))), 1, "toml: and its key survives");

# 5. An EMPTY file is a legal TOML document with no pairs. Reporting it as
#    Err(TomlIoErr) made it indistinguishable from a file that does not exist,
#    which is the one distinction this Result variant exists to draw.
var vc7 = bayan_toml_parse_file_r("tests/fixtures/toml/empty.toml");
assert_eq(is_err_result(vc7), 0, "toml: parse_file_r reads an empty file as a legal empty document");
assert_eq(vec_len(load64(vc7 + 8)), 0, "toml: with zero sections");
assert_eq(is_err_result(bayan_toml_parse_file_r("tests/fixtures/toml/does-not-exist.toml")), 1,
  "toml: while a MISSING file is still an error — the two are distinguishable again");

test_group("toml: the 1.5.3 value-arm fixes did not break the values they pass over");
# Both guards below are for regressions this release INTRODUCED and an
# adversarial review of the finished work caught before it shipped. They are
# the cases where a narrowly-correct rule was applied one branch too widely.

# The inline-comment break has to be QUOTE-AWARE. The first cut said "a # cannot
# occur inside an unquoted value (they are numbers, booleans and dates)" and
# broke unconditionally — but bayan has no `{` branch, so an INLINE TABLE lands
# in that arm too, and it is the one unquoted value carrying arbitrary string
# bytes. `srv = { host = "a#b" }` truncated to `{ host = "a`.
var ic = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("srv = { host = \"a#b\", port = 1 }\nlt = { p = 'x#y' }\nafter = 9\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(ic, "srv"), "{ host = \"a#b\", port = 1 }"), 1, "toml: a # inside a quoted string in an inline table is not a comment");
assert_eq(str_eq_cstr(bayan_toml_get(ic, "lt"), "{ p = 'x#y' }"), 1, "toml: ...in a literal-quoted one either");
assert_eq(str_eq_cstr(bayan_toml_get(ic, "after"), "9"), 1, "toml: and the following key is unaffected");

# The array capture's newline rule has to know about TRIPLE quotes. The
# single-quote state machine toggles three times across `"""`, so it believed
# it was inside a string for the whole multi-line body and fired the
# unterminated-string break on the element's OWN first newline.
#
# The third assertion is the one that matters most. Truncating the array left
# the parser resuming inside the string body, which it then read as ordinary
# TOML — so a `[boom]` written INSIDE A STRING became a real section and the
# keys after it were relocated into it. String content becoming document
# structure is the worst outcome available to a config parser, and it is a
# far more dangerous shape than the swallowing bug the newline rule was added
# to fix. Expected values are tomllib's.
var ml1 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = [\"\"\"\na\"\"\"]\nzz = \"s\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(ml1, "x"), "[\"\"\"\na\"\"\"]"), 1, "toml: an array holding a multi-line string is captured WHOLE");
assert_eq(str_eq_cstr(bayan_toml_get(ml1, "zz"), "s"), 1, "toml: and the key after it survives");
var ml2 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("x = ['''\na=''', \"b\"]\nzz = \"s\"\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(ml2, "zz"), "s"), 1, "toml: same for a ''' element containing a `=`");
var forge = bayan_toml_parse(str_from("files = [\"\"\"\n[boom]\nevil = 1\n\"\"\"]\nreal = \"yes\"\n\n[app]\nname = \"x\"\n"));
assert_eq(vec_len(forge), 2, "toml: a [header] inside a string does NOT forge a section");
var f0 = bayan_toml_section_pairs(vec_get(forge, 0));
assert_eq(str_eq_cstr(bayan_toml_get(f0, "real"), "yes"), 1, "toml: the root key stays in the root table");
assert_eq(str_eq_cstr(bayan_toml_section_name(vec_get(forge, 1)), "app"), 1, "toml: and the real section is still the second one");
assert_eq(bayan_toml_get(f0, "evil"), 0, "toml: nothing from inside the string leaked out as a pair");

# The newline rule it replaced must still do its job: a SINGLE-quoted element
# left open still stops at the newline rather than eating the document.
var ut = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("a = [\"oops\nadmin = false\nb = 1\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(ut, "admin"), "false"), 1, "toml: an unterminated single quote in an array still stops at the newline");
# And ordinary arrays are untouched by the triple-quote tracking.
var oa = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("n = [1, 2, 3] # c\ns = [\"a\", 'b]c']\ne = [\"\"\"\"\"\", 1]\nzz = 4\n")), 0));
assert_eq(vec_len(bayan_toml_get_array(oa, "n")), 3, "toml: a plain array still splits into 3");
assert_eq(str_eq_cstr(vec_get(bayan_toml_get_array(oa, "s"), 1), "b]c"), 1, "toml: a ] inside a literal element is still preserved");
assert_eq(str_eq_cstr(bayan_toml_get(oa, "zz"), "4"), 1, "toml: an empty multi-line element does not derail the capture");

test_group("cyml: both fixed read caps are gone (1.5.4)");
# src/cyml.cyr carried the project's last two fixed read buffers, and both
# truncated SILENTLY and reported success — the shape 1.5.1 removed from toml's
# loader after it lost 1,893 keys from a 300 KB file.
#
#   * bayan_cyml_parse_file_r stopped at 262,144 bytes and still returned
#     Ok(...), with the cut landing mid-line.
#   * _cyml_read_file_trimmed declared `var buf[4096]` and cut a
#     `${file:PATH}` expansion at 4,095 bytes — in the one path whose whole job
#     is to substitute a file's contents verbatim.
#
# Both now slurp into a growing str_builder. build/ is gitignored.
var cyb_sb = str_builder_new();
str_builder_add_cstr(cyb_sb, "title = \"big\"\n");
var cyb_i = 0;
while (cyb_i < 25000) {
    str_builder_add_cstr(cyb_sb, "k");
    str_builder_add_int(cyb_sb, cyb_i);
    str_builder_add_cstr(cyb_sb, " = ");
    str_builder_add_int(cyb_sb, cyb_i);
    str_builder_putc(cyb_sb, 10);
    cyb_i = cyb_i + 1;
}
str_builder_add_cstr(cyb_sb, "---\nbody text\n");
var cyb_big = str_builder_build(cyb_sb);
assert_gt(str_len(cyb_big), 262144, "cyml: the fixture exceeds the old 256 KiB cap");
file_write_all("build/big-generated.cyml", str_data(cyb_big), str_len(cyb_big));
var cyb_r = bayan_cyml_parse_file_r("build/big-generated.cyml");
assert_eq(is_err_result(cyb_r), 0, "cyml: parse_file_r reads a file past the old cap");
var cyb_doc = load64(cyb_r + 8);
var cyb_e0 = bayan_cyml_doc_entry(cyb_doc, 0);
assert_neq(cyb_e0, 0, "cyml: it parses to one entry");
# A truncated read would cut the header short, so the `---` delimiter and
# everything after it would simply not exist.
assert_gt(bayan_cyml_entry_header_len(cyb_e0), 262144,
  "cyml: the WHOLE header survived, not 256 KiB of it");
assert_gt(bayan_cyml_entry_body_len(cyb_e0), 0,
  "cyml: and the body past the old cap is still found");

# An EMPTY file is a legal document, not Err — the same correction toml's
# loader got at 1.5.3. Reporting it as Err made it indistinguishable from a
# file that does not exist, the one distinction this variant exists to draw.
file_write_all("build/empty-generated.cyml", str_data(str_from("x")), 0);
var cyb_e = bayan_cyml_parse_file_r("build/empty-generated.cyml");
assert_eq(is_err_result(cyb_e), 0, "cyml: an empty file is a legal empty document");
assert_eq(is_err_result(bayan_cyml_parse_file_r("build/does-not-exist.cyml")), 1,
  "cyml: while a MISSING file is still an error — the two are distinguishable");

# ${file:PATH} expansion past the old 4 KiB buffer.
var cyb_fb = str_builder_new();
var cyb_j = 0;
while (cyb_j < 900) {
    str_builder_add_cstr(cyb_fb, "0123456789");
    cyb_j = cyb_j + 1;
}
var cyb_fill = str_builder_build(cyb_fb);
assert_gt(str_len(cyb_fill), 4096, "cyml: the expansion fixture exceeds the old 4 KiB buffer");
file_write_all("build/big-expand.txt", str_data(cyb_fill), str_len(cyb_fill));
var cyb_exp = bayan_cyml_expand_value("${file:build/big-expand.txt}");
assert_eq(strlen(cyb_exp), str_len(cyb_fill),
  "cyml: a ${file:...} expansion past 4 KiB is substituted WHOLE, not truncated");

test_group("toml: quoted keys (1.5.4)");
# `"key one" = 1` was DROPPED ENTIRELY before 1.5.4: the key scan stopped at
# the space inside the quotes, the next byte was not `=`, and the test for it
# has no `else`. `"key" = 2` survived but kept its quotes, so every lookup
# missed. A `"` key is decoded like a basic string; a `'` key is verbatim.
var q4 = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("\"key one\" = 1\n\"key\" = 2\n'lit key' = 3\n\"esc\\tkey\" = 4\nplain = 5\n")), 0));
assert_eq(vec_len(q4), 5, "toml: all five keys parse");
assert_eq(str_eq_cstr(bayan_toml_get(q4, "key one"), "1"), 1, "toml: a quoted key containing a space");
assert_eq(str_eq_cstr(bayan_toml_get(q4, "key"), "2"), 1, "toml: a quoted key without one loses its quotes");
assert_eq(str_eq_cstr(bayan_toml_get(q4, "lit key"), "3"), 1, "toml: a literal-quoted key");
assert_eq(str_eq_cstr(bayan_toml_get(q4, "esc\tkey"), "4"), 1, "toml: escapes in a quoted key are decoded");
assert_eq(str_eq_cstr(bayan_toml_get(q4, "plain"), "5"), 1, "toml: and a bare key still works");

test_group("toml: dotted keys name a table (1.5.4)");
# `a.b.c = 1` now lands in section `a.b` as key `c` — identical to what
# `[a.b]` + `c = 1` has always produced, so the two spellings finally agree.
# The spaced form `a . b = 2` used to be DISCARDED ENTIRELY, for the same
# reason quoted keys were. Inside `[t]`, `a.b = 1` lands in `t.a`.
var dk = bayan_toml_parse(str_from("a.b.c = 1\na . b = 2\nd = 3\n"));
assert_eq(str_len(bayan_toml_section_name(vec_get(dk, 0))), 0, "toml: sections[0] is the root");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(dk, 0)), "d"), "3"), 1, "toml: an undotted key stays in the root");
var dk_ab = bayan_toml_get_sections(dk, "a.b");
assert_eq(vec_len(dk_ab), 1, "toml: a.b.c created the table a.b");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(dk_ab, 0)), "c"), "1"), 1, "toml: with c as its key");
var dk_a = bayan_toml_get_sections(dk, "a");
assert_eq(vec_len(dk_a), 1, "toml: the spaced form a . b = 2 is no longer discarded");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(dk_a, 0)), "b"), "2"), 1, "toml: and names the table a with key b");
# Under a header the dotted table is nested beneath it.
var dk2 = bayan_toml_parse(str_from("[t]\na.b = 1\nx = 2\n"));
assert_eq(vec_len(bayan_toml_get_sections(dk2, "t.a")), 1, "toml: `a.b = 1` inside [t] names t.a");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(bayan_toml_get_sections(dk2, "t.a"), 0)), "b"), "1"), 1, "toml: with b as its key");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(bayan_toml_get_sections(dk2, "t"), 0)), "x"), "2"), 1, "toml: and [t]'s own key is unaffected");
# A quoted segment inside a dotted path is unquoted before joining.
var dk3 = bayan_toml_parse(str_from("a.\"b c\".d = 9\n"));
assert_eq(vec_len(bayan_toml_get_sections(dk3, "a.b c")), 1, "toml: a quoted dotted segment is unquoted in the table name");

test_group("toml: inline tables (1.5.4)");
# `k = { a = 1 }` was captured verbatim with no accessor and was not listed
# as a subset limit anywhere a caller reads — so a consumer needing one had
# to hand-roll a splitter, the outcome bayan exists to prevent. Worse, as an
# array element the splitter cut on every comma INSIDE the braces and
# returned four syntactic fragments that look structured and are not.
#
# The keys and values come from the same _toml_scan_key and
# _toml_parse_value_a the top-level parser uses, so escapes, quoted keys and
# nested arrays decode identically inside an inline table and outside one.
var it = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("pts = [ { x = 1, y = 2 }, { x = 3, y = 4 } ]\nsrv = { host = \"a#b\", port = 8080 }\nnest = { a = { b = 2 }, c = [1, 2] }\nzz = 1\n")), 0));
var it_pts = bayan_toml_get_array(it, "pts");
assert_eq(vec_len(it_pts), 2, "toml: an array of inline tables splits on the OUTER commas only");
var it_p1 = bayan_toml_inline_parse(vec_get(it_pts, 1));
assert_eq(vec_len(it_p1), 2, "toml: and each element decomposes into its pairs");
assert_eq(str_eq_cstr(bayan_toml_get(it_p1, "x"), "3"), 1, "toml: pts[1].x == 3");
assert_eq(str_eq_cstr(bayan_toml_get(it_p1, "y"), "4"), 1, "toml: pts[1].y == 4");
var it_srv = bayan_toml_get_inline(it, "srv");
assert_eq(vec_len(it_srv), 2, "toml: get_inline decomposes a scalar inline table");
assert_eq(str_eq_cstr(bayan_toml_get(it_srv, "host"), "a#b"), 1, "toml: a # inside a quoted value is not a comment");
assert_eq(str_eq_cstr(bayan_toml_get(it_srv, "port"), "8080"), 1, "toml: and the bare value after it stops at the comma");
var it_nest = bayan_toml_get_inline(it, "nest");
assert_eq(str_eq_cstr(bayan_toml_get(it_nest, "a"), "{ b = 2 }"), 1, "toml: a nested inline table is kept whole for re-parsing");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_inline_parse(bayan_toml_get(it_nest, "a")), "b"), "2"), 1, "toml: ...and re-parses");
assert_eq(str_eq_cstr(bayan_toml_get(it_nest, "c"), "[1, 2]"), 1, "toml: an array inside an inline table is kept whole");
assert_eq(vec_len(bayan_toml_array_parse(bayan_toml_get(it_nest, "c"))), 2, "toml: ...and splits");
assert_eq(str_eq_cstr(bayan_toml_get(it, "zz"), "1"), 1, "toml: the key after an inline table is unaffected");
assert_eq(bayan_toml_is_inline(bayan_toml_get(it, "srv")), 1, "toml: is_inline sniffs a brace");
assert_eq(bayan_toml_is_inline(bayan_toml_get(it, "zz")), 0, "toml: and a bare value is not one");
assert_eq(bayan_toml_get_inline(it, "nope"), 0, "toml: get_inline on an absent key -> 0");
assert_eq(vec_len(bayan_toml_inline_parse(bayan_toml_get(it, "zz"))), 0, "toml: inline_parse of a non-table -> empty vec");
assert_eq(vec_len(bayan_toml_inline_parse(0)), 0, "toml: inline_parse of 0 -> empty vec");
var it_ar = arena_allocator(16384);
assert_eq(vec_len(bayan_toml_inline_parse_a(it_ar, bayan_toml_get(it, "srv"))), 2, "toml: inline_parse_a threads an arena");

test_group("toml: empty tables and the root table (1.5.4)");
# An empty table used to VANISH, which shifted the index of every later
# [[array-of-table]] entry: three [[s]] blocks with an empty middle one
# returned two sections, so s[1] was the third record. And the root was
# emitted only if it had pairs, so a file opening with `[a]` made
# sections[0] the section `a` — every consumer reading sections[0] as "the
# root pairs" silently got `a`'s, with no way to tell.
var et = bayan_toml_parse(str_from("[a]\n[b]\nx = 1\n"));
assert_eq(vec_len(et), 3, "toml: root + [a] + [b], with [a] empty");
assert_eq(str_len(bayan_toml_section_name(vec_get(et, 0))), 0, "toml: sections[0] is the root even when the file opens with a header");
assert_eq(str_eq_cstr(bayan_toml_section_name(vec_get(et, 1)), "a"), 1, "toml: the empty table is emitted");
assert_eq(vec_len(bayan_toml_section_pairs(vec_get(et, 1))), 0, "toml: with zero pairs");
var aot = bayan_toml_parse(str_from("[[s]]\nname = \"a\"\n[[s]]\n[[s]]\nname = \"c\"\n"));
var aot_s = bayan_toml_get_sections(aot, "s");
assert_eq(vec_len(aot_s), 3, "toml: three [[s]] blocks give THREE sections, empty middle included");
assert_eq(vec_len(bayan_toml_section_pairs(vec_get(aot_s, 1))), 0, "toml: the middle one is empty");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(aot_s, 2)), "name"), "c"), 1, "toml: so s[2] is the THIRD record, not the second");

test_group("toml: duplicate keys take the LAST value (1.5.4)");
# This returned the FIRST match until 1.5.4, which no other TOML
# implementation does. The direction matters: with first-wins,
#     secure = true
#     secure = false
# returned `true` for a file whose last word is `false`. bayan_toml_count
# lets a caller that wants the spec's "duplicate is an error" enforce it,
# since this parser has no error channel to report one through.
var du = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("secure = true\nsecure = false\nsolo = 1\n")), 0));
assert_eq(str_eq_cstr(bayan_toml_get(du, "secure"), "false"), 1, "toml: the LAST value wins");
assert_eq(bayan_toml_count(du, "secure"), 2, "toml: count sees both");
assert_eq(bayan_toml_count(du, "solo"), 1, "toml: and one for a unique key");
assert_eq(bayan_toml_count(du, "absent"), 0, "toml: zero for an absent one");
assert_eq(vec_len(du), 3, "toml: both pairs are still stored");

test_group("toml: the parser records the value KIND (1.5.4)");
# bayan_toml_is_array sniffs the value bytes, by which point the quotes are
# gone — so a STRING whose content starts with `[` classified as an array.
# `format = '[ $host ]($style)'`, an ordinary prompt template, is the case
# that made it concrete. The kind is the parser's own answer and cannot be
# fooled by content; the heuristic is kept, and documented as one.
var vk = bayan_toml_section_pairs(vec_get(bayan_toml_parse(str_from("format = '[ $host ]($style)'\nbas = \"x\"\nml = \"\"\"y\"\"\"\nmll = '''z'''\narr = [1, 2]\ntbl = { a = 1 }\nnum = 42\n")), 0));
assert_eq(bayan_toml_is_array(bayan_toml_get(vk, "format")), 1, "toml: the byte heuristic still says ARRAY for a bracketed string");
assert_eq(bayan_toml_pair_is_array(bayan_toml_get_pair(vk, "format")), 0, "toml: the recorded kind says it is not");
assert_eq(bayan_toml_pair_is_string(bayan_toml_get_pair(vk, "format")), 1, "toml: it says STRING");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "format")), TOML_K_LITERAL, "toml: specifically a literal string");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "bas")), TOML_K_BASIC, "toml: kind BASIC");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "ml")), TOML_K_ML_BASIC, "toml: kind ML_BASIC");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "mll")), TOML_K_ML_LIT, "toml: kind ML_LIT");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "arr")), TOML_K_ARRAY, "toml: kind ARRAY");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "tbl")), TOML_K_INLINE, "toml: kind INLINE");
assert_eq(bayan_toml_pair_kind(bayan_toml_get_pair(vk, "num")), TOML_K_BARE, "toml: kind BARE");
assert_eq(bayan_toml_pair_is_array(bayan_toml_get_pair(vk, "arr")), 1, "toml: pair_is_array on a real array");
assert_eq(bayan_toml_pair_is_inline(bayan_toml_get_pair(vk, "tbl")), 1, "toml: pair_is_inline on a real inline table");
assert_eq(bayan_toml_pair_is_inline(bayan_toml_get_pair(vk, "arr")), 0, "toml: and not on an array");
assert_eq(bayan_toml_get_pair(vk, "absent"), 0, "toml: get_pair on an absent key -> 0");
# A HAND-BUILT pair reports UNKNOWN. A caller supplying only a key and a
# value has not said what form the value took, and a guess would be worse
# than an honest "unknown".
var hp = bayan_toml_pair_new(str_from("k"), str_from("[1]"));
assert_eq(bayan_toml_pair_kind(hp), TOML_K_UNKNOWN, "toml: a hand-built pair is UNKNOWN");
assert_eq(bayan_toml_pair_is_array(hp), 0, "toml: so pair_is_array reports 0, not a guess");
assert_eq(bayan_toml_pair_is_string(hp), 0, "toml: and pair_is_string too");
var kp2 = bayan_toml_pair_new_kind(str_from("k"), str_from("[1]"), TOML_K_ARRAY);
assert_eq(bayan_toml_pair_is_array(kp2), 1, "toml: pair_new_kind records what the caller states");
var kar = arena_allocator(4096);
assert_eq(bayan_toml_pair_kind(bayan_toml_pair_new_kind_a(kar, str_from("k"), str_from("1"), TOML_K_BARE)), TOML_K_BARE, "toml: pair_new_kind_a threads an arena");

test_group("toml: table header names are trimmed and unquoted (1.5.4)");
# `[ a ]` named the section " a ", spaces included, so
# bayan_toml_get_sections("a") silently returned nothing — an empty vec
# rather than an error, which is the worst way to be told.
var hn = bayan_toml_parse(str_from("[ a ]\nx = 1\n[ \"b c\" ]\ny = 2\n[ 'd' ]\nz = 3\n"));
assert_eq(vec_len(bayan_toml_get_sections(hn, "a")), 1, "toml: [ a ] is the section a");
assert_eq(vec_len(bayan_toml_get_sections(hn, "b c")), 1, "toml: [ \"b c\" ] is the section b c, unquoted");
assert_eq(vec_len(bayan_toml_get_sections(hn, "d")), 1, "toml: [ 'd' ] too");
assert_eq(str_eq_cstr(bayan_toml_get(bayan_toml_section_pairs(vec_get(bayan_toml_get_sections(hn, "b c"), 0)), "y"), "2"), 1, "toml: and its pairs are intact");

test_group("toml: no value may escape its source buffer (1.5.3)");
# A property, not an example. bayan_toml_parse hands back Strs that VIEW the
# source, so a scanner that advances one byte too far produces a Str claiming
# bytes the caller does not own — it reads fine locally and faults, or leaks,
# somewhere else entirely.
#
# 1.5.3 shipped exactly that bug for a few hours: the new escaped-quote rule in
# the array capture had no bound, so a document ending in `a = ["x\` advanced
# past the end and the captured value was 5 bytes of a 4-byte remainder. An
# adversarial review of the fix caught it; this is the guard that would have.
#
# Truncating each document at EVERY length is what makes this a real check —
# every scanner in the module gets to run off the end of a buffer that stops
# mid-construct, which is the only place the bound matters.
var oob_docs = vec_new();
vec_push(oob_docs, str_from("a = [\"x\\"));
vec_push(oob_docs, str_from("a = [\"x\\\"y\", 'z'] # c"));
vec_push(oob_docs, str_from("a = \"x\\"));
vec_push(oob_docs, str_from("a = \"\"\"x\\"));
vec_push(oob_docs, str_from("a = '''x"));
vec_push(oob_docs, str_from("[s]\nk = \"v\\\"w\"\nj = '''m'''\n"));
vec_push(oob_docs, str_from("a = \"\"\"\r\nx\\\ny\"\"\"\nb = 1"));
vec_push(oob_docs, str_from("[[t]]\nn = [1, \"a\\\"\", '''q''']\n"));
var oob_bad = 0;
var oob_runs = 0;
var oob_i = 0;
while (oob_i < vec_len(oob_docs)) {
    var oob_full = vec_get(oob_docs, oob_i);
    var oob_cut = 0;
    while (oob_cut <= str_len(oob_full)) {
        var oob_src = str_new(str_data(oob_full), oob_cut);
        var oob_lo = str_data(oob_src);
        var oob_hi = oob_lo + oob_cut;
        var oob_secs = bayan_toml_parse(oob_src);
        var oob_si = 0;
        while (oob_si < vec_len(oob_secs)) {
            var oob_sec = vec_get(oob_secs, oob_si);
            var oob_nm = bayan_toml_section_name(oob_sec);
            if (oob_nm != 0) {
                if (str_len(oob_nm) > 0) {
                    # Same "starts inside" bound as the value check below. A
                    # section NAME is a fresh copy as of 1.5.4 (segments are
                    # trimmed, unquoted and re-joined), so it legitimately sits
                    # outside the source span — only a VIEW can overrun.
                    var oob_ne = str_data(oob_nm) + str_len(oob_nm);
                    if (str_data(oob_nm) >= oob_lo && str_data(oob_nm) < oob_hi && oob_ne > oob_hi) { oob_bad = oob_bad + 1; }
                }
            }
            var oob_pairs = bayan_toml_section_pairs(oob_sec);
            var oob_pi = 0;
            while (oob_pi < vec_len(oob_pairs)) {
                var oob_p = vec_get(oob_pairs, oob_pi);
                var oob_v = bayan_toml_pair_value(oob_p);
                if (oob_v != 0) {
                    if (str_len(oob_v) > 0) {
                        # Only a VIEW can overrun; a decoded value is a fresh
                        # copy and legitimately sits outside the source span.
                        var oob_ve = str_data(oob_v) + str_len(oob_v);
                        if (str_data(oob_v) >= oob_lo && str_data(oob_v) < oob_hi && oob_ve > oob_hi) { oob_bad = oob_bad + 1; }
                    }
                }
                var oob_k = bayan_toml_pair_key(oob_p);
                if (oob_k != 0) {
                    if (str_len(oob_k) > 0) {
                        # A quoted key is decoded, so it is a copy too (1.5.4).
                        var oob_ke = str_data(oob_k) + str_len(oob_k);
                        if (str_data(oob_k) >= oob_lo && str_data(oob_k) < oob_hi && oob_ke > oob_hi) { oob_bad = oob_bad + 1; }
                    }
                }
                oob_pi = oob_pi + 1;
            }
            oob_si = oob_si + 1;
        }
        oob_runs = oob_runs + 1;
        oob_cut = oob_cut + 1;
    }
    oob_i = oob_i + 1;
}
assert_gt(oob_runs, 120, "toml: the truncation sweep actually ran (one parse per prefix of every document)");
assert_eq(oob_bad, 0, "toml: no key, value or section name reaches past its source buffer");

test_group("toml: array VALUE element access (v1.1.0)");
# bayan_toml_parse stores an array value verbatim (raw `[...]`); these helpers
# decompose it into top-level elements. Covers: bare ints, quoted-string quote
# stripping, `'`-literal strings containing `]` (needs the quote-aware capture),
# nested-array whole capture + recursive re-parse, empty array, trailing comma,
# and a multi-line array with inline `#` comments.
var adoc = "nums = [1, 2, 3]\nstrs = [\"a\", \"b\", \"c\"]\nlit = ['x]y', 'z']\nnested = [[1, 2], [3, 4]]\nempty = []\ntrail = [10, 20, ]\nname = \"bayan\"\nml = [\n  100,  # first\n  200,\n]\n";
var asecs = bayan_toml_parse(str_from(adoc));
var ap = bayan_toml_section_pairs(vec_get(asecs, 0));

# is_array discriminates a `[...]` value from a plain scalar.
assert_eq(bayan_toml_is_array(bayan_toml_get(ap, "nums")), 1, "toml: nums is array");
assert_eq(bayan_toml_is_array(bayan_toml_get(ap, "name")), 0, "toml: name (scalar) is not array");

# Bare integer elements: comma-split + whitespace-trimmed.
var nums = bayan_toml_array_parse(bayan_toml_get(ap, "nums"));
assert_eq(vec_len(nums), 3, "toml: nums has 3 elements");
assert_eq(str_eq_cstr(vec_get(nums, 0), "1"), 1, "toml: nums[0] == 1");
assert_eq(str_eq_cstr(vec_get(nums, 2), "3"), 1, "toml: nums[2] == 3");

# Quoted string elements: one quote layer stripped, body verbatim.
var strs = bayan_toml_get_array(ap, "strs");
assert_eq(vec_len(strs), 3, "toml: strs has 3 elements");
assert_eq(str_eq_cstr(vec_get(strs, 1), "b"), 1, "toml: strs[1] == b (quotes stripped)");

# Literal ('...') strings containing ']' — quote-aware capture, not truncated.
var lit = bayan_toml_get_array(ap, "lit");
assert_eq(vec_len(lit), 2, "toml: lit has 2 elements");
assert_eq(str_eq_cstr(vec_get(lit, 0), "x]y"), 1, "toml: lit[0] == x]y (']' inside '' preserved)");
assert_eq(str_eq_cstr(vec_get(lit, 1), "z"), 1, "toml: lit[1] == z");

# Nested arrays returned whole; re-parse one recursively.
var nested = bayan_toml_get_array(ap, "nested");
assert_eq(vec_len(nested), 2, "toml: nested has 2 elements");
assert_eq(str_eq_cstr(vec_get(nested, 0), "[1, 2]"), 1, "toml: nested[0] whole == [1, 2]");
var inner = bayan_toml_array_parse(vec_get(nested, 1));
assert_eq(vec_len(inner), 2, "toml: nested[1] re-parses to 2 elements");
assert_eq(str_eq_cstr(vec_get(inner, 1), "4"), 1, "toml: nested[1][1] == 4");

# Empty array -> zero elements.
assert_eq(vec_len(bayan_toml_get_array(ap, "empty")), 0, "toml: empty array has 0 elements");

# Trailing comma -> no phantom empty element.
var trail = bayan_toml_get_array(ap, "trail");
assert_eq(vec_len(trail), 2, "toml: trailing comma yields 2 (no empty tail)");
assert_eq(str_eq_cstr(vec_get(trail, 1), "20"), 1, "toml: trail[1] == 20");

# Multi-line array with inline comments: comments skipped, values intact.
var ml = bayan_toml_get_array(ap, "ml");
assert_eq(vec_len(ml), 2, "toml: multi-line array has 2 elements");
assert_eq(str_eq_cstr(vec_get(ml, 0), "100"), 1, "toml: ml[0] == 100 (inline comment stripped)");
assert_eq(str_eq_cstr(vec_get(ml, 1), "200"), 1, "toml: ml[1] == 200");

# Nested array element with an INLINE comment on the first line is captured
# WHOLE (regression: a mid-span `#` must skip only to end-of-line, not consume
# the rest of the element span — else the nested `]` and trailing content are
# silently dropped and the re-parse loses elements).
var nc = bayan_toml_array_parse(str_from("[ [1, # c\n 2] , 9 ]"));
assert_eq(vec_len(nc), 2, "toml: nested+inline-comment splits into 2 top-level elements");
assert_eq(str_eq_cstr(vec_get(nc, 1), "9"), 1, "toml: nc[1] == 9");
var nc0 = bayan_toml_array_parse(vec_get(nc, 0));
assert_eq(vec_len(nc0), 2, "toml: nc[0] re-parses to 2 (nested ] not dropped by mid-span comment)");
assert_eq(str_eq_cstr(vec_get(nc0, 1), "2"), 1, "toml: nc[0][1] == 2 (content after inline comment kept)");

# Absent key -> get_array returns 0; a non-array scalar -> empty vec.
assert_eq(bayan_toml_get_array(ap, "nope"), 0, "toml: get_array absent key -> 0");
assert_eq(vec_len(bayan_toml_array_parse(bayan_toml_get(ap, "name"))), 0, "toml: array_parse of scalar -> empty vec");

# Back-compat alias parity.
assert_eq(vec_len(toml_array_parse(bayan_toml_get(ap, "nums"))), 3, "toml: alias toml_array_parse parity");
assert_eq(toml_is_array(bayan_toml_get(ap, "nums")), 1, "toml: alias toml_is_array parity");

test_group("yaml: parse into the shared tagged value tree (v1.2.0)");
# bayan_yaml_parse* produces the SAME JTAG_* node graph as the JSON value
# parser, so every bayan_json_v_* accessor below traverses YAML output.
# Subset boundary: out-of-subset YAML must fail LOUDLY, never mis-parse. See
# docs/development/issues/2026-07-16-agnosai-yaml-parse-into-tagged-value-tree.md.

# -- scalar typing: str / int / float / bool / null / ~ --
var y1 = "title: My Note\ncount: 42\npi: 3.14\nok: true\noff: false\nnothing: null\ntilde: ~\n";
var yv1 = bayan_yaml_parse_buf(y1, strlen(y1));
assert_eq(bayan_json_v_is_obj(yv1), 1, "yaml: mapping -> JTAG_OBJ");
assert_eq(bayan_json_v_obj_len(yv1), 7, "yaml: 7 entries");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yv1, "title")), "My Note"), 1, "yaml: str value");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yv1, "count")), 42, "yaml: int value");
assert_eq(bayan_json_v_is_float(bayan_json_v_obj_get(yv1, "pi")), 1, "yaml: float value");
assert_eq(bayan_json_v_bool(bayan_json_v_obj_get(yv1, "ok")), 1, "yaml: true");
assert_eq(bayan_json_v_bool(bayan_json_v_obj_get(yv1, "off")), 0, "yaml: false");
assert_eq(bayan_json_v_is_null(bayan_json_v_obj_get(yv1, "nothing")), 1, "yaml: null");
assert_eq(bayan_json_v_is_null(bayan_json_v_obj_get(yv1, "tilde")), 1, "yaml: ~ -> null");

# -- quoted scalars: one layer stripped, verbatim body; quote-aware comments --
var y2 = "a: \"x # not a comment\"\nb: 'single'\nc: \"\"\nu: http://x/y\n";
var yv2 = bayan_yaml_parse_buf(y2, strlen(y2));
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yv2, "a")), "x # not a comment"), 1, "yaml: # inside quotes kept");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yv2, "b")), "single"), 1, "yaml: single-quoted");
assert_eq(str_len(bayan_json_v_str(bayan_json_v_obj_get(yv2, "c"))), 0, "yaml: empty quoted string");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yv2, "u")), "http://x/y"), 1, "yaml: plain url (colon w/o space is not a key split)");

# -- comments, blank lines, CRLF --
var y3 = "# leading comment\n\nk: 1 # trailing\r\nj: 2\r\n";
var yv3 = bayan_yaml_parse_buf(y3, strlen(y3));
assert_eq(bayan_json_v_obj_len(yv3), 2, "yaml: comments/blanks skipped, CRLF ok");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yv3, "k")), 1, "yaml: trailing comment stripped");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yv3, "j")), 2, "yaml: CRLF line parses");

# -- nested mappings by indentation --
var y4 = "outer:\n  inner:\n    deep: 3\n  flat: v\ntop: 1\n";
var yv4 = bayan_yaml_parse_buf(y4, strlen(y4));
var y4o = bayan_json_v_obj_get(yv4, "outer");
assert_eq(bayan_json_v_is_obj(y4o), 1, "yaml: nested mapping is OBJ");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(bayan_json_v_obj_get(y4o, "inner"), "deep")), 3, "yaml: 2-deep nesting");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(y4o, "flat")), "v"), 1, "yaml: sibling after deeper block");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yv4, "top")), 1, "yaml: dedent back to top");

# -- block sequences: indented AND at parent indent --
var y5 = "items:\n  - one\n  - 2\nsame:\n- a\n- b\n";
var yv5 = bayan_yaml_parse_buf(y5, strlen(y5));
var y5i = bayan_json_v_obj_get(yv5, "items");
assert_eq(bayan_json_v_arr_len(y5i), 2, "yaml: indented block seq len");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(y5i, 0)), "one"), 1, "yaml: seq[0]");
assert_eq(bayan_json_v_int(bayan_json_v_arr_get(y5i, 1)), 2, "yaml: seq[1] typed int");
assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get(yv5, "same")), 2, "yaml: seq at same indent as key");

# -- sequence of mappings (compact `- key: v` + continuation) — the agnosai
#    definition-file shape --
var y6 = "agents:\n  - name: researcher\n    role: digs\n  - name: writer\n";
var yv6 = bayan_yaml_parse_buf(y6, strlen(y6));
var y6a = bayan_json_v_obj_get(yv6, "agents");
assert_eq(bayan_json_v_arr_len(y6a), 2, "yaml: 2 agent mappings");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(bayan_json_v_arr_get(y6a, 0), "name")), "researcher"), 1, "yaml: agents[0].name");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(bayan_json_v_arr_get(y6a, 0), "role")), "digs"), 1, "yaml: agents[0].role (continuation line)");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(bayan_json_v_arr_get(y6a, 1), "name")), "writer"), 1, "yaml: agents[1].name");

# -- bare `-` + deeper block; `-` alone -> null item --
var y7 = "xs:\n  -\n  - v\n";
var yv7 = bayan_yaml_parse_buf(y7, strlen(y7));
var y7x = bayan_json_v_obj_get(yv7, "xs");
assert_eq(bayan_json_v_is_null(bayan_json_v_arr_get(y7x, 0)), 1, "yaml: bare - is null item");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(y7x, 1)), "v"), 1, "yaml: item after bare -");

# -- flow sequences: typing, nesting, empty, trailing comma --
var y8 = "tags: [rust, programming]\nnums: [1, 2.5, true, null]\nempty: []\ntrail: [a, b,]\nnest: [[1, 2], [3]]\n";
var yv8 = bayan_yaml_parse_buf(y8, strlen(y8));
var y8t = bayan_json_v_obj_get(yv8, "tags");
assert_eq(bayan_json_v_arr_len(y8t), 2, "yaml: flow seq len");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(y8t, 0)), "rust"), 1, "yaml: flow[0]");
var y8n = bayan_json_v_obj_get(yv8, "nums");
assert_eq(bayan_json_v_int(bayan_json_v_arr_get(y8n, 0)), 1, "yaml: flow int");
assert_eq(bayan_json_v_is_float(bayan_json_v_arr_get(y8n, 1)), 1, "yaml: flow float");
assert_eq(bayan_json_v_bool(bayan_json_v_arr_get(y8n, 2)), 1, "yaml: flow bool");
assert_eq(bayan_json_v_is_null(bayan_json_v_arr_get(y8n, 3)), 1, "yaml: flow null");
assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get(yv8, "empty")), 0, "yaml: [] empty");
assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get(yv8, "trail")), 2, "yaml: trailing comma no phantom");
var y8nest = bayan_json_v_obj_get(yv8, "nest");
assert_eq(bayan_json_v_arr_len(y8nest), 2, "yaml: nested flow outer len");
assert_eq(bayan_json_v_int(bayan_json_v_arr_get(bayan_json_v_arr_get(y8nest, 0), 1)), 2, "yaml: nested flow [0][1]");

# -- top-level sequence / scalar / empty documents --
var y9 = "- a\n- b\n";
var yv9 = bayan_yaml_parse_buf(y9, strlen(y9));
assert_eq(bayan_json_v_is_arr(yv9), 1, "yaml: top-level sequence doc");
assert_eq(bayan_json_v_arr_len(yv9), 2, "yaml: top-level seq len");
var y10 = "hello\n";
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_yaml_parse_buf(y10, strlen(y10))), "hello"), 1, "yaml: top-level scalar doc");
var y11 = "# only a comment\n\n";
assert_eq(bayan_json_v_is_null(bayan_yaml_parse_buf(y11, strlen(y11))), 1, "yaml: empty doc -> JTAG_NULL");

# -- document markers: one leading ---, one trailing ... --
var y12 = "---\nk: 1\n...\n";
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(bayan_yaml_parse_buf(y12, strlen(y12)), "k")), 1, "yaml: --- and ... markers accepted");

# -- out-of-subset input fails LOUDLY (never a silent mis-parse) --
var yr1 = "k: &anchor v\n";
assert_eq(bayan_yaml_parse_buf(yr1, strlen(yr1)), 0, "yaml: anchor rejected");
assert_eq(streq(bayan_yaml_last_error(), "yaml anchors/aliases not supported"), 1, "yaml: anchor error msg");
var yr2 = "k: *alias\n";
assert_eq(bayan_yaml_parse_buf(yr2, strlen(yr2)), 0, "yaml: alias rejected");
var yr3 = "k: !!str v\n";
assert_eq(bayan_yaml_parse_buf(yr3, strlen(yr3)), 0, "yaml: tag rejected");
assert_eq(streq(bayan_yaml_last_error(), "yaml tags not supported"), 1, "yaml: tag error msg");
var yr4 = "k: |\n  block\n";
assert_eq(bayan_yaml_parse_buf(yr4, strlen(yr4)), 0, "yaml: block scalar rejected");
var yr5 = "k: {a: 1}\n";
assert_eq(bayan_yaml_parse_buf(yr5, strlen(yr5)), 0, "yaml: flow mapping rejected");
assert_eq(streq(bayan_yaml_last_error(), "yaml flow mappings not supported"), 1, "yaml: flow mapping error msg");
var yr6 = "\tk: 1\n";
assert_eq(bayan_yaml_parse_buf(yr6, strlen(yr6)), 0, "yaml: tab indentation rejected");
var yr7 = "---\na: 1\n---\nb: 2\n";
assert_eq(bayan_yaml_parse_buf(yr7, strlen(yr7)), 0, "yaml: second --- rejected");
assert_eq(streq(bayan_yaml_last_error(), "multi-document yaml not supported"), 1, "yaml: multi-doc error msg");
var yr8 = "a: 1\n    stray: 2\n";
assert_eq(bayan_yaml_parse_buf(yr8, strlen(yr8)), 0, "yaml: stray deeper line rejected");
var yr9 = "k: \"unterminated\n";
assert_eq(bayan_yaml_parse_buf(yr9, strlen(yr9)), 0, "yaml: unterminated quote rejected");
# (a SINGLE colon-less line is a valid top-level scalar doc — asserted above —
# so the missing-colon error needs a second line to prove we're in a mapping)
var yr10 = "a: 1\nk v\n";
assert_eq(bayan_yaml_parse_buf(yr10, strlen(yr10)), 0, "yaml: missing colon rejected");
assert_eq(streq(bayan_yaml_last_error(), "expected ':' in mapping entry"), 1, "yaml: colon error msg");
var yr11 = "k: [1, 2\n";
assert_eq(bayan_yaml_parse_buf(yr11, strlen(yr11)), 0, "yaml: unterminated flow seq rejected");

# -- recursion-depth cap shared with the json parsers (128) --
fn _mk_yflow(n): i64 {
    var buf = alloc(n * 2 + 4 + 1);
    store8(buf, 107); store8(buf + 1, 58); store8(buf + 2, 32);   # "k: "
    var i = 0;
    while (i < n)     { store8(buf + 3 + i, 91); i = i + 1; }
    store8(buf + 3 + n, 49);                                       # "1"
    i = 0;
    while (i < n)     { store8(buf + 4 + n + i, 93); i = i + 1; }
    store8(buf + 4 + n * 2, 0);
    return buf;
}
var yd_deep = _mk_yflow(200);
assert_eq(bayan_yaml_parse_buf(yd_deep, strlen(yd_deep)), 0, "yaml: 200-deep flow rejected");
assert_eq(streq(bayan_yaml_last_error(), "nesting too deep"), 1, "yaml: depth error msg");
var yd_ok = _mk_yflow(100);
assert_eq(bayan_yaml_parse_buf(yd_ok, strlen(yd_ok)) != 0, 1, "yaml: 100-deep flow parses");

# -- reentrant ctx path: per-call error reporting --
var yps[48];
assert_eq(bayan_yaml_parse_ctx(&yps, yr10, strlen(yr10)), 0, "yaml ctx: bad doc returns 0");
assert_eq(streq(bayan_yaml_state_error(&yps), "expected ':' in mapping entry"), 1, "yaml ctx: per-call error");
var yps2[48];
assert_eq(bayan_yaml_parse_ctx(&yps2, y1, strlen(y1)) != 0, 1, "yaml ctx: good doc parses");
assert_eq(streq(bayan_yaml_state_error(&yps2), ""), 1, "yaml ctx: no error on success");

# -- frontmatter split (the mneme shape) --
var yfm = "---\ntitle: T\ntags: [x, y]\n---\nBody line\n";
var yfp = bayan_yaml_frontmatter_split(str_from(yfm));
assert_eq(bayan_yaml_fm_yaml(yfp) != 0, 1, "yaml fm: frontmatter found");
assert_eq(str_eq_cstr(bayan_yaml_fm_body(yfp), "Body line\n"), 1, "yaml fm: body");
var yfv = bayan_yaml_parse(bayan_yaml_fm_yaml(yfp));
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yfv, "title")), "T"), 1, "yaml fm: title parses");
assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get(yfv, "tags")), 2, "yaml fm: tags parse");
var yfm2 = "no frontmatter here\n";
var yfp2 = bayan_yaml_frontmatter_split(str_from(yfm2));
assert_eq(bayan_yaml_fm_yaml(yfp2), 0, "yaml fm: none -> yaml 0");
assert_eq(str_eq_cstr(bayan_yaml_fm_body(yfp2), "no frontmatter here\n"), 1, "yaml fm: none -> body is whole input");
var yfm3 = "---\nk: v\n";
var yfp3 = bayan_yaml_frontmatter_split(str_from(yfm3));
assert_eq(bayan_yaml_fm_yaml(yfp3), 0, "yaml fm: unclosed fence -> yaml 0");

# ---- adversarial-review regressions (pre-1.2.0 review findings) ----

# marker lines must carry nothing else — "--- foo" was silently absorbed
var ya1 = "--- foo\n";
assert_eq(bayan_yaml_parse_buf(ya1, strlen(ya1)), 0, "yaml: '--- foo' rejected");
assert_eq(streq(bayan_yaml_last_error(), "content on '---' marker line not supported"), 1, "yaml: marker-content error msg");
var ya2 = "--- key: value\n";
assert_eq(bayan_yaml_parse_buf(ya2, strlen(ya2)), 0, "yaml: '--- key: value' rejected");
var ya3 = "... tail\n";
assert_eq(bayan_yaml_parse_buf(ya3, strlen(ya3)), 0, "yaml: '... tail' rejected");

# empty flow elements were phantom nulls
var ya4 = "k: [,]\n";
assert_eq(bayan_yaml_parse_buf(ya4, strlen(ya4)), 0, "yaml: [,] rejected");
assert_eq(streq(bayan_yaml_last_error(), "empty flow-sequence element"), 1, "yaml: empty-element error msg");
var ya5 = "k: [a,,b]\n";
assert_eq(bayan_yaml_parse_buf(ya5, strlen(ya5)), 0, "yaml: [a,,b] rejected");

# strict-JSON number gate — lax scanner tokens fall back to STR
var ya6 = "a: 1e\nb: 01\nc: 1.\nd: 1e+\ne: -x\n";
var yav6 = bayan_yaml_parse_buf(ya6, strlen(ya6));
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav6, "a")), "1e"), 1, "yaml: '1e' is STR");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav6, "b")), "01"), 1, "yaml: '01' is STR");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav6, "c")), "1."), 1, "yaml: '1.' is STR");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav6, "d")), "1e+"), 1, "yaml: '1e+' is STR");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav6, "e")), "-x"), 1, "yaml: '-x' is STR");
var ya7 = "a: 1e5\nb: -3\nc: 0\nd: -0.5e-2\n";
var yav7 = bayan_yaml_parse_buf(ya7, strlen(ya7));
assert_eq(bayan_json_v_is_float(bayan_json_v_obj_get(yav7, "a")), 1, "yaml: 1e5 is FLOAT");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yav7, "b")), 0 - 3, "yaml: -3 is INT");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yav7, "c")), 0, "yaml: 0 is INT");
assert_eq(bayan_json_v_is_float(bayan_json_v_obj_get(yav7, "d")), 1, "yaml: -0.5e-2 is FLOAT");

# mid-word quotes are literal — comments must still strip, keys still split
var ya8 = "name: O'Brien # c\nsize: 5\" nail # c\n";
var yav8 = bayan_yaml_parse_buf(ya8, strlen(ya8));
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav8, "name")), "O'Brien"), 1, "yaml: comment stripped past mid-word apostrophe");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(yav8, "size")), "5\" nail"), 1, "yaml: comment stripped past inch-mark");
var ya9 = "t: [it's, x] # c\n";
var yav9 = bayan_yaml_parse_buf(ya9, strlen(ya9));
var ya9t = bayan_json_v_obj_get(yav9, "t");
assert_eq(bayan_json_v_arr_len(ya9t), 2, "yaml: flow with mid-word quote parses");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(ya9t, 0)), "it's"), 1, "yaml: flow element keeps literal quote");
var ya10 = "don't: 1\n";
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(bayan_yaml_parse_buf(ya10, strlen(ya10)), "don't")), 1, "yaml: plain key with mid-word quote splits");

# implicit flow mappings are loud, in every position
var ya11 = "[a: b]\n";
assert_eq(bayan_yaml_parse_buf(ya11, strlen(ya11)), 0, "yaml: top-level [a: b] rejected");
assert_eq(streq(bayan_yaml_last_error(), "yaml flow mappings not supported"), 1, "yaml: implicit flow-mapping error msg");
var ya12 = "k: [a: b]\n";
assert_eq(bayan_yaml_parse_buf(ya12, strlen(ya12)), 0, "yaml: value [a: b] rejected");
var ya13 = "[1, 2]\n";
assert_eq(bayan_json_v_arr_len(bayan_yaml_parse_buf(ya13, strlen(ya13))), 2, "yaml: top-level flow doc parses");

# anchors/tags in KEY position are as loud as in value position
var ya14 = "&x: 1\n";
assert_eq(bayan_yaml_parse_buf(ya14, strlen(ya14)), 0, "yaml: anchor key rejected");
assert_eq(streq(bayan_yaml_last_error(), "yaml anchors/aliases not supported"), 1, "yaml: anchor-key error msg");
var ya15 = "!!t: 1\n";
assert_eq(bayan_yaml_parse_buf(ya15, strlen(ya15)), 0, "yaml: tag key rejected");

# indicator-led plain values are loud
var ya16 = "k: - x\n";
assert_eq(bayan_yaml_parse_buf(ya16, strlen(ya16)), 0, "yaml: 'k: - x' rejected");
assert_eq(streq(bayan_yaml_last_error(), "unexpected '-' sequence indicator in scalar"), 1, "yaml: dash-value error msg");
var ya17 = "? k\n";
assert_eq(bayan_yaml_parse_buf(ya17, strlen(ya17)), 0, "yaml: complex key rejected");
assert_eq(streq(bayan_yaml_last_error(), "yaml complex keys ('?') not supported"), 1, "yaml: complex-key error msg");

# malformed quoted scalars are loud, not glued
var ya18 = "k: \"a\" \"b\"\n";
assert_eq(bayan_yaml_parse_buf(ya18, strlen(ya18)), 0, "yaml: glued quoted scalars rejected");
assert_eq(streq(bayan_yaml_last_error(), "malformed quoted scalar"), 1, "yaml: malformed-quote error msg");

# a flow sequence on its own line below the key is loud
var ya19 = "k:\n  [1, 2]\n";
assert_eq(bayan_yaml_parse_buf(ya19, strlen(ya19)), 0, "yaml: flow on next line rejected");
assert_eq(streq(bayan_yaml_last_error(), "flow sequence must follow its key on the same line"), 1, "yaml: flow-line error msg");

# leading UTF-8 BOM is skipped, not absorbed into the first key
var ya20 = alloc(12);
store8(ya20, 239); store8(ya20 + 1, 187); store8(ya20 + 2, 191);
store8(ya20 + 3, 107); store8(ya20 + 4, 58); store8(ya20 + 5, 32);
store8(ya20 + 6, 49); store8(ya20 + 7, 10); store8(ya20 + 8, 0);
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(bayan_yaml_parse_buf(ya20, strlen(ya20)), "k")), 1, "yaml: BOM skipped");

# ---- coverage-gap closures ----

# block-structure recursion shares the 128 cap (only flow was tested)
fn _mk_ymap(n): i64 {
    # n nested mappings: line i = 2i spaces + "a:", final line 2n spaces + "b: 1"
    var buf = alloc(n * (n + 1) + n * 4 + 2 * n + 8);
    var o = 0;
    var i = 0;
    while (i < n) {
        var s = 0;
        while (s < i * 2) { store8(buf + o, 32); o = o + 1; s = s + 1; }
        store8(buf + o, 97); store8(buf + o + 1, 58); store8(buf + o + 2, 10);
        o = o + 3;
        i = i + 1;
    }
    var s2 = 0;
    while (s2 < n * 2) { store8(buf + o, 32); o = o + 1; s2 = s2 + 1; }
    store8(buf + o, 98); store8(buf + o + 1, 58); store8(buf + o + 2, 32);
    store8(buf + o + 3, 49); store8(buf + o + 4, 10); store8(buf + o + 5, 0);
    return buf;
}
var ymd = _mk_ymap(200);
assert_eq(bayan_yaml_parse_buf(ymd, strlen(ymd)), 0, "yaml: 200-deep block rejected");
assert_eq(streq(bayan_yaml_last_error(), "nesting too deep"), 1, "yaml: block depth error msg");
var ymo = _mk_ymap(100);
assert_eq(bayan_yaml_parse_buf(ymo, strlen(ymo)) != 0, 1, "yaml: 100-deep block parses");

# err_pos is a byte offset into the source
assert_eq(bayan_yaml_parse_buf(yr10, strlen(yr10)), 0, "yaml: err_pos fixture rejected");
assert_eq(bayan_yaml_last_error_pos(), 5, "yaml: err_pos points at offending line");
var ypsp[48];
assert_eq(bayan_yaml_parse_ctx(&ypsp, yr10, strlen(yr10)), 0, "yaml ctx: err_pos fixture rejected");
assert_eq(bayan_yaml_state_error_pos(&ypsp), 5, "yaml ctx: per-call err_pos");

# '...' enforcement: content after end, '...' before content, double '...'
var ye1 = "...\nk: 1\n";
assert_eq(bayan_yaml_parse_buf(ye1, strlen(ye1)), 0, "yaml: content after leading ... rejected");
assert_eq(streq(bayan_yaml_last_error(), "content after '...' document end"), 1, "yaml: doc-end error msg");
var ye2 = "---\nk: 1\n...\n...\n";
assert_eq(bayan_yaml_parse_buf(ye2, strlen(ye2)), 0, "yaml: second ... rejected");

# Str entries: ctx_str success + null-source paths
var ypss[48];
assert_eq(bayan_yaml_parse_ctx_str(&ypss, str_from(y1)) != 0, 1, "yaml: parse_ctx_str parses");
assert_eq(bayan_yaml_parse(0), 0, "yaml: parse(0) -> 0");
assert_eq(streq(bayan_yaml_last_error(), "null source"), 1, "yaml: null-source error msg");
var ypsn[48];
assert_eq(bayan_yaml_parse_ctx_str(&ypsn, 0), 0, "yaml: parse_ctx_str(0) -> 0");
assert_eq(streq(bayan_yaml_state_error(&ypsn), "null source"), 1, "yaml ctx: null-source error msg");

# nested compact sequences '- - x'
var yn1 = "m:\n  - - a\n    - b\n";
var ynv1 = bayan_yaml_parse_buf(yn1, strlen(yn1));
var ynm = bayan_json_v_obj_get(ynv1, "m");
assert_eq(bayan_json_v_arr_len(ynm), 1, "yaml: seq-in-seq outer len");
assert_eq(bayan_json_v_arr_len(bayan_json_v_arr_get(ynm, 0)), 2, "yaml: seq-in-seq inner len");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(bayan_json_v_arr_get(ynm, 0), 1)), "b"), 1, "yaml: seq-in-seq [0][1]");

# quoted keys (incl. the pinned empty-quoted-key behavior)
var yq1 = "\"my key\": 1\n'other': 2\n'': 9\n";
var yqv1 = bayan_yaml_parse_buf(yq1, strlen(yq1));
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yqv1, "my key")), 1, "yaml: double-quoted key");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yqv1, "other")), 2, "yaml: single-quoted key");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(yqv1, "")), 9, "yaml: quoted empty key (pinned)");

# frontmatter edges: CRLF fences, fence-as-last-line, '...' closing fence
var yfc = "---\r\ntitle: T\r\n---\r\nB\r\n";
var yfcp = bayan_yaml_frontmatter_split(str_from(yfc));
assert_eq(bayan_yaml_fm_yaml(yfcp) != 0, 1, "yaml fm: CRLF fences split");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_obj_get(bayan_yaml_parse(bayan_yaml_fm_yaml(yfcp)), "title")), "T"), 1, "yaml fm: CRLF yaml parses");
assert_eq(str_eq_cstr(bayan_yaml_fm_body(yfcp), "B\r\n"), 1, "yaml fm: CRLF body");
var yfl = "---\nk: v\n---";
var yflp = bayan_yaml_frontmatter_split(str_from(yfl));
assert_eq(bayan_yaml_fm_yaml(yflp) != 0, 1, "yaml fm: fence-as-last-line split");
assert_eq(str_len(bayan_yaml_fm_body(yflp)), 0, "yaml fm: empty body after final fence");
var yfd = "---\nk: v\n...\nB\n";
var yfdp = bayan_yaml_frontmatter_split(str_from(yfd));
assert_eq(str_eq_cstr(bayan_yaml_fm_body(yfdp), "B\n"), 1, "yaml fm: ... closes the fence");
var yfo = "...\nx\n";
assert_eq(bayan_yaml_fm_yaml(bayan_yaml_frontmatter_split(str_from(yfo))), 0, "yaml fm: ... cannot open a block");

# remaining loud structural errors
var ys1 = "k: [1] junk\n";
assert_eq(bayan_yaml_parse_buf(ys1, strlen(ys1)), 0, "yaml: content after flow rejected");
assert_eq(streq(bayan_yaml_last_error(), "content after flow sequence"), 1, "yaml: after-flow error msg");
var ys2 = "a: 1\n- x\n";
assert_eq(bayan_yaml_parse_buf(ys2, strlen(ys2)), 0, "yaml: seq entry in mapping rejected");
assert_eq(streq(bayan_yaml_last_error(), "unexpected sequence entry in mapping"), 1, "yaml: seq-in-mapping error msg");
var ys3 = "- a\nk: v\n";
assert_eq(bayan_yaml_parse_buf(ys3, strlen(ys3)), 0, "yaml: trailing mapping line after seq doc rejected");
assert_eq(streq(bayan_yaml_last_error(), "unexpected line"), 1, "yaml: unexpected-line error msg");
var ys4 = "foo\nbar\n";
assert_eq(bayan_yaml_parse_buf(ys4, strlen(ys4)), 0, "yaml: multi-line plain doc rejected");
assert_eq(streq(bayan_yaml_last_error(), "expected mapping or sequence entry"), 1, "yaml: plain-doc error msg");

fn _dtoa_rt(bitv): i64 {
    var b[64];
    var n = bayan_f64_to_json(bitv, &b);
    store8(&b + n, 0);
    if (bayan_f64_from_json(&b) == bitv) { return 1; }
    return 0;
}
fn _dtoa_emits_null(bitv): i64 {
    var b[64];
    var n = bayan_f64_to_json(bitv, &b);
    if (n != 4) { return 0; }
    if (load8(&b) == 110 && load8(&b + 1) == 117) {
        if (load8(&b + 2) == 108 && load8(&b + 3) == 108) { return 1; }
    }
    return 0;
}
# === v1.2.1: f64 JSON round-trip (Grisu2 formatter + correctly-rounded parser) ===
# Parse is correctly rounded: 0.333333 -> ...46 (the value a correct strtod gives;
# the old math f64_parse gave ...47, _jp_atof ...46 — now unified + correct).
assert_eq(bayan_f64_from_json("0.5"), 0x3FE0000000000000, "f64 parse 0.5");
assert_eq(bayan_f64_from_json("0.333333"), 0x3FD55553EF6B5D46, "f64 parse 0.333333 correctly-rounded");
assert_eq(bayan_f64_from_json("0.1"), 0x3FB999999999999A, "f64 parse 0.1");
assert_eq(bayan_f64_from_json("1e-9"), 0x3E112E0BE826D695, "f64 parse 1e-9");
# DoS clamp: a huge exponent returns instantly (was O(exp), ~237ms), saturating.
assert_eq(bayan_f64_from_json("1e100000000"), 0x7FF0000000000000, "f64 1e100000000 -> +Inf, no DoS");
assert_eq(bayan_f64_from_json("1e-100000000"), 0, "f64 1e-100000000 -> 0, no DoS");
# Round-trip (format then parse == original bits) across the hard cases.
assert_eq(_dtoa_rt(0x3FD5555555555555), 1, "f64 rt 1/3 exact (was 0.333333 lossy)");
assert_eq(_dtoa_rt(0x3FE5555555555555), 1, "f64 rt 2/3 exact");
assert_eq(_dtoa_rt(0x3E112E0BE826D695), 1, "f64 rt 1e-9 exact (was flushed to 0)");
assert_eq(_dtoa_rt(0x0000000000000001), 1, "f64 rt min subnormal exact");
assert_eq(_dtoa_rt(0x7FEFFFFFFFFFFFFF), 1, "f64 rt max double exact");
assert_eq(_dtoa_rt(0x43E0000000000000), 1, "f64 rt 2^63 exact (was invalid -.00000-)");
# Non-finite -> valid JSON "null" (was the non-JSON token -.00000-).
assert_eq(_dtoa_emits_null(0x7FF0000000000000), 1, "f64 +Inf emits null");
assert_eq(_dtoa_emits_null(0x7FF8000000000000), 1, "f64 NaN emits null");

test_group("Str-entry dispatch regression (v1.3.0)");
# These bare entries take a Str, so Cyrius routes the call to an `X_str`
# sibling if one exists. While the cstr+len forms were named
# `bayan_json_v_parse_str` / `bayan_yaml_parse_str`, every one of these calls
# was silently rewritten into a 1-arg call to a 2-arg fn and returned 0 for
# perfectly valid input. The cstr+len forms are now `_buf`; these assertions
# are what would have caught it, and what stops it recurring.
var d13_sj = str_from("{\"k\": 42, \"s\": \"v\"}");
var d13_sdoc = bayan_json_v_parse(d13_sj);
assert_eq(d13_sdoc != 0, 1, "bayan_json_v_parse(Str) returns a value");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(d13_sdoc, "k")), 42, "bayan_json_v_parse(Str): k == 42");
assert_eq(streq(str_data(bayan_json_v_str(bayan_json_v_obj_get(d13_sdoc, "s"))), "v"), 1,
  "bayan_json_v_parse(Str): s == v");

var d13_adoc = json_v_parse(d13_sj);
assert_eq(d13_adoc != 0, 1, "alias json_v_parse(Str) returns a value");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(d13_adoc, "k")), 42, "alias json_v_parse(Str): k == 42");

# The Str entry and the buf entry must agree.
var d13_bdoc = bayan_json_v_parse_buf(str_data(d13_sj), str_len(d13_sj));
assert_eq(d13_bdoc != 0, 1, "bayan_json_v_parse_buf agrees the input is valid");
assert_eq(str_eq(bayan_json_v_build(d13_sdoc), bayan_json_v_build(d13_bdoc)), 1,
  "Str and buf entries produce identical trees");

# A null Str is still rejected cleanly rather than dispatched into the weeds.
assert_eq(bayan_json_v_parse(0), 0, "bayan_json_v_parse(0) returns 0");

var d13_sy = str_from("k: 1\n");
var d13_ydoc = bayan_yaml_parse(d13_sy);
assert_eq(d13_ydoc != 0, 1, "bayan_yaml_parse(Str) returns a value");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(d13_ydoc, "k")), 1, "bayan_yaml_parse(Str): k == 1");
assert_eq(bayan_yaml_parse(0), 0, "bayan_yaml_parse(0) returns 0");

# ======================================================================
# [1.4.0] Allocator-threaded JSON value API — the `_a` surface.
#
# The contract under test is not "these functions exist"; it is that a caller
# can route an ENTIRE parse->mutate->serialize cycle through an arena and see
# ZERO growth on the global bump. Before 1.4.0 the value constructors had `_a`
# forms but obj_set, the parser and the serializer did not, so an arena covered
# part of a request and the rest leaked — which measures as "the arena works"
# right up until you check alloc_used().
# ======================================================================

var A_SRC = "{\"a\":1,\"b\":[true,null,2.5,\"x\"],\"c\":{\"d\":\"e\"}}";

# --- 1. byte-identical output vs the non-_a path ---------------------------
var a_arena = arena_allocator(65536);
var a_tree_g = bayan_json_v_parse_buf(A_SRC, strlen(A_SRC));
var a_tree_a = bayan_json_v_parse_buf_a(a_arena, A_SRC, strlen(A_SRC));
assert_eq(a_tree_a != 0, 1, "1.4.0: parse_buf_a returns a tree");
assert_eq(str_eq(bayan_json_v_build(a_tree_g), bayan_json_v_build_a(a_arena, a_tree_a)), 1,
  "1.4.0: build_a(parse_buf_a) == build(parse_buf) byte-for-byte");
assert_eq(str_eq_cstr(bayan_json_v_build_a(a_arena, a_tree_a), A_SRC), 1,
  "1.4.0: _a round-trip reproduces the source exactly");

# pretty form agrees too, including the add_byte -> add_cstr_a indent swap
assert_eq(str_eq(bayan_json_v_build_pretty(a_tree_g, 2),
    bayan_json_v_build_pretty_a(a_arena, a_tree_a, 2)), 1,
  "1.4.0: build_pretty_a == build_pretty byte-for-byte");
assert_eq(str_eq(bayan_json_v_build_pretty_a(a_arena, a_tree_a, 0),
    bayan_json_v_build_a(a_arena, a_tree_a)), 1,
  "1.4.0: build_pretty_a(indent<=0) falls back to compact");

# --- 2. the point of the release: nothing lands on the global bump ---------
var a_a2 = arena_allocator(262144);
reset_via(a_a2);
var a_before = alloc_used();
var a_i = 0;
while (a_i < 200) {
    var a_t = bayan_json_v_parse_buf_a(a_a2, A_SRC, strlen(A_SRC));
    var a_o = bayan_json_v_obj_new_a(a_a2);
    bayan_json_v_obj_set_a(a_a2, a_o, str_from_a(a_a2, "wrapped"), a_t);
    bayan_json_v_build_a(a_a2, a_o);
    a_i = a_i + 1;
}
assert_eq(alloc_used() - a_before, 0,
  "1.4.0: 200 parse+set+build cycles through an arena grow the global bump by 0 bytes");

# the same loop on the non-_a path is what that number is measured against
var a_before_g = alloc_used();
var a_j = 0;
while (a_j < 200) {
    var a_tg = bayan_json_v_parse_buf(A_SRC, strlen(A_SRC));
    var a_og = bayan_json_v_obj_new();
    bayan_json_v_obj_set(a_og, str_from("wrapped"), a_tg);
    bayan_json_v_build(a_og);
    a_j = a_j + 1;
}
assert_eq(alloc_used() - a_before_g > 100000, 1,
  "1.4.0: the same 200 cycles on the global path leak >100 KB (the defect this closes)");

# --- 3. arena exhaustion is a reported parse error, not corruption ---------
# A 64-byte arena cannot hold the tree. The pre-1.4.0 string parser called
# alloc() and never checked for 0, so an exhausted arena would have written
# through a null base.
var a_tiny = arena_allocator(64);
var a_fail = bayan_json_v_parse_buf_a(a_tiny, A_SRC, strlen(A_SRC));
assert_eq(a_fail, 0, "1.4.0: parse_buf_a on an exhausted arena returns 0");
assert_eq(strlen(bayan_json_last_error()) > 0, 1,
  "1.4.0: exhausted arena records a parse error rather than corrupting");

# --- 4. obj_set_a contract: -1 on a bad object, 0 on success ---------------
var a_ok = bayan_json_v_obj_new_a(a_arena);
assert_eq(bayan_json_v_obj_set_a(a_arena, a_ok, str_from_a(a_arena, "k"),
    bayan_json_v_int_new_a(a_arena, 7)), 0,
  "1.4.0: obj_set_a returns 0 on success");
assert_eq(bayan_json_v_obj_set_a(a_arena, 0, str_from_a(a_arena, "k"), 0), 0 - 1,
  "1.4.0: obj_set_a returns -1 on a null object");
assert_eq(bayan_json_v_obj_set_a(a_arena, bayan_json_v_arr_new_a(a_arena),
    str_from_a(a_arena, "k"), 0), 0 - 1,
  "1.4.0: obj_set_a returns -1 when the target is not an object");
assert_eq(bayan_json_v_int(bayan_json_v_obj_get(a_ok, "k")), 7,
  "1.4.0: obj_set_a stores a retrievable pair");

# --- 5. reset_via actually reclaims, and a fresh parse reuses the space ----
var a_a3 = arena_allocator(65536);
bayan_json_v_parse_buf_a(a_a3, A_SRC, strlen(A_SRC));
reset_via(a_a3);
var a_reused = bayan_json_v_parse_buf_a(a_a3, A_SRC, strlen(A_SRC));
assert_eq(a_reused != 0, 1, "1.4.0: an arena reset between parses still serves the next one");
assert_eq(str_eq_cstr(bayan_json_v_build_a(a_arena, a_reused), A_SRC), 1,
  "1.4.0: the post-reset tree is intact");

# --- 6. back-compat: the non-_a entry points are unchanged -----------------
assert_eq(str_eq_cstr(bayan_json_v_build(bayan_json_v_parse_buf(A_SRC, strlen(A_SRC))), A_SRC), 1,
  "1.4.0: non-_a round trip unchanged after the refactor");
var a_ps[48];
assert_eq(bayan_json_v_parse_ctx(&a_ps, "", 0), 0,
  "1.4.0: parse_ctx back-compat wrapper still rejects empty input");
assert_eq(bayan_json_v_parse_ctx_a(a_arena, &a_ps, A_SRC, strlen(A_SRC)) != 0, 1,
  "1.4.0: parse_ctx_a parses into a caller-owned state");

# =============================================================================
# pdf (v1.5.0) — bayan_pdf_*
#
# The writer's real gate is scripts/pdfcheck.py, a strict independent parser
# run by CI over tests/pdf_fixture.cyr's output; these assertions pin the
# in-language contracts that gate cannot see. Flate lives in
# tests/pdf_flate.tcyr, which is the only test that needs lib/sankoch.cyr.
# =============================================================================

test_group("pdf: standard-14 metrics come from Adobe's AFM data (v1.5.0)");
assert_eq(bayan_pdf_font_count(), 14, "pdf: the standard 14 faces");
assert_eq(bayan_pdf_char_width(PDF_FONT_HELVETICA, 65), 667, "pdf: Helvetica 'A' is 667/1000 em");
assert_eq(bayan_pdf_char_width(PDF_FONT_HELVETICA, 32), 278, "pdf: Helvetica space is 278");
assert_eq(bayan_pdf_char_width(PDF_FONT_HELVETICA, 35), 556, "pdf: Helvetica '#' is 556");
assert_eq(bayan_pdf_char_width(PDF_FONT_HELVETICA, 87), 944, "pdf: Helvetica 'W' is 944");
assert_eq(bayan_pdf_char_width(PDF_FONT_HELVETICA, 105), 222, "pdf: Helvetica 'i' is 222");
assert_eq(bayan_pdf_char_width(PDF_FONT_TIMES_ROMAN, 65), 722, "pdf: Times-Roman 'A' is 722");
assert_eq(bayan_pdf_char_width(PDF_FONT_TIMES_ROMAN, 32), 250, "pdf: Times-Roman space is 250");
assert_eq(bayan_pdf_char_width(PDF_FONT_COURIER, 65), 600, "pdf: Courier 'A' is 600");
assert_eq(bayan_pdf_char_width(PDF_FONT_COURIER, 87), 600, "pdf: Courier 'W' is 600 (monospace)");
assert_eq(bayan_pdf_font_is_monospace(PDF_FONT_COURIER), 1, "pdf: Courier is monospace");
assert_eq(bayan_pdf_font_is_monospace(PDF_FONT_HELVETICA), 0, "pdf: Helvetica is not");
assert_eq(bayan_pdf_font_id("Times-Bold"), PDF_FONT_TIMES_BOLD, "pdf: font lookup by PostScript name");
assert_eq(bayan_pdf_font_id("Comic Sans"), 0 - 1, "pdf: an unknown face is rejected, not guessed");
assert_eq(str_eq_cstr(bayan_pdf_font_name(PDF_FONT_SYMBOL), "Symbol"), 1, "pdf: face id back to its name");

# The five CP1252 holes have no glyph in ANY face. _pdff_width must test them
# before the Courier shortcut, or the four Courier faces answer 600 there and
# silently disagree with the other ten.
assert_eq(bayan_pdf_char_width(PDF_FONT_HELVETICA, 129), 0, "pdf: 0x81 is undefined in WinAnsi");
assert_eq(bayan_pdf_char_width(PDF_FONT_COURIER, 129), 0, "pdf: 0x81 is undefined in Courier too");
assert_eq(bayan_pdf_char_width(PDF_FONT_COURIER, 157), 0, "pdf: 0x9D likewise");

test_group("pdf: metric text measurement — the defect mneme's 80-char wrap has");
# 4 chars * 600/1000 em * 12 pt = 28.8 pt = 28800 mpt, exactly.
assert_eq(bayan_pdf_text_width(PDF_FONT_COURIER, 12000, str_from("AAAA")), 28800,
  "pdf: a monospaced run measures exactly");
# Sum-then-scale, not scale-per-character: the latter loses up to 1 mpt each.
assert_eq(bayan_pdf_text_width(PDF_FONT_HELVETICA, 1001, str_from("AAA")), 2003,
  "pdf: widths are summed before scaling, so no per-character rounding loss");
assert_eq(bayan_pdf_text_width(PDF_FONT_HELVETICA, 11000, str_from("")), 0,
  "pdf: an empty run measures zero");
# THE POINT: the same character COUNT is wildly different widths. 80 'W' is
# 830720 mpt and 80 'l' is 195360 mpt in the same face at the same size — a
# 4.25x spread that a character-count wrap cannot see.
var pdf_w80 = str_from("WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW");
var pdf_l80 = str_from("llllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllllll");
assert_eq(str_len(pdf_w80), 80, "pdf: the wide fixture is 80 characters");
assert_eq(str_len(pdf_l80), 80, "pdf: the narrow fixture is 80 characters too");
assert_eq(bayan_pdf_text_width(PDF_FONT_HELVETICA, 11000, pdf_w80), 830720,
  "pdf: 80 'W' at 11pt is 830.72 pt — 184% of a 451 pt column");
assert_eq(bayan_pdf_text_width(PDF_FONT_HELVETICA, 11000, pdf_l80), 195360,
  "pdf: 80 'l' at 11pt is 195.36 pt — 43% of the same column");
assert_gt(bayan_pdf_text_width(PDF_FONT_HELVETICA, 11000, pdf_w80), 451000,
  "pdf: the character-count wrap mneme uses would run 80 'W' off the page");

test_group("pdf: metric word wrap");
var pdf_prose = str_from("the quick brown fox jumps over the lazy dog and keeps running until it is tired");
var pdf_lines = bayan_pdf_wrap(PDF_FONT_HELVETICA, 11000, 200000, pdf_prose);
assert_gt(vec_len(pdf_lines), 1, "pdf: prose wider than the column wraps");
var pdf_wi = 0;
var pdf_over = 0;
while (pdf_wi < vec_len(pdf_lines)) {
    if (bayan_pdf_text_width(PDF_FONT_HELVETICA, 11000, vec_get(pdf_lines, pdf_wi)) > 200000) {
        pdf_over = pdf_over + 1;
    }
    pdf_wi = pdf_wi + 1;
}
assert_eq(pdf_over, 0, "pdf: EVERY wrapped line measures within the column");
assert_eq(vec_len(bayan_pdf_wrap(PDF_FONT_HELVETICA, 11000, 500000, str_from("short"))), 1,
  "pdf: text narrower than the column is one line");
# An unbreakable word must be emitted whole rather than truncated or looped on.
assert_eq(vec_len(bayan_pdf_wrap(PDF_FONT_HELVETICA, 11000, 20000, pdf_w80)), 1,
  "pdf: a single word wider than the column is emitted alone, never split or dropped");

test_group("pdf: units");
assert_eq(bayan_pdf_in(1), 72000, "pdf: one inch is 72 pt exactly");
assert_eq(bayan_pdf_mm(210), 595276, "pdf: 210 mm is A4's documented 595.276 pt");
assert_eq(bayan_pdf_mm(297), 841890, "pdf: 297 mm is A4's documented 841.890 pt");
assert_eq(bayan_pdf_page_size_w(PDF_PAGE_A4), 595000, "pdf: A4 width preset");
assert_eq(bayan_pdf_page_size_h(PDF_PAGE_LETTER), 792000, "pdf: Letter height preset");

test_group("pdf: WinAnsi transcoding — what mneme silently mangles");
var pdf_st[16];
# mneme emits raw UTF-8 into a font with no /Encoding, so "e-acute" renders as
# two StandardEncoding glyphs and an em-dash vanishes entirely.
var pdf_eacute = bayan_pdf_winansi(str_from("caf\xc3\xa9"), PDF_WINANSI_STRICT, &pdf_st);
assert_eq(str_len(pdf_eacute), 4, "pdf: 'cafe-acute' is 4 WinAnsi bytes, not 5 UTF-8 ones");
assert_eq(load8(str_data(pdf_eacute) + 3), 233, "pdf: e-acute is the single byte 0xE9");
assert_eq(str_eq_cstr(bayan_pdf_from_winansi(pdf_eacute), "caf\xc3\xa9"), 1, "pdf: and it decodes back to UTF-8");
var pdf_emdash = bayan_pdf_winansi(str_from("\xe2\x80\x94"), PDF_WINANSI_STRICT, &pdf_st);
assert_eq(load8(str_data(pdf_emdash)), 151, "pdf: an em-dash is WinAnsi 0x97, not three raw bytes");
var pdf_euro = bayan_pdf_winansi(str_from("\xe2\x82\xac"), PDF_WINANSI_STRICT, &pdf_st);
assert_eq(load8(str_data(pdf_euro)), 128, "pdf: the Euro sign is WinAnsi 0x80");
assert_eq(bayan_pdf_winansi_ok(str_from("plain ascii")), 1, "pdf: ASCII is always representable");
assert_eq(bayan_pdf_winansi_ok(str_from("\xe4\xb8\x80")), 0,
  "pdf: a CJK codepoint is NOT representable in WinAnsi");
assert_eq(bayan_pdf_winansi(str_from("\xe4\xb8\x80"), PDF_WINANSI_STRICT, &pdf_st), 0,
  "pdf: STRICT rejects it loudly rather than emitting a wrong glyph");
var pdf_sub = bayan_pdf_winansi(str_from("\xe4\xb8\x80"), PDF_WINANSI_SUBSTITUTE, &pdf_st);
assert_eq(load8(str_data(pdf_sub)), 63, "pdf: SUBSTITUTE emits '?' instead");

test_group("pdf: object model");
assert_eq(bayan_pdf_obj_tag(0), 0 - 1, "pdf: a null cell reports tag -1, it does not abort");
assert_eq(bayan_pdf_obj_tag(bayan_pdf_obj_null()), PTAG_NULL, "pdf: null");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_int_new(42)), 42, "pdf: an integer");
assert_eq(bayan_pdf_obj_bool_value(bayan_pdf_obj_bool_new(1)), 1, "pdf: a boolean");
# A real is (scaled, places) so parse and emit are exact inverses; PDF has no
# exponent form, which is why bayan_f64_to_json is unusable here.
var pdf_real = bayan_pdf_obj_real_new(50, 2);
assert_eq(bayan_pdf_obj_real_scaled(pdf_real), 50, "pdf: a real keeps its scaled integer");
assert_eq(bayan_pdf_obj_real_places(pdf_real), 2, "pdf: and its decimal places");
assert_eq(bayan_pdf_obj_num_mpt(pdf_real), 500, "pdf: 0.50 is 500 milli-points");
assert_eq(bayan_pdf_obj_num_mpt(bayan_pdf_obj_int_new(72)), 72000, "pdf: the integer 72 is 72000 mpt");
assert_eq(str_eq_cstr(bayan_pdf_obj_name(bayan_pdf_obj_name_new("Catalog")), "Catalog"), 1, "pdf: a name");
assert_eq(bayan_pdf_obj_ref_num(bayan_pdf_obj_ref_new(3, 0)), 3, "pdf: an indirect reference");
var pdf_arr = bayan_pdf_obj_array_new();
bayan_pdf_obj_array_push(pdf_arr, bayan_pdf_obj_int_new(7));
assert_eq(bayan_pdf_obj_array_len(pdf_arr), 1, "pdf: an array grows");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_array_get(pdf_arr, 0)), 7, "pdf: and indexes");
# Out-of-range access must return 0, NOT abort — vec_get exits the process on
# an out-of-range index and these indices come from untrusted input.
assert_eq(bayan_pdf_obj_array_get(pdf_arr, 99), 0, "pdf: an out-of-range index returns 0, never exits");
var pdf_dict = bayan_pdf_obj_dict_new();
bayan_pdf_obj_dict_set(pdf_dict, "Type", bayan_pdf_obj_name_new("Page"));
assert_eq(bayan_pdf_obj_dict_len(pdf_dict), 1, "pdf: a dict grows");
assert_eq(bayan_pdf_obj_name_eq(bayan_pdf_obj_dict_get(pdf_dict, "Type"), "Page"), 1, "pdf: and looks up by name");
assert_eq(bayan_pdf_obj_dict_get(pdf_dict, "Missing"), 0, "pdf: a missing key is 0");
# Accessors called on the WRONG tag return a neutral value rather than aborting.
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_name_new("X")), 0, "pdf: int_value on a name is 0");
assert_eq(bayan_pdf_obj_array_len(pdf_dict), 0 - 1,
  "pdf: array_len on a dict is -1, which an empty array can never be");
assert_eq(bayan_pdf_obj_is_dict(pdf_dict), 1, "pdf: is_dict");
assert_eq(bayan_pdf_obj_is_array(pdf_arr), 1, "pdf: is_array");

test_group("pdf: object grammar — parse and serialise are inverses");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_parse_buf("42", 2)), 42, "pdf: parse an integer");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_parse_buf("-17", 3)), 0 - 17, "pdf: a negative integer");
assert_eq(str_eq_cstr(bayan_pdf_obj_name(bayan_pdf_obj_parse_buf("/A#20B", 6)), "A B"), 1, "pdf: #xx in a name resolves");
assert_eq(str_eq_cstr(bayan_pdf_obj_bytes(bayan_pdf_obj_parse_buf("<48656C6C6F>", 12)), "Hello"), 1, "pdf: a hex string");
assert_eq(str_eq_cstr(bayan_pdf_obj_bytes(bayan_pdf_obj_parse_buf("(a\\(b\\)c)", 9)), "a(b)c"), 1, "pdf: escaped parens");
# "1 0 R" and the two integers "1 0" are lexically identical up to the third
# token; only backtracking tells them apart.
assert_eq(bayan_pdf_obj_is_ref(bayan_pdf_obj_parse_buf("1 0 R", 5)), 1, "pdf: 1 0 R is a reference");
assert_eq(bayan_pdf_obj_array_len(bayan_pdf_obj_parse_buf("[1 0]", 5)), 2, "pdf: [1 0] is two integers");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_parse_buf("1 0 Rx", 6)), 1,
  "pdf: 1 0 Rx is NOT a reference — R must be followed by a delimiter");
assert_eq(bayan_pdf_obj_array_len(bayan_pdf_obj_parse_buf("[1 % c\n2]", 9)), 2, "pdf: comments are skipped");
# Token-exact round trip: "0.50" must not normalise to "0.5".
assert_eq(str_eq_cstr(bayan_pdf_obj_to_bytes(bayan_pdf_obj_parse_buf("0.50", 4)), "0.50"), 1,
  "pdf: a real round-trips token-exact, keeping its trailing zero");
assert_eq(str_eq_cstr(bayan_pdf_obj_to_bytes(bayan_pdf_obj_parse_buf("-0.000016", 9)), "-0.000016"), 1,
  "pdf: and a negative real does not emit the '-13.-200' shape truncation produces");
assert_eq(str_eq_cstr(bayan_pdf_obj_to_bytes(bayan_pdf_obj_ref_new(1, 0)), "1 0 R"), 1, "pdf: a reference serialises");
assert_eq(str_eq_cstr(bayan_pdf_obj_to_bytes(bayan_pdf_obj_name_new("A B")), "/A#20B"), 1, "pdf: a name re-escapes");
assert_eq(bayan_pdf_obj_eq(bayan_pdf_obj_parse_buf("[1 2]", 5), bayan_pdf_obj_parse_buf("[1 2]", 5)), 1,
  "pdf: structural equality");
assert_eq(bayan_pdf_obj_eq(bayan_pdf_obj_parse_buf("[1 2]", 5), bayan_pdf_obj_parse_buf("[1 3]", 5)), 0,
  "pdf: and inequality");

test_group("pdf: loud rejection — never a silent mis-parse");
assert_eq(bayan_pdf_obj_parse_buf("(unterminated", 13), 0, "pdf: an unterminated string is rejected");
assert_eq(bayan_pdf_obj_parse_buf("[1 2", 4), 0, "pdf: an unterminated array is rejected");
assert_eq(bayan_pdf_obj_parse_buf("<<1 2>>", 7), 0, "pdf: a dict key that is not a name is rejected");
assert_eq(bayan_pdf_obj_parse_buf("1.2.3", 5), 0, "pdf: a malformed number is rejected");
assert_eq(bayan_pdf_obj_parse_buf("42e5", 4), 0, "pdf: PDF has no exponent form, so this is rejected");
assert_gt(strlen(bayan_pdf_last_error()), 0, "pdf: a rejection leaves a message, not silence");

test_group("pdf: writer — the whole pipeline in-language");
var pdf_doc = bayan_pdf_new();
assert_neq(pdf_doc, 0, "pdf: a document is created");
var pdf_pg = bayan_pdf_add_page(pdf_doc, bayan_pdf_page_size_w(PDF_PAGE_A4), bayan_pdf_page_size_h(PDF_PAGE_A4));
assert_neq(pdf_pg, 0, "pdf: a page is added");
assert_eq(bayan_pdf_page_count(pdf_doc), 1, "pdf: the document knows its page count");
bayan_pdf_set_info(pdf_doc, "Title", str_from("test"));
bayan_pdf_text_at(pdf_pg, PDF_FONT_HELVETICA, 12000, 72000, 720000, str_from("Hello"));
bayan_pdf_rect(pdf_pg, 10000, 20000, 30000, 40000);
bayan_pdf_fill(pdf_pg);
var pdf_bytes = bayan_pdf_to_bytes(pdf_doc);
assert_gt(str_len(pdf_bytes), 400, "pdf: it serialises to a plausible size");
assert_eq(memeq(str_data(pdf_bytes), "%PDF-1.", 7), 1, "pdf: with a PDF header");
assert_eq(bayan_pdf_doc_error_count(pdf_doc), 0, "pdf: and no writer error");
# Deterministic output is what makes a byte-comparison gate possible at all.
assert_eq(str_eq(bayan_pdf_to_bytes(pdf_doc), pdf_bytes), 1, "pdf: serialisation is deterministic");

test_group("pdf: writer refuses what it cannot emit correctly");
# mneme silently DROPS a newline inside show-text. A newline means "break the
# run", so accepting one and deleting it is a silent content change.
assert_eq(bayan_pdf_text_show(pdf_pg, str_from("a\nb")), 0 - 1,
  "pdf: a newline inside show-text is rejected, not silently dropped");
var pdf_doc2 = bayan_pdf_new();
assert_eq(str_len(bayan_pdf_to_bytes(pdf_doc2)), 0, "pdf: a document with no pages will not serialise");
assert_gt(strlen(bayan_pdf_doc_error(pdf_doc2)), 0, "pdf: and it says why");

test_group("pdf: writer -> reader round trip");
var pdf_rt = bayan_pdf_parse(pdf_bytes);
assert_neq(pdf_rt, 0, "pdf: our own output parses back");
assert_eq(bayan_pdf_page_count(pdf_rt), 1, "pdf: with the right page count");
assert_eq(bayan_pdf_is_encrypted(pdf_rt), 0, "pdf: and is not encrypted");
assert_neq(bayan_pdf_catalog(pdf_rt), 0, "pdf: the catalog resolves");
assert_eq(bayan_pdf_obj_name_eq(bayan_pdf_obj_dict_get(bayan_pdf_catalog(pdf_rt), "Type"), "Catalog"), 1,
  "pdf: and is a /Catalog");
assert_eq(str_contains_cstr(bayan_pdf_extract_text(pdf_rt), "Hello"), 1,
  "pdf: the text we wrote comes back out");
var pdf_mb: i64[4];
bayan_pdf_page_media_box(bayan_pdf_page(pdf_rt, 0), &pdf_mb);
assert_eq(load64(&pdf_mb + 16), 595000, "pdf: the page reports A4 width in mpt");

test_group("pdf: reader — fixtures on disk");
var pdf_good = bayan_pdf_parse_file("tests/fixtures/pdf/ref-good.pdf");
assert_neq(pdf_good, 0, "pdf: a classic-xref file parses");
assert_eq(bayan_pdf_page_count(pdf_good), 1, "pdf: one page");
assert_eq(str_contains_cstr(bayan_pdf_extract_text(pdf_good), "Hello bayan"), 1, "pdf: its text extracts");
assert_eq(str_contains_cstr(bayan_pdf_extract_text(pdf_good), "(parens)"), 1,
  "pdf: escaped parens survive the round trip");
assert_eq(bayan_pdf_page_count(bayan_pdf_parse_file("tests/fixtures/pdf/ref-3page.pdf")), 3,
  "pdf: a three-page file walks the page tree");
# PDF 1.5: a cross-reference STREAM, objects inside an object STREAM, and a PNG
# predictor. None of that exists in the classic form.
# A 1.5 cross-reference stream is ITSELF Flate-compressed, so with no inflate
# hook installed the file is unreadable. It must say so rather than present a
# half-loaded document. tests/pdf_flate.tcyr installs the hook and asserts the
# success path on this same file.
assert_eq(bayan_pdf_parse_file("tests/fixtures/pdf/ref-15-objstm.pdf"), 0,
  "pdf: a 1.5 xref stream without an inflate hook is refused, not half-loaded");
assert_gt(strlen(bayan_pdf_last_error()), 0, "pdf: and the refusal names the missing hook");

test_group("pdf: text decoding — /Differences, base encodings, /ToUnicode");
# Every one of these decoded as raw WinAnsi through 1.5.0, which is right for
# the fourth case and mojibake for the first three.
var pdf_enc = bayan_pdf_parse_file("tests/fixtures/pdf/ref-enc-simple.pdf");
assert_neq(pdf_enc, 0, "pdf: a file carrying three different encodings parses");
var pdf_enc_txt = bayan_pdf_extract_text(pdf_enc);
assert_eq(str_contains_cstr(pdf_enc_txt, "\xc3\xa9\xc3\x9f\xe2\x82\xac ABC \xef\xac\x81"), 1,
  "pdf: /Encoding /Differences remaps codes through their glyph names");
assert_eq(str_contains_cstr(pdf_enc_txt, "\xc3\xa9\xe2\x80\xa2\xe2\x80\x93\xc2\xa4"), 1,
  "pdf: /MacRomanEncoding decodes its high half — 0xDB is currency, not the euro");
assert_eq(str_contains_cstr(pdf_enc_txt, "\xe2\x80\x99q\xe2\x80\x98 \xe2\x80\x94 \xef\xac\x81\xef\xac\x82"), 1,
  "pdf: /StandardEncoding differs from ASCII below 0x80 and is followed there");
assert_eq(bayan_pdf_doc_error_count(pdf_enc), 0, "pdf: and none of that warns");

var pdf_t0 = bayan_pdf_parse_file("tests/fixtures/pdf/ref-enc-type0.pdf");
assert_neq(pdf_t0, 0, "pdf: an Identity-H composite-font file parses");
var pdf_t0_txt = bayan_pdf_extract_text(pdf_t0);
assert_eq(str_contains_cstr(pdf_t0_txt, "ABC A"), 1,
  "pdf: a /ToUnicode bfrange maps consecutive CIDs");
assert_eq(str_contains_cstr(pdf_t0_txt, "\xef\xac\x81X\xf0\x9f\x98\x80YZ J"), 1,
  "pdf: a bfchar ligature, a bfrange array, a surrogate pair and a two-codepoint destination all land");
assert_eq(bayan_pdf_doc_error_count(pdf_t0), 0,
  "pdf: a Type0 font that carries a CMap no longer warns");

var pdf_nocmap = bayan_pdf_parse_file("tests/fixtures/pdf/ref-enc-nocmap.pdf");
assert_neq(pdf_nocmap, 0, "pdf: a Type0 file with no /ToUnicode still parses");
assert_eq(str_len(bayan_pdf_extract_text(pdf_nocmap)), 0,
  "pdf: but its CIDs produce NOTHING — a loud mis-parse is still a mis-parse");
assert_gt(bayan_pdf_doc_error_count(pdf_nocmap), 0, "pdf: and the document says why");

test_group("pdf: reader rejects corrupt cross-references loudly");
# poppler and mupdf recover these by rescanning for "N 0 obj". That hides
# exactly the byte-accounting bugs this reader exists to refuse.
assert_eq(bayan_pdf_parse_file("tests/fixtures/pdf/bad-xref.pdf"), 0,
  "pdf: an xref offset pointing at the wrong object is rejected");
assert_gt(strlen(bayan_pdf_last_error()), 0, "pdf: and names the failure");
assert_eq(bayan_pdf_parse_file("tests/fixtures/pdf/bad-size.pdf"), 0,
  "pdf: a trailer /Size that does not exceed the highest object number is rejected");
# A wrong /Length is only reachable when the stream is read, so the failure
# surfaces on content access rather than at parse time — but it does surface.
var pdf_badlen = bayan_pdf_parse_file("tests/fixtures/pdf/bad-length.pdf");
assert_neq(pdf_badlen, 0, "pdf: a bad /Length does not stop the xref from loading");
bayan_pdf_extract_text(pdf_badlen);
assert_gt(bayan_pdf_doc_error_count(pdf_badlen), 0,
  "pdf: but reading the stream reports it rather than returning empty text in silence");

test_group("pdf: Flate hook is absent by default and says so");
assert_eq(bayan_pdf_has_inflate(), 0, "pdf: no inflate hook is installed by default");
assert_eq(bayan_pdf_has_deflate(), 0, "pdf: nor a deflate hook");
var pdf_fl = bayan_pdf_parse_file("tests/fixtures/pdf/ref-flate.pdf");
assert_neq(pdf_fl, 0, "pdf: a Flate file still parses — the xref itself is not compressed");
bayan_pdf_extract_text(pdf_fl);
assert_gt(bayan_pdf_doc_error_count(pdf_fl), 0,
  "pdf: but its compressed content reports the missing hook instead of returning garbage");

test_group("pdf: reentrant per-call parser state");
var pdf_ps1[64];
var pdf_ps2[64];
assert_eq(bayan_pdf_parse_state_size(), 64, "pdf: the state is 64 bytes");
var pdf_o1 = bayan_pdf_obj_parse_ctx_a(default_alloc(), &pdf_ps1, "[1 2 3]", 7);
var pdf_o2 = bayan_pdf_obj_parse_ctx_a(default_alloc(), &pdf_ps2, "(bad", 4);
assert_eq(bayan_pdf_obj_array_len(pdf_o1), 3, "pdf: one parse succeeds");
assert_eq(pdf_o2, 0, "pdf: while a concurrent one fails");
assert_eq(strlen(bayan_pdf_state_error(&pdf_ps1)), 0, "pdf: and the good state stays clean");
assert_gt(strlen(bayan_pdf_state_error(&pdf_ps2)), 0, "pdf: with the error on the failing state only");

test_group("pdf: hardening — defects found by the 1.5.0 adversarial review");
# Each of these was a CONFIRMED, reproduced defect before release, so each
# assertion below is a regression guard with a known failure mode rather than a
# hypothetical. See the CHANGELOG's "Fixed before release" section.

# 1. CRITICAL — /Length near i64 max made `start + n > len` wrap NEGATIVE, so
#    the reach check passed and load8() read ~9.2 exabytes below the buffer.
#    Reproduced as a SIGSEGV from a 428-byte file; the guard now subtracts.
var pdf_huge = bayan_pdf_parse_file("tests/fixtures/pdf/bad-huge-length.pdf");
assert_neq(pdf_huge, 0, "pdf: an absurd /Length does not stop the xref from loading");
bayan_pdf_extract_text(pdf_huge);
assert_gt(bayan_pdf_doc_error_count(pdf_huge), 0,
  "pdf: a near-i64-max /Length is refused rather than dereferenced");
# Reaching this line at all is the assertion: the pre-fix build died here.
assert_eq(1, 1, "pdf: and the process survived reading it");

# 2. The writer's depth cap did not fire through PTAG_STREAM, because the
#    stream arm hard-coded the counter instead of forwarding it, so a stream
#    whose own dict referenced the stream recursed until the stack died.
var pdf_sd = bayan_pdf_obj_dict_new();
var pdf_ss = bayan_pdf_obj_stream_new(pdf_sd, str_from("BT ET"));
bayan_pdf_obj_dict_set(pdf_sd, "Self", pdf_ss);
assert_eq(str_len(bayan_pdf_obj_to_bytes(pdf_ss)), 0,
  "pdf: a self-referential stream is refused by the depth cap, not followed");

# 3. The object-stream memo was keyed on the document POINTER alone, and
#    alloc_reset() recycles document addresses, so a second document could be
#    served a freed record. Parsing twice with the same shapes must agree.
var pdf_o1 = bayan_pdf_parse_file("tests/fixtures/pdf/ref-good.pdf");
var pdf_t1 = bayan_pdf_extract_text(pdf_o1);
var pdf_o2 = bayan_pdf_parse_file("tests/fixtures/pdf/ref-good.pdf");
var pdf_t2 = bayan_pdf_extract_text(pdf_o2);
assert_eq(str_eq(pdf_t1, pdf_t2), 1,
  "pdf: two documents parsed in sequence do not share cached state");
assert_neq(bayan_pdf_page(pdf_o2, 0), 0, "pdf: and the second one is intact");

# =============================================================================
# csv / bigint / cyml (v1.5.1)
#
# These three modules were carved out of cyrius's stdlib at 1.0.0 and, until
# now, were referenced by NO test in bayan's own suite — their coverage still
# lived upstream. The 1.5.1 sweep found two heap buffer overflows in csv.cyr in
# the first hour of actually looking, which is what an untested carved module
# costs. bayan owns these now.
# =============================================================================

test_group("csv: fields are bounded (v1.5.1 — was a heap overflow)");
var csv_f = bayan_csv_parse_line("a,b,c");
assert_eq(vec_len(csv_f), 3, "csv: three fields");
assert_eq(streq(vec_get(csv_f, 0), "a"), 1, "csv: first field");
assert_eq(streq(vec_get(csv_f, 2), "c"), 1, "csv: last field");
var csv_q = bayan_csv_parse_line("\"a,b\",c");
assert_eq(vec_len(csv_q), 2, "csv: a comma inside quotes does not split");
assert_eq(streq(vec_get(csv_q, 0), "a,b"), 1, "csv: quoted field keeps its comma");
var csv_e = bayan_csv_parse_line("\"a\"\"b\",c");
assert_eq(streq(vec_get(csv_e, 0), "a\"b"), 1, "csv: a doubled quote is one quote");

# THE REGRESSION. Each field used to get a fixed alloc(1024) filled one byte
# per input byte with no bound: a 4000-byte field wrote 2976 bytes past the end
# of its allocation with attacker-controlled content. A field can never exceed
# its line, so the buffer is now sized from the line and copied out exactly.
var csv_big = str_builder_new();
var csv_i = 0;
while (csv_i < 4000) { str_builder_putc(csv_big, 65); csv_i = csv_i + 1; }
var csv_long = str_data(str_builder_build(csv_big));
var csv_lf = bayan_csv_parse_line(csv_long);
assert_eq(vec_len(csv_lf), 1, "csv: a 4000-byte field is one field");
assert_eq(strlen(vec_get(csv_lf, 0)), 4000, "csv: and survives at full length");
# Any byte of the input pattern appearing in a block allocated afterwards is a
# byte the parser wrote past its own allocation.
var csv_probe = alloc(8192);
var csv_stray = 0;
csv_i = 0;
while (csv_i < 8192) {
    if (load8(csv_probe + csv_i) == 65) { csv_stray = csv_stray + 1; }
    csv_i = csv_i + 1;
}
assert_eq(csv_stray, 0, "csv: nothing was written past the parser's allocations");

test_group("csv: escaping and the write side (v1.5.1 — was a second overflow)");
assert_eq(streq(bayan_csv_escape("plain"), "plain"), 1, "csv: a plain field is not quoted");
assert_eq(streq(bayan_csv_escape("has,comma"), "\"has,comma\""), 1, "csv: a comma forces quoting");
assert_eq(streq(bayan_csv_escape("has\"quote"), "\"has\"\"quote\""), 1, "csv: a quote is doubled");
var csv_row = vec_new();
vec_push(csv_row, "x");
vec_push(csv_row, "y,z");
assert_eq(streq(bayan_csv_write_line(csv_row), "x,\"y,z\"\n"), 1, "csv: a row round-trips");
# The writer used a fixed alloc(4096) and memcpy'd unbounded into it.
var csv_wide = vec_new();
var csv_cell = alloc(501);
csv_i = 0;
while (csv_i < 500) { store8(csv_cell + csv_i, 66); csv_i = csv_i + 1; }
store8(csv_cell + 500, 0);
csv_i = 0;
while (csv_i < 20) { vec_push(csv_wide, csv_cell); csv_i = csv_i + 1; }
var csv_out = bayan_csv_write_line(csv_wide);
assert_eq(strlen(csv_out), 20 * 500 + 19 + 1, "csv: a 10 KB row is written whole");
var csv_probe2 = alloc(16384);
csv_stray = 0;
csv_i = 0;
while (csv_i < 16384) {
    if (load8(csv_probe2 + csv_i) == 66) { csv_stray = csv_stray + 1; }
    csv_i = csv_i + 1;
}
assert_eq(csv_stray, 0, "csv: nor past the writer's allocation");

test_group("bigint: u256 arithmetic (v1.5.1 — first tests in bayan)");
var bi_z = bayan_u256_zero();
assert_eq(bayan_u256_is_zero(bi_z), 1, "u256: zero is zero");
var bi_a = bayan_u256_from(12345);
var bi_b = bayan_u256_from(54321);
assert_eq(bayan_u256_is_zero(bi_a), 0, "u256: a non-zero value is not zero");
assert_eq(bayan_u256_limb(bi_a, 0), 12345, "u256: the low limb holds the value");
assert_eq(bayan_u256_cmp(bi_a, bi_b), 0 - 1, "u256: 12345 < 54321");
assert_eq(bayan_u256_cmp(bi_b, bi_a), 1, "u256: and the reverse");
assert_eq(bayan_u256_eq(bi_a, bayan_u256_from(12345)), 1, "u256: equality");
var bi_r = bayan_u256_zero();
bayan_u256_add(bi_r, bi_a, bi_b);
assert_eq(bayan_u256_limb(bi_r, 0), 66666, "u256: add");
bayan_u256_sub(bi_r, bi_b, bi_a);
assert_eq(bayan_u256_limb(bi_r, 0), 41976, "u256: sub");
bayan_u256_mul(bi_r, bayan_u256_from(1000), bayan_u256_from(1000));
assert_eq(bayan_u256_limb(bi_r, 0), 1000000, "u256: mul");
# A carry across the 64-bit limb boundary is the thing a 256-bit type exists
# for, so it is the thing worth asserting.
var bi_max = bayan_u256_zero();
bayan_u256_set_limb(bi_max, 0, 0 - 1);          # limb0 = 0xFFFF...FF
bayan_u256_add(bi_r, bi_max, bayan_u256_from(1));
assert_eq(bayan_u256_limb(bi_r, 0), 0, "u256: adding 1 to a full limb wraps it to 0");
assert_eq(bayan_u256_limb(bi_r, 1), 1, "u256: and carries into the next limb");
bayan_u256_shl1(bi_r, bayan_u256_from(1));
assert_eq(bayan_u256_limb(bi_r, 0), 2, "u256: shift left by one");
bayan_u256_shr1(bi_r, bayan_u256_from(4));
assert_eq(bayan_u256_limb(bi_r, 0), 2, "u256: shift right by one");
bayan_u256_mod(bi_r, bayan_u256_from(17), bayan_u256_from(5));
assert_eq(bayan_u256_limb(bi_r, 0), 2, "u256: 17 mod 5");
bayan_u256_addmod(bi_r, bayan_u256_from(7), bayan_u256_from(9), bayan_u256_from(10));
assert_eq(bayan_u256_limb(bi_r, 0), 6, "u256: (7+9) mod 10");
bayan_u256_mulmod(bi_r, bayan_u256_from(7), bayan_u256_from(9), bayan_u256_from(10));
assert_eq(bayan_u256_limb(bi_r, 0), 3, "u256: (7*9) mod 10");
assert_eq(bayan_u256_eq(bayan_u256_from_hex(bayan_u256_to_hex(bayan_u256_from(48879))),
    bayan_u256_from(48879)), 1, "u256: hex round-trips");

test_group("cyml: the manifest parser (v1.5.1 — first tests in bayan)");
# CYML is TOML above `---`, markdown below; multi-entry files use [[entries]]
# markers with a per-entry header and body.
var cy_src = "title = \"demo\"\n[[entries]]\nkey = \"a\"\n---\nbody A\n[[entries]]\nkey = \"b\"\n---\nbody B\n";
var cy_doc = bayan_cyml_parse(cy_src, strlen(cy_src));
assert_neq(cy_doc, 0, "cyml: a document parses");
assert_eq(bayan_cyml_doc_entry_count(cy_doc), 2, "cyml: both [[entries]] blocks are found");
assert_gt(bayan_cyml_doc_header_len(cy_doc), 0, "cyml: the header before the first entry is kept");
var cy_e0 = bayan_cyml_doc_entry(cy_doc, 0);
assert_neq(cy_e0, 0, "cyml: the first entry is reachable");
assert_gt(bayan_cyml_entry_body_len(cy_e0), 0, "cyml: and carries a body below its --- delimiter");
assert_gt(bayan_cyml_entry_header_len(cy_e0), 0, "cyml: and a TOML header above it");
# A single-entry file has no [[entries]] marker at all — one header, one body.
var CY_ONE = "k = \"v\"\n---\njust the body\n";
var cy_one = bayan_cyml_parse(CY_ONE, strlen(CY_ONE));
assert_eq(bayan_cyml_doc_entry_count(cy_one), 1,
  "cyml: a file with no [[entries]] marker parses as one header/body entry");
assert_gt(bayan_cyml_entry_body_len(bayan_cyml_doc_entry(cy_one, 0)), 0,
  "cyml: whose body is the text below ---");
# Out-of-range entry access must return 0 rather than abort — vec_get exits the
# process on an out-of-range index, and this index comes from a caller.
assert_eq(bayan_cyml_doc_entry(cy_doc, 99), 0, "cyml: an out-of-range entry is 0, not an abort");
assert_eq(bayan_cyml_doc_entry(cy_doc, 0 - 1), 0, "cyml: a negative index likewise");
assert_eq(bayan_cyml_doc_entry_count(0), 0, "cyml: a null doc reports no entries, it does not fault");
assert_eq(bayan_cyml_doc_entry(0, 0), 0, "cyml: nor does indexing one");
assert_eq(bayan_cyml_entry_body_len(0), 0, "cyml: nor does a null entry");
# THE REGRESSION. The scan used a fixed 256-slot stack array and stopped at
# the 256th marker, so a larger document parsed "successfully" with the
# remainder silently gone — measured: 300 blocks in, 256 reported. The scan is
# now two-pass (count, allocate exactly, fill), so there is no cliff to fall
# off and no fixed stack array to size wrong.
var cy_many = str_builder_new();
var cy_i = 0;
while (cy_i < 300) {
    str_builder_add_cstr(cy_many, "[[entries]]\nk = \"v\"\n---\nbody\n");
    cy_i = cy_i + 1;
}
var cy_ms = str_builder_build(cy_many);
var cy_md = bayan_cyml_parse(str_data(cy_ms), str_len(cy_ms));
assert_eq(bayan_cyml_doc_entry_count(cy_md), 300,
  "cyml: 300 entries parse as 300, not silently truncated to 256");
assert_neq(bayan_cyml_doc_entry(cy_md, 299), 0, "cyml: and the last one is reachable");
assert_eq(bayan_cyml_doc_entry(cy_md, 300), 0, "cyml: while one past the end is still 0");

var cy_empty = bayan_cyml_parse("", 0);
assert_eq(bayan_cyml_doc_entry_count(cy_empty), 0, "cyml: an empty document has no entries");

# =============================================================================
# 1.5.1 P-1 sweep — regression guards
#
# Every assertion below pins a defect that a reproducer CONFIRMED before the
# fix. They are grouped by the module they were found in, not by severity, so
# the next person auditing a module sees what already went wrong in it.
# =============================================================================

test_group("json: string buffers are sized from the string, not the document");
# Sizing the decode buffer from the REMAINING DOCUMENT made heap use quadratic:
# 40 KB of input took 200 MB, and 1 MB took 125 GB / 46 GB RSS. Both parsers
# shared the helper, so the streaming parser — whose whole purpose is bounded
# memory — was the most quadratic path in the module.
var jq_sb = str_builder_new();
str_builder_putc(jq_sb, 91);
var jq_i = 0;
while (jq_i < 2000) {
    if (jq_i > 0) { str_builder_putc(jq_sb, 44); }
    str_builder_add_cstr(jq_sb, "\"a\"");
    jq_i = jq_i + 1;
}
str_builder_putc(jq_sb, 93);
var jq_doc = str_builder_build(jq_sb);
var jq_before = alloc_used();
var jq_v = bayan_json_v_parse_buf(str_data(jq_doc), str_len(jq_doc));
var jq_used = alloc_used() - jq_before;
assert_eq(bayan_json_v_arr_len(jq_v), 2000, "json: the array parses");
# Pre-fix this ratio grew without bound (66x at 400 B, 5018x at 40 KB). A flat
# ceiling is the property; 64x leaves generous headroom over the ~16x measured.
assert_lt(jq_used / str_len(jq_doc), 64,
  "json: heap stays proportional to input, not to input squared");

test_group("json: numbers are validated, not merely scanned");
assert_eq(bayan_json_v_parse_buf("-", 1), 0, "json: a lone minus is not the integer 0");
assert_eq(bayan_json_v_parse_buf("1.", 2), 0, "json: a trailing decimal point is rejected");
assert_eq(bayan_json_v_parse_buf("1e", 2), 0, "json: an empty exponent is rejected");
# _jp_atoi wrapped silently, so this came back as -9223372036854775808 — a
# value whose SIGN differs from the document's.
assert_eq(bayan_json_v_parse_buf("9223372036854775808", 19), 0,
  "json: an integer past i64 max is an error, not a sign flip");
assert_eq(bayan_json_v_parse_buf("-9223372036854775809", 20), 0, "json: nor past i64 min");
assert_neq(bayan_json_v_parse_buf("9223372036854775807", 19), 0, "json: i64 max itself still parses");
assert_neq(bayan_json_v_parse_buf("-9223372036854775808", 20), 0, "json: and i64 min");

test_group("json: the flat parser honours escapes (was key injection)");
# The value scan stopped at the first quote regardless of a preceding
# backslash, so a string value could terminate early and the parser
# resynchronised mid-value — deleting the NEXT key entirely. A caller checking
# a permission with bayan_json_get got a silent "not found" that any string
# field could trigger.
var je_doc = "{\"note\":\"hi\\\"there\",\"admin\":\"false\"}";
var je_pairs = bayan_json_parse(str_from(je_doc));
assert_eq(vec_len(je_pairs), 2, "json: an escaped quote does not split the value into a key");
assert_neq(bayan_json_get(je_pairs, str_from("admin")), 0,
  "json: the key after an escaped quote survives");

test_group("json: a JSON-pointer index cannot wrap into range");
var jp_doc = "[\"first\",\"second\",\"third\"]";
var jp_v = bayan_json_v_parse_buf(jp_doc, strlen(jp_doc));
assert_neq(bayan_json_v_pointer(jp_v, str_from("/2")), 0, "json: an in-range pointer resolves");
assert_eq(bayan_json_v_pointer(jp_v, str_from("/3")), 0, "json: one past the end resolves to nothing");
# `n = n * 10 + d` wrapped mod 2^64, so this selected element 2.
assert_eq(bayan_json_v_pointer(jp_v, str_from("/18446744073709551618")), 0,
  "json: an index that overflows i64 selects nothing, not a wrapped element");

test_group("base64: decode validates length and alphabet");
# out_len went negative on a padding-only input, alloc(0) returned 0, and the
# unconditional terminator wrote through address -1. Verified SIGSEGV.
assert_eq(bayan_base64_decode("=", 1), 0, "base64: a lone '=' is refused, not a fault");
assert_eq(bayan_base64_decode("==", 2), 0, "base64: nor two");
assert_eq(bayan_base64_decode("A=", 2), 0, "base64: nor a short group");
# Bytes outside the alphabet decoded as 0xFF filler and produced confident garbage.
assert_eq(bayan_base64_decode("!!!!", 4), 0, "base64: non-alphabet bytes are refused");
var b64_ok = bayan_base64_decode("Zm9v", 4);
assert_neq(b64_ok, 0, "base64: valid input still decodes");
assert_eq(load64(b64_ok + 8), 3, "base64: with the right length");
assert_eq(memeq(load64(b64_ok), "foo", 3), 1, "base64: and the right bytes");

test_group("bigint: u256 multiply propagates carries");
# The three-term inner sum detected overflow with ONE comparison, missing the
# case where lo + carry wrapped on its own: 220 of 400 random 256-bit products
# were wrong, and 53 of 100 mulmods under Curve25519's p. Single-limb inputs
# were all correct, which is why the earlier tests never saw it.
var bm_a = bayan_u256_zero();
bayan_u256_set_limb(bm_a, 0, 0 - 1);              # 2^64 - 1
var bm_b = bayan_u256_zero();
bayan_u256_set_limb(bm_b, 0, 0 - 1);
bayan_u256_set_limb(bm_b, 1, 1);                  # 2^65 - 1
var bm_r = bayan_u256_zero();
bayan_u256_mul(bm_r, bm_a, bm_b);
# (2^64-1)(2^65-1) = 2^129 - 2^65 - 2^64 + 1. Pre-fix this was short by 2^128.
assert_eq(bayan_u256_limb(bm_r, 0), 1, "u256: limb 0 of the cross-limb product");
assert_eq(bayan_u256_limb(bm_r, 2), 1, "u256: limb 2 — the carry that used to vanish");

test_group("bigint: u256_mod terminates and validates");
var bd_r = bayan_u256_zero();
# Repeated subtraction spun forever on p == 0 and needed up to 2^256
# iterations for a small p. Now binary long division: 256 steps, always.
assert_eq(bayan_u256_mod(bd_r, bayan_u256_from(12345), bayan_u256_zero()), 0 - 1,
  "u256: mod by zero is refused instead of looping forever");
var bd_big = bayan_u256_zero();
bayan_u256_set_limb(bd_big, 3, 0 - 1);            # a very large dividend
bayan_u256_mod(bd_r, bd_big, bayan_u256_from(1));
assert_eq(bayan_u256_is_zero(bd_r), 1, "u256: a huge value mod 1 is 0, and returns promptly");
bayan_u256_mod(bd_r, bayan_u256_from(17), bayan_u256_from(5));
assert_eq(bayan_u256_limb(bd_r, 0), 2, "u256: and ordinary reduction still works");

test_group("bigint: from_hex refuses what it cannot represent");
assert_eq(bayan_u256_from_hex("hello world"), 0, "u256: a non-hex string is not a number");
assert_eq(bayan_u256_from_hex("12-34"), 0, "u256: '-' is not a zero digit");
assert_eq(bayan_u256_from_hex(""), 0, "u256: an empty string is not a number");
assert_neq(bayan_u256_from_hex("deadbeef"), 0, "u256: valid hex still parses");
assert_eq(bayan_u256_limb(bayan_u256_from_hex("deadbeef"), 0), 3735928559, "u256: to the right value");

test_group("toml: an unterminated string cannot swallow the next line");
# The scan ran to the end of the DOCUMENT looking for a closing quote, so a
# malformed line absorbed the ones after it and silently deleted their keys.
var tu_secs = bayan_toml_parse(str_from("a = \"oops\nadmin = false\nb = \"x\"\nc = 1\n"));
var tu_pairs = bayan_toml_section_pairs(vec_get(tu_secs, 0));
assert_neq(bayan_toml_get(tu_pairs, "admin"), 0, "toml: the key after an unterminated string survives");
assert_neq(bayan_toml_get(tu_pairs, "c"), 0, "toml: and the one after that");
var tu_ok = bayan_toml_parse(str_from("name = \"demo\"\nport = 8080\n"));
assert_eq(vec_len(bayan_toml_section_pairs(vec_get(tu_ok, 0))), 2, "toml: well-formed input is unaffected");

test_group("cyml: a leading blank line does not hide the first entry");
# _cyml_is_entries only tested for a marker at byte 0 when pos == 0 and then
# returned, so a document beginning with a newline never matched the marker at
# byte 1 — one entry silently folded into the file header.
var cz_a = bayan_cyml_parse("[[entries]]\nid=1\n---\nA\n[[entries]]\nid=2\n---\nB\n", 46);
var cz_src = "\n[[entries]]\nid=1\n---\nA\n[[entries]]\nid=2\n---\nB\n";
var cz_b = bayan_cyml_parse(cz_src, strlen(cz_src));
assert_eq(bayan_cyml_doc_entry_count(cz_b), bayan_cyml_doc_entry_count(cz_a),
  "cyml: a leading newline does not change the entry count");
assert_eq(bayan_cyml_doc_entry_count(cz_b), 2, "cyml: and both entries are found");

test_group("cyml: expansion preserves the text around a reference");
# The old body returned the expansion ALONE, discarding everything before and
# after it: "v${file:VERSION}-beta" became "1.5.0".
var cx = bayan_cyml_expand_value("v${file:VERSION}-beta");
assert_eq(load8(cx), 118, "cyml: the prefix before ${...} survives");
assert_eq(memeq(cx + strlen(cx) - 5, "-beta", 5), 1, "cyml: and the suffix after it");
assert_eq(streq(bayan_cyml_expand_value("plain value"), "plain value"), 1,
  "cyml: a value with no reference is returned unchanged");

test_group("yaml: unrepresentable and duplicate keys are refused");
# Out-of-range integers wrapped silently: uid 18446744073709551616 became 0.
# They now fall through to a string rather than becoming a different number.
var yi = bayan_yaml_parse_buf("k: 18446744073709551616", 23);
assert_eq(bayan_json_v_is_int(bayan_json_v_obj_get(yi, "k")), 0,
  "yaml: an integer past i64 does not come back as a wrong int");
assert_eq(bayan_json_v_is_int(bayan_json_v_obj_get(bayan_yaml_parse_buf("k: 42", 5), "k")), 1,
  "yaml: an in-range integer still types as an int");
# obj_set APPENDS, so bayan resolved duplicates to the FIRST while the
# serialiser emitted both and every JSON reader took the LAST.
assert_eq(bayan_yaml_parse_buf("role: admin\nrole: guest\n", 24), 0,
  "yaml: a duplicate mapping key is rejected, not resolved two different ways");
assert_neq(bayan_yaml_parse_buf("a: 1\nb:\n  a: 2\n", 15), 0,
  "yaml: the same key at different nesting levels is not a duplicate");

# =============================================================================
# u128 / dtoa / toml / base64 (v1.5.2)
#
# The three modules 1.5.1 left thin — u128 (3/35 functions referenced), toml
# (6/17) and dtoa (2/3) — plus base64 (2/4). The bulk of the numeric coverage
# is VECTOR-DRIVEN from tests/fixtures/numeric/, whose expected values come
# from Python's arbitrary-precision integers and its shortest-round-trip float
# formatter. Checking an implementation against itself proves only
# self-consistency; that is how u256_mul shipped for five releases with 46% of
# its products wrong. Regenerate with scripts/gen-numeric-vectors.py.
#
# The vector RUNNERS live in tests/vectors.tcyr — 12,334 u128 checks and 656
# f64 checks would swamp this file's assert counts. What follows pins the
# behaviours a vector file cannot express.
# =============================================================================

test_group("u128: construction, accessors and comparison (v1.5.2)");
var u_a[16]; var u_b[16]; var u_r[16]; var u_q[16]; var u_m[16];
bayan_u128_set(&u_a, 5, 0);
assert_eq(bayan_u128_lo(&u_a), 5, "u128: set/lo");
assert_eq(bayan_u128_hi(&u_a), 0, "u128: set/hi");
bayan_u128_from_u64(&u_b, 5);
assert_eq(bayan_u128_eq(&u_a, &u_b), 1, "u128: from_u64 matches set");
assert_eq(bayan_u128_is_zero(&u_a), 0, "u128: 5 is not zero");
bayan_u128_set(&u_r, 0, 0);
assert_eq(bayan_u128_is_zero(&u_r), 1, "u128: zero is zero");
bayan_u128_copy(&u_r, &u_a);
assert_eq(bayan_u128_eq(&u_r, &u_a), 1, "u128: copy");
# The unsigned comparisons are the classic signed/unsigned trap: a value with
# bit 63 set in the low limb reads as negative under a signed compare.
bayan_u128_set(&u_a, 1, 0);
bayan_u128_set(&u_b, 0 - 1, 0);              # 2^64 - 1, "negative" as i64
assert_eq(bayan_u128_ult(&u_a, &u_b), 1, "u128: 1 < 2^64-1 unsigned");
assert_eq(bayan_u128_ugt(&u_b, &u_a), 1, "u128: and the reverse");
assert_eq(bayan_u128_uge(&u_b, &u_b), 1, "u128: uge is reflexive");
assert_eq(bayan_u128_ule(&u_b, &u_b), 1, "u128: ule is reflexive");
assert_eq(bayan_u128_ugt(&u_b, &u_b), 0, "u128: ugt is not");

test_group("u128: the limb boundary (where 128-bit code actually breaks)");
bayan_u128_set(&u_a, 0 - 1, 0);              # 2^64 - 1
bayan_u128_from_u64(&u_b, 1);
bayan_u128_add(&u_r, &u_a, &u_b);
assert_eq(bayan_u128_lo(&u_r), 0, "u128: adding 1 to a full low limb wraps it");
assert_eq(bayan_u128_hi(&u_r), 1, "u128: and carries into the high limb");
bayan_u128_sub(&u_r, &u_r, &u_b);
assert_eq(bayan_u128_lo(&u_r), 0 - 1, "u128: subtracting borrows back down");
assert_eq(bayan_u128_hi(&u_r), 0, "u128: leaving the high limb clear");
# A shift count at or past the width: hardware shift instructions take the
# count modulo the width, so this is where fixed-width shift code goes wrong.
bayan_u128_from_u64(&u_a, 1);
bayan_u128_shl(&u_r, &u_a, 64);
assert_eq(bayan_u128_hi(&u_r), 1, "u128: shl 64 moves bit 0 to the high limb");
assert_eq(bayan_u128_lo(&u_r), 0, "u128: clearing the low limb");
bayan_u128_shl(&u_r, &u_a, 128);
assert_eq(bayan_u128_is_zero(&u_r), 1, "u128: shl by the full width is zero, not a no-op");
bayan_u128_shl(&u_r, &u_a, 200);
assert_eq(bayan_u128_is_zero(&u_r), 1, "u128: nor does an over-wide shift wrap around");
bayan_u128_set(&u_a, 0, 1);                  # 2^64
bayan_u128_shr(&u_r, &u_a, 64);
assert_eq(bayan_u128_lo(&u_r), 1, "u128: shr 64 brings the high limb down");
bayan_u128_shr(&u_r, &u_a, 128);
assert_eq(bayan_u128_is_zero(&u_r), 1, "u128: shr by the full width is zero");

test_group("u128: division and modular arithmetic");
bayan_u128_from_u64(&u_a, 17);
bayan_u128_from_u64(&u_b, 5);
bayan_u128_divmod(&u_q, &u_m, &u_a, &u_b);
assert_eq(bayan_u128_lo(&u_q), 3, "u128: 17/5 quotient");
assert_eq(bayan_u128_lo(&u_m), 2, "u128: 17%5 remainder");
bayan_u128_div(&u_r, &u_a, &u_b);
assert_eq(bayan_u128_lo(&u_r), 3, "u128: div agrees with divmod");
bayan_u128_mod(&u_r, &u_a, &u_b);
assert_eq(bayan_u128_lo(&u_r), 2, "u128: mod agrees with divmod");
bayan_u128_copy(&u_r, &u_a); bayan_u128_diveq(&u_r, &u_b);
assert_eq(bayan_u128_lo(&u_r), 3, "u128: diveq");
bayan_u128_copy(&u_r, &u_a); bayan_u128_modeq(&u_r, &u_b);
assert_eq(bayan_u128_lo(&u_r), 2, "u128: modeq");

test_group("u128: u64_mulmod no longer kills the process (v1.5.2)");
# x86's DIV raises #DE when the QUOTIENT does not fit in 64 bits, not only on a
# zero divisor. With unreduced 64-bit operands over a 31-bit modulus the
# quotient wants ~97 bits, and the process took SIGFPE. Worse, aarch64 went
# through the u128 pipeline and returned the right answer, so the two targets
# disagreed about what an unreduced call did. Measured killer:
#   mulmod(0xfdec65fe72129737, 0x93548b905e5c7474, 0x7222d728)
# 0xfdec65fe72129737 has bit 63 set, so it is also the signed-`%` trap.
assert_eq(bayan_u64_mulmod(7, 9, 10), 3, "u64: mulmod on reduced operands");
assert_eq(bayan_u64_mulmod(1000000, 1000000, 1000000007), 999993007,
  "u64: mulmod with an unreduced product");
assert_eq(bayan_u64_mulmod(0, 12345, 7), 0, "u64: mulmod by zero");
assert_eq(bayan_u64_mulmod(12345, 6789, 1), 0, "u64: any product mod 1 is 0");
assert_eq(bayan_u64_mulmod(5, 5, 0), 0, "u64: a zero modulus returns 0 instead of faulting");
assert_eq(bayan_u64_powmod(3, 5, 7), 5, "u64: powmod 3^5 mod 7");
assert_eq(bayan_u64_powmod(2, 10, 1000), 24, "u64: powmod 2^10 mod 1000");
assert_eq(bayan_u64_powmod(12345, 0, 97), 1, "u64: anything to the zero power is 1");
assert_eq(bayan_u64_powmod(3, 5, 0), 0, "u64: powmod with a zero modulus returns 0");
assert_eq(bayan_u64_powmod(3, 5, 1), 0, "u64: and mod 1 is 0");

test_group("dtoa: floats round-trip through JSON text (v1.5.2)");
var d_buf = alloc(64);
# The property that matters is that formatting then parsing returns the
# IDENTICAL bits. Grisu2 is documented as shortest-or-NEAR-shortest, so the
# text itself is not required to match another implementation's byte for byte.
var d_n = bayan_f64_to_json(4614256656552045848, d_buf);      # 3.141592653589793
store8(d_buf + d_n, 0);
assert_eq(bayan_f64_parse(d_buf, d_n), 4614256656552045848, "dtoa: pi round-trips");
d_n = bayan_f64_to_json(4607182418800017408, d_buf);          # 1.0
store8(d_buf + d_n, 0);
assert_eq(streq(d_buf, "1.0"), 1, "dtoa: 1.0 formats as 1.0");
assert_eq(bayan_f64_parse("0.1", 3), 4591870180066957722, "dtoa: 0.1 parses to the right bits");
assert_eq(bayan_f64_parse("1e308", 5), 9214871658872686752, "dtoa: 1e308");
assert_eq(bayan_f64_parse("5e-324", 6), 1, "dtoa: the smallest denormal is bit pattern 1");
assert_eq(bayan_f64_from_json("2.5"), 4612811918334230528, "dtoa: the cstring entry agrees");
# Non-finite values have no JSON representation; the module emits null.
d_n = bayan_f64_to_json(9218868437227405312, d_buf);          # +inf
store8(d_buf + d_n, 0);
assert_eq(streq(d_buf, "null"), 1, "dtoa: infinity serialises as null, since JSON has no inf");

test_group("toml: sections, arrays and lookup (v1.5.2)");
var t_doc = "top = 1\nname = \"demo\"\nlist = [1, 2, 3]\nstrs = [\"a\", \"b\"]\n\n[server]\nhost = \"h\"\nport = 80\n\n[[item]]\nid = 1\n\n[[item]]\nid = 2\n";
var t_secs = bayan_toml_parse(str_from(t_doc));
# Cross-checked against Python's tomllib: 4 sections, root has 4 pairs,
# [server] has 2, and there are two [[item]] tables.
assert_eq(vec_len(t_secs), 4, "toml: root + [server] + two [[item]] sections");
var t_root = bayan_toml_section_pairs(vec_get(t_secs, 0));
assert_eq(vec_len(t_root), 4, "toml: the root section's pairs");
assert_eq(str_len(bayan_toml_section_name(vec_get(t_secs, 0))), 0, "toml: the root section is unnamed");
assert_eq(str_eq_cstr(bayan_toml_section_name(vec_get(t_secs, 1)), "server"), 1, "toml: a named section");
assert_eq(vec_len(bayan_toml_get_sections(t_secs, "item")), 2, "toml: both [[item]] tables are found");
assert_eq(vec_len(bayan_toml_get_sections(t_secs, "absent")), 0, "toml: an absent section name gives none");
# bayan_toml_get takes a CSTRING (it compares with str_eq_cstr); passing a Str
# yields a silent not-found. See Known gaps 9.
assert_neq(bayan_toml_get(t_root, "name"), 0, "toml: get finds a key");
assert_eq(bayan_toml_get(t_root, "nope"), 0, "toml: and returns 0 for one that is absent");
assert_eq(str_eq_cstr(bayan_toml_pair_key(vec_get(t_root, 0)), "top"), 1, "toml: pair_key");
assert_neq(bayan_toml_pair_value(vec_get(t_root, 0)), 0, "toml: pair_value");
# Array VALUES are stored verbatim; the element accessors split them.
assert_eq(bayan_toml_is_array(bayan_toml_get(t_root, "list")), 1, "toml: an array value is recognised");
assert_eq(bayan_toml_is_array(bayan_toml_get(t_root, "name")), 0, "toml: a scalar is not");
var t_arr = bayan_toml_get_array(t_root, "list");
assert_eq(vec_len(t_arr), 3, "toml: a numeric array splits into 3 elements");
assert_eq(str_eq_cstr(vec_get(t_arr, 1), "2"), 1, "toml: element 1 is 2");
var t_sarr = bayan_toml_get_array(t_root, "strs");
assert_eq(vec_len(t_sarr), 2, "toml: a string array splits into 2");
assert_eq(str_eq_cstr(vec_get(t_sarr, 0), "a"), 1, "toml: with quotes stripped");
assert_eq(vec_len(bayan_toml_array_parse(bayan_toml_get(t_root, "list"))), 3,
  "toml: array_parse on the raw value agrees");
# Constructors round-trip through the accessors.
var t_p = bayan_toml_pair_new(str_from("k"), str_from("v"));
assert_eq(str_eq_cstr(bayan_toml_pair_key(t_p), "k"), 1, "toml: pair_new/key");
var t_pv = vec_new();
vec_push(t_pv, t_p);
var t_s = bayan_toml_section_new(str_from("sec"), t_pv);
assert_eq(str_eq_cstr(bayan_toml_section_name(t_s), "sec"), 1, "toml: section_new/name");
assert_eq(vec_len(bayan_toml_section_pairs(t_s)), 1, "toml: section_new/pairs");

test_group("base64: the URL-safe alphabet (v1.5.2)");
# base64url swaps + / for - _ and omits padding, so a value that encodes to
# either of those characters is the one that distinguishes the two alphabets.
var b_raw = alloc(3);
store8(b_raw, 255); store8(b_raw + 1, 254); store8(b_raw + 2, 253);
assert_eq(streq(bayan_base64_encode(b_raw, 3), "//79"), 1, "base64: standard uses / and +");
assert_eq(streq(bayan_base64url_encode(b_raw, 3), "__79"), 1, "base64url: uses _ and -");
var b_d = bayan_base64url_decode("__79", 4);
assert_neq(b_d, 0, "base64url: decodes its own output");
assert_eq(load64(b_d + 8), 3, "base64url: to the right length");
assert_eq(load8(load64(b_d)), 255, "base64url: and the right bytes");
# Unpadded input is legal for base64url and must not be refused the way the
# padded standard decoder refuses a non-multiple-of-4 length.
var b_u = bayan_base64url_decode("Zm9v", 4);
assert_eq(load64(b_u + 8), 3, "base64url: a full group");
var b_u2 = bayan_base64url_decode("Zm8", 3);
assert_eq(load64(b_u2 + 8), 2, "base64url: an unpadded partial group is accepted");
assert_eq(bayan_base64url_decode("!!!!", 4), 0, "base64url: non-alphabet bytes are refused");

test_group("toml/bigint/yaml: the last uncovered entry points (v1.5.2)");
# These are the `_a` variants and file loaders — several of which 1.5.1 and
# 1.5.2 CHANGED — so they are exactly the ones that should not have gone
# untested. tests/fixtures/toml/sample.toml's shape is confirmed by Python's
# tomllib: 4 root pairs, [server] with 2, two [[entry]] tables, tags of 3.
var lc_arena = arena_allocator(65536);

var lc_p = bayan_toml_pair_new_a(lc_arena, str_from("k"), str_from("v"));
assert_eq(str_eq_cstr(bayan_toml_pair_key(lc_p), "k"), 1, "toml: pair_new_a");
var lc_pv = vec_new_a(lc_arena);
vec_push_a(lc_arena, lc_pv, lc_p);
var lc_s = bayan_toml_section_new_a(lc_arena, str_from("s"), lc_pv);
assert_eq(str_eq_cstr(bayan_toml_section_name(lc_s), "s"), 1, "toml: section_new_a");

var lc_secs = bayan_toml_parse_file("tests/fixtures/toml/sample.toml");
assert_eq(vec_len(lc_secs), 4, "toml: parse_file reads the fixture's four sections");
var lc_root = bayan_toml_section_pairs(vec_get(lc_secs, 0));
assert_eq(vec_len(lc_root), 4, "toml: with four root pairs");
assert_eq(vec_len(bayan_toml_get_sections(lc_secs, "entry")), 2, "toml: and both [[entry]] tables");
assert_eq(vec_len(bayan_toml_array_parse_a(lc_arena, bayan_toml_get(lc_root, "tags"))), 3,
  "toml: array_parse_a splits the 3-element array");
var lc_r = bayan_toml_parse_file_r("tests/fixtures/toml/sample.toml");
assert_eq(is_err_result(lc_r), 0, "toml: parse_file_r succeeds on a readable file");
assert_eq(vec_len(load64(lc_r + 8)), 4, "toml: and returns the same four sections");
assert_eq(is_err_result(bayan_toml_parse_file_r("tests/fixtures/toml/does-not-exist.toml")), 1,
  "toml: parse_file_r reports a missing file as an error");
assert_eq(vec_len(bayan_toml_parse_file("tests/fixtures/toml/does-not-exist.toml")), 0,
  "toml: while the non-Result form yields no sections");

# 1.5.1 removed a fixed 256 KiB read buffer that TRUNCATED and reported
# success — 1,893 keys silently vanished from a 300 KB file. Write one larger
# than that cap and confirm every key survives. build/ is gitignored.
var lc_sb = str_builder_new();
var lc_i = 0;
while (lc_i < 25000) {
    str_builder_add_cstr(lc_sb, "k");
    str_builder_add_int(lc_sb, lc_i);
    str_builder_add_cstr(lc_sb, " = ");
    str_builder_add_int(lc_sb, lc_i);
    str_builder_putc(lc_sb, 10);
    lc_i = lc_i + 1;
}
var lc_big = str_builder_build(lc_sb);
assert_gt(str_len(lc_big), 262144, "toml: the fixture exceeds the old 256 KiB cap");
file_write_all("build/big-generated.toml", str_data(lc_big), str_len(lc_big));
var lc_bs = bayan_toml_parse_file("build/big-generated.toml");
assert_eq(vec_len(bayan_toml_section_pairs(vec_get(lc_bs, 0))), 25000,
  "toml: a file past the old cap is read WHOLE, not truncated at 256 KiB");
assert_neq(bayan_toml_get(bayan_toml_section_pairs(vec_get(lc_bs, 0)), "k24999"), 0,
  "toml: including its very last key");

var lc_a = bayan_u256_from(123456789);
var lc_b = bayan_u256_zero();
bayan_u256_copy(lc_b, lc_a);
assert_eq(bayan_u256_eq(lc_b, lc_a), 1, "u256: copy");
var lc_c = bayan_u256_clone(lc_a);
assert_eq(bayan_u256_eq(lc_c, lc_a), 1, "u256: clone produces an equal value");
bayan_u256_set_limb(lc_c, 0, 999);
assert_eq(bayan_u256_limb(lc_a, 0), 123456789, "u256: and an independent one — mutating the clone leaves the original");
var lc_sm = bayan_u256_zero();
bayan_u256_submod(lc_sm, bayan_u256_from(3), bayan_u256_from(8), bayan_u256_from(10));
assert_eq(bayan_u256_limb(lc_sm, 0), 5, "u256: submod wraps (3-8) mod 10 to 5, not to a negative");

# 1.5.2 added the missing allocation check here; an exhausted arena used to
# write through a null pointer.
var lc_fm = bayan_yaml_frontmatter_split_a(lc_arena, str_from("---\nk: v\n---\nbody\n"));
assert_neq(lc_fm, 0, "yaml: frontmatter_split_a splits a document");
assert_neq(load64(lc_fm), 0, "yaml: returning the frontmatter half");
var lc_tiny = arena_allocator(16);
alloc_via(lc_tiny, 16);
assert_eq(bayan_yaml_frontmatter_split_a(lc_tiny, str_from("---\nk: v\n---\nb\n")), 0,
  "yaml: and an exhausted arena returns 0 rather than faulting");

test_group("cyml: constructors, split and the Result loader (v1.5.2)");
var cc_a = arena_allocator(16384);
# Entries and docs are built from (ptr, len) spans into the caller's buffer —
# the parser is zero-copy, so the constructors take spans rather than Strs.
var cc_hdr = "k = 1";
var cc_body = "text";
var cc_e = bayan_cyml_entry_new_a(cc_a, cc_hdr, strlen(cc_hdr), cc_body, strlen(cc_body));
assert_neq(cc_e, 0, "cyml: entry_new_a");
assert_eq(bayan_cyml_entry_header_len(cc_e), 5, "cyml: its header span");
assert_eq(bayan_cyml_entry_body_len(cc_e), 4, "cyml: and its body span");
assert_eq(memeq(bayan_cyml_entry_header(cc_e), "k = 1", 5), 1, "cyml: the header points at the source bytes");
var cc_e2 = bayan_cyml_entry_new(cc_hdr, strlen(cc_hdr), cc_body, strlen(cc_body));
assert_eq(bayan_cyml_entry_body_len(cc_e2), 4, "cyml: entry_new (non-_a) agrees");
var cc_d = bayan_cyml_doc_new_a(cc_a);
assert_neq(cc_d, 0, "cyml: doc_new_a");
assert_eq(bayan_cyml_doc_entry_count(cc_d), 0, "cyml: a fresh doc has no entries");
assert_eq(bayan_cyml_doc_entry_count(bayan_cyml_doc_new()), 0, "cyml: doc_new (non-_a) likewise");

# split() is the single-entry convenience: TOML above ---, markdown below.
var cc_src = "a = 1\n---\nthe body\n";
var cc_hp: i64[1]; var cc_hl: i64[1]; var cc_bp: i64[1]; var cc_bl: i64[1];
assert_eq(bayan_cyml_split(cc_src, strlen(cc_src), &cc_hp, &cc_hl, &cc_bp, &cc_bl), 1,
  "cyml: split finds the --- delimiter");
assert_eq(load64(&cc_hl), 5, "cyml: the header is the trimmed text above it");
assert_eq(memeq(load64(&cc_hp), "a = 1", 5), 1, "cyml: pointing into the caller's buffer");
assert_eq(load64(&cc_bl), 8, "cyml: and the body is the text below");
assert_eq(memeq(load64(&cc_bp), "the body", 8), 1, "cyml: also zero-copy");
var cc_nod = "a = 1\nb = 2\n";
assert_eq(bayan_cyml_split(cc_nod, strlen(cc_nod), &cc_hp, &cc_hl, &cc_bp, &cc_bl), 0,
  "cyml: a document with no delimiter reports 0");

var cc_r = bayan_cyml_parse_file_r("tests/fixtures/cyml/sample.cyml");
assert_eq(is_err_result(cc_r), 0, "cyml: parse_file_r reads a real file");
var cc_doc = load64(cc_r + 8);
assert_eq(bayan_cyml_doc_entry_count(cc_doc), 1, "cyml: the single-entry file yields one entry");
assert_gt(bayan_cyml_entry_body_len(bayan_cyml_doc_entry(cc_doc, 0)), 0, "cyml: which carries a body");
assert_neq(bayan_cyml_doc_entries(cc_doc), 0, "cyml: doc_entries exposes the backing array");
assert_eq(is_err_result(bayan_cyml_parse_file_r("tests/fixtures/cyml/nope.cyml")), 1,
  "cyml: and a missing file is an error, not an empty document");

test_group("json: the flat key/value API (v1.5.2)");
var jf_doc = "{\"name\": \"demo\", \"count\": 42, \"on\": true}";
var jf = bayan_json_parse(str_from(jf_doc));
assert_eq(vec_len(jf), 3, "json: the flat parser returns three pairs");
assert_eq(str_eq_cstr(bayan_json_key(vec_get(jf, 0)), "name"), 1, "json: key");
assert_eq(str_eq_cstr(bayan_json_value(vec_get(jf, 0)), "demo"), 1, "json: value");
assert_eq(bayan_json_get_int(jf, str_from("count")), 42, "json: get_int");
assert_eq(bayan_json_get_int(jf, str_from("absent")), 0, "json: get_int on a missing key is 0");
var jf_p = bayan_json_pair_new(str_from("k"), str_from("v"));
assert_eq(str_eq_cstr(bayan_json_key(jf_p), "k"), 1, "json: pair_new");
var jf_arena = arena_allocator(8192);
assert_eq(str_eq_cstr(bayan_json_key(bayan_json_pair_new_a(jf_arena, str_from("k2"), str_from("v2"))), "k2"), 1,
  "json: pair_new_a");
var jf_out = vec_new();
vec_push(jf_out, bayan_json_pair_new(str_from("a"), str_from("1")));
assert_gt(str_len(bayan_json_build(jf_out)), 0, "json: build emits a document");
assert_eq(str_contains_cstr(bayan_json_build(jf_out), "\"a\""), 1, "json: containing the key");

test_group("json: file loaders read the WHOLE file (v1.5.1 regression)");
# A fixed 16 KiB buffer used to truncate mid-token and report success: a
# 52 KB / 2,001-key object parsed to 630 pairs. build/ is gitignored.
var jl_sb = str_builder_new();
str_builder_putc(jl_sb, 123);
var jl_i = 0;
while (jl_i < 3000) {
    if (jl_i > 0) { str_builder_putc(jl_sb, 44); }
    str_builder_add_cstr(jl_sb, "\"k");
    str_builder_add_int(jl_sb, jl_i);
    str_builder_add_cstr(jl_sb, "\":");
    str_builder_add_int(jl_sb, jl_i);
    jl_i = jl_i + 1;
}
str_builder_putc(jl_sb, 125);
var jl_big = str_builder_build(jl_sb);
assert_gt(str_len(jl_big), 16384, "json: the fixture exceeds the old 16 KiB cap");
file_write_all("build/big-generated.json", str_data(jl_big), str_len(jl_big));
var jl_pairs = bayan_json_parse_file("build/big-generated.json");
assert_eq(vec_len(jl_pairs), 3000, "json: parse_file reads every pair, not the first 630");
assert_neq(bayan_json_get(jl_pairs, str_from("k2999")), 0, "json: including the last key");
var jl_r = bayan_json_parse_file_r("build/big-generated.json");
assert_eq(is_err_result(jl_r), 0, "json: parse_file_r succeeds");
assert_eq(vec_len(load64(jl_r + 8)), 3000, "json: and returns every pair too");
assert_eq(is_err_result(bayan_json_parse_file_r("build/does-not-exist.json")), 1,
  "json: a missing file is an error");

test_group("json: value-tree constructors and accessors (v1.5.2)");
var jv_a = arena_allocator(16384);
assert_eq(bayan_json_v_tag(bayan_json_v_null()), JTAG_NULL, "json: null/tag");
assert_eq(bayan_json_v_tag(bayan_json_v_null_a(jv_a)), JTAG_NULL, "json: null_a");
assert_eq(bayan_json_v_is_bool(bayan_json_v_bool_new(1)), 1, "json: bool_new/is_bool");
assert_eq(bayan_json_v_bool(bayan_json_v_bool_new_a(jv_a, 0)), 0, "json: bool_new_a");
assert_eq(bayan_json_v_is_str(bayan_json_v_str_new(str_from("s"))), 1, "json: str_new/is_str");
assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_str_new_a(jv_a, str_from("t"))), "t"), 1, "json: str_new_a");
# A float carries an f64 BIT PATTERN, not a value — 1.0 is 4607182418800017408.
var jv_f = bayan_json_v_float_new(4607182418800017408);
assert_eq(bayan_json_v_float(jv_f), 4607182418800017408, "json: float_new round-trips its bits");
assert_eq(bayan_json_v_tag(bayan_json_v_float_new_a(jv_a, 0)), JTAG_FLOAT, "json: float_new_a");
var jv_arr = bayan_json_v_arr_new();
bayan_json_v_arr_push(jv_arr, bayan_json_v_int_new(1));
bayan_json_v_arr_push_a(jv_a, jv_arr, bayan_json_v_int_new(2));
assert_eq(bayan_json_v_arr_len(jv_arr), 2, "json: arr_push and arr_push_a both append");
var jv_obj = bayan_json_v_parse_buf("{\"x\":1,\"y\":2}", 13);
assert_eq(str_eq_cstr(bayan_json_v_obj_key(jv_obj, 0), "x"), 1, "json: obj_key by index");
assert_eq(bayan_json_v_int(bayan_json_v_obj_val(jv_obj, 1)), 2, "json: obj_val by index");
assert_eq(bayan_json_v_obj_key(jv_obj, 99), 0, "json: an out-of-range index returns 0 rather than aborting");
# 1.4.1 added obj_get_by_str precisely because obj_get takes a CSTRING and
# passing a Str made strlen walk the 16-byte header and return a silent
# not-found. Until now the fix itself had no test.
assert_eq(bayan_json_v_int(bayan_json_v_obj_get_by_str(jv_obj, str_from("y"))), 2,
  "json: obj_get_by_str accepts a Str, which obj_get cannot");
assert_eq(bayan_json_v_obj_get_by_str(jv_obj, str_from("nope")), 0, "json: and returns 0 when absent");

test_group("json: the remaining parse and pointer entry points (v1.5.2)");
var jp_ps[48];
assert_neq(bayan_json_v_parse_ctx_str(&jp_ps, str_from("[1,2]")), 0, "json: parse_ctx_str takes a Str");
assert_eq(bayan_json_v_arr_len(bayan_json_v_parse_a(jv_a, str_from("[1,2,3]"))), 3, "json: parse_a");
var jp_v = bayan_json_v_parse_buf("{\"a\":{\"b\":7}}", 13);
assert_eq(bayan_json_v_int(bayan_json_v_pointer_cstr(jp_v, "/a/b", 4)), 7, "json: pointer_cstr");
assert_eq(bayan_json_v_pointer_cstr(jp_v, "/a/zz", 5), 0, "json: and 0 for a path that does not exist");
assert_eq(bayan_json_v_parse_buf("{bad", 4), 0, "json: a malformed document is rejected");
assert_gt(bayan_json_last_error_pos(), 0 - 2, "json: last_error_pos is populated after a failure");

test_group("pdf: object cells — the _a twins and the remaining accessors (v1.5.2)");
var pa = arena_allocator(65536);
assert_eq(bayan_pdf_obj_tag(bayan_pdf_obj_null_a(pa)), PTAG_NULL, "pdf: obj_null_a");
assert_eq(bayan_pdf_obj_bool_value(bayan_pdf_obj_bool_new_a(pa, 1)), 1, "pdf: obj_bool_new_a");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_int_new_a(pa, 9)), 9, "pdf: obj_int_new_a");
assert_eq(bayan_pdf_obj_real_places(bayan_pdf_obj_real_new_a(pa, 5, 1)), 1, "pdf: obj_real_new_a");
assert_eq(str_eq_cstr(bayan_pdf_obj_name(bayan_pdf_obj_name_new_a(pa, "N")), "N"), 1, "pdf: obj_name_new_a");
var ps_str = bayan_pdf_obj_string_new(str_from("hi"));
assert_eq(bayan_pdf_obj_is_string(ps_str), 1, "pdf: obj_string_new/is_string");
assert_eq(bayan_pdf_obj_is_hex(ps_str), 0, "pdf: a literal string is not a hex string");
assert_eq(str_eq_cstr(bayan_pdf_obj_bytes(bayan_pdf_obj_string_new_a(pa, str_from("hi"))), "hi"), 1,
  "pdf: obj_string_new_a");
var ps_hex = bayan_pdf_obj_hex_new(str_from("hi"));
assert_eq(bayan_pdf_obj_is_hex(ps_hex), 1, "pdf: obj_hex_new is flagged as hex");
assert_eq(bayan_pdf_obj_is_hex(bayan_pdf_obj_hex_new_a(pa, str_from("hi"))), 1, "pdf: obj_hex_new_a");
assert_eq(bayan_pdf_obj_is_num(bayan_pdf_obj_int_new(1)), 1, "pdf: an int is a number");
assert_eq(bayan_pdf_obj_is_num(bayan_pdf_obj_real_new(1, 1)), 1, "pdf: so is a real");
assert_eq(bayan_pdf_obj_is_num(ps_str), 0, "pdf: a string is not");
assert_eq(bayan_pdf_obj_is_name(bayan_pdf_obj_name_new("X")), 1, "pdf: is_name");
var pa_arr = bayan_pdf_obj_array_new_a(pa);
bayan_pdf_obj_array_push_a(pa, pa_arr, bayan_pdf_obj_int_new_a(pa, 4));
assert_eq(bayan_pdf_obj_array_len(pa_arr), 1, "pdf: obj_array_new_a + array_push_a");
var pa_d = bayan_pdf_obj_dict_new_a(pa);
bayan_pdf_obj_dict_set_a(pa, pa_d, "K", bayan_pdf_obj_int_new_a(pa, 5));
assert_eq(bayan_pdf_obj_dict_len(pa_d), 1, "pdf: obj_dict_new_a + dict_set_a");
assert_eq(str_eq_cstr(bayan_pdf_obj_dict_key(pa_d, 0), "K"), 1, "pdf: obj_dict_key by index");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_dict_value(pa_d, 0)), 5, "pdf: obj_dict_value by index");
assert_eq(str_len(bayan_pdf_obj_dict_key(pa_d, 99)), 0,
  "pdf: an out-of-range dict index gives an empty Str, never an abort");
assert_eq(bayan_pdf_obj_int_value(bayan_pdf_obj_dict_get_by_str(pa_d, str_from("K"))), 5,
  "pdf: obj_dict_get_by_str takes a Str where obj_dict_get takes a cstring");
var pa_st = bayan_pdf_obj_stream_new_a(pa, pa_d, str_from("DATA"));
assert_eq(bayan_pdf_obj_is_stream(pa_st), 1, "pdf: obj_stream_new_a/is_stream");
assert_eq(bayan_pdf_obj_dict_len(bayan_pdf_obj_stream_dict(pa_st)), 1, "pdf: obj_stream_dict");
# stream_raw is the ON-DISK form. A writer-built stream has none until it is
# emitted — the payload lives in the decoded slot — so an empty Str here is the
# documented state, not a loss.
assert_eq(str_len(bayan_pdf_obj_stream_raw(pa_st)), 0,
  "pdf: obj_stream_raw is empty for a stream the writer has not emitted yet");
var pa_ref = bayan_pdf_obj_ref_new_a(pa, 3, 7);
assert_eq(bayan_pdf_obj_ref_num(pa_ref), 3, "pdf: obj_ref_new_a number");
assert_eq(bayan_pdf_obj_ref_gen(pa_ref), 7, "pdf: obj_ref_gen");
assert_eq(str_eq_cstr(bayan_pdf_obj_to_bytes_a(pa, bayan_pdf_obj_int_new(8)), "8"), 1, "pdf: obj_to_bytes_a");

test_group("pdf: measurement and transcoding entry points (v1.5.2)");
assert_eq(bayan_pdf_text_width_buf(PDF_FONT_COURIER, 12000, "AAAA", 4), 28800, "pdf: text_width_buf");
assert_gt(vec_len(bayan_pdf_wrap_a(pa, PDF_FONT_HELVETICA, 11000, 60000,
      str_from("some words that will not fit on one short line"))), 1, "pdf: wrap_a");
assert_eq(bayan_pdf_winansi_stats_size(), 16, "pdf: winansi_stats_size");
var pw_st[16];
assert_eq(str_len(bayan_pdf_winansi_a(pa, str_from("abc"), PDF_WINANSI_STRICT, &pw_st)), 3, "pdf: winansi_a");
assert_eq(str_eq_cstr(bayan_pdf_from_winansi_a(pa, str_from("abc")), "abc"), 1, "pdf: from_winansi_a");

test_group("pdf: the writer's text and graphics operators (v1.5.2)");
var pw = bayan_pdf_new_a(pa);
assert_neq(pw, 0, "pdf: new_a");
bayan_pdf_set_version(pw, 14);
bayan_pdf_set_id(pw, str_from("aaaa"), str_from("bbbb"));
var pwp = bayan_pdf_add_page(pw, bayan_pdf_page_size_w(PDF_PAGE_A4), bayan_pdf_page_size_h(PDF_PAGE_A4));
assert_eq(bayan_pdf_use_font(pw, pwp, PDF_FONT_HELVETICA) != 0, 1, "pdf: use_font returns a resource name");
assert_eq(bayan_pdf_text_begin(pwp), 0, "pdf: text_begin");
assert_eq(bayan_pdf_text_font(pwp, PDF_FONT_HELVETICA, 12000), 0, "pdf: text_font");
assert_eq(bayan_pdf_text_leading(pwp, 14000), 0, "pdf: text_leading");
assert_eq(bayan_pdf_text_char_spacing(pwp, 100), 0, "pdf: text_char_spacing");
assert_eq(bayan_pdf_text_word_spacing(pwp, 200), 0, "pdf: text_word_spacing");
assert_eq(bayan_pdf_text_pos(pwp, 72000, 700000), 0, "pdf: text_pos");
assert_eq(bayan_pdf_text_show_line(pwp, str_from("one")), 0, "pdf: text_show_line");
assert_eq(bayan_pdf_text_next_line(pwp), 0, "pdf: text_next_line");
assert_eq(bayan_pdf_text_end(pwp), 0, "pdf: text_end");
assert_eq(bayan_pdf_gsave(pwp), 0, "pdf: gsave");
assert_eq(bayan_pdf_set_line_width(pwp, 500), 0, "pdf: set_line_width");
assert_eq(bayan_pdf_set_gray(pwp, 500), 0, "pdf: set_gray");
assert_eq(bayan_pdf_set_rgb(pwp, 100, 200, 300), 0, "pdf: set_rgb");
assert_eq(bayan_pdf_move_to(pwp, 10000, 10000), 0, "pdf: move_to");
assert_eq(bayan_pdf_line_to(pwp, 20000, 20000), 0, "pdf: line_to");
assert_eq(bayan_pdf_stroke(pwp), 0, "pdf: stroke");
assert_eq(bayan_pdf_grestore(pwp), 0, "pdf: grestore");
assert_eq(bayan_pdf_raw_op(pwp, str_from("0 0 1 rg")), 0, "pdf: raw_op accepts a safe operator");
assert_eq(bayan_pdf_doc_error_pos(pw), 0 - 1, "pdf: doc_error_pos is -1 for writer-side state");
var pw_bytes = bayan_pdf_to_bytes_a(pa, pw);
assert_gt(str_len(pw_bytes), 400, "pdf: to_bytes_a serialises the document");
assert_eq(memeq(str_data(pw_bytes), "%PDF-1.4", 8), 1, "pdf: set_version selected the header");
assert_eq(bayan_pdf_write_file(pw, "build/pdf-v152.pdf"), 0, "pdf: write_file succeeds");
assert_neq(bayan_pdf_write_file(pw, "build/no-such-dir/x.pdf"), 0, "pdf: and reports a bad path");

test_group("pdf: the remaining reader entry points (v1.5.2)");
var pr = bayan_pdf_parse_a(pa, pw_bytes);
assert_neq(pr, 0, "pdf: parse_a");
assert_eq(bayan_pdf_version(pr), 14, "pdf: version reads the header");
assert_gt(bayan_pdf_obj_count(pr), 0, "pdf: obj_count");
assert_neq(bayan_pdf_trailer(pr), 0, "pdf: trailer");
assert_neq(bayan_pdf_dict_lookup(pr, bayan_pdf_catalog(pr), "Pages"), 0, "pdf: dict_lookup resolves through a ref");
assert_neq(bayan_pdf_resolve(pr, bayan_pdf_obj_dict_get(bayan_pdf_catalog(pr), "Pages")), 0, "pdf: resolve");
var pr_pg = bayan_pdf_page(pr, 0);
assert_neq(bayan_pdf_page_dict(pr_pg), 0, "pdf: page_dict");
# page_number is the page dictionary's OBJECT number, not its index in the
# document — a distinction worth pinning, since 0 would be a plausible guess.
assert_gt(bayan_pdf_page_number(pr_pg), 0, "pdf: page_number is the page's object number");
assert_gt(str_len(bayan_pdf_page_content(pr, pr_pg)), 0, "pdf: page_content");
assert_gt(str_len(bayan_pdf_page_content_a(pa, pr, pr_pg)), 0, "pdf: page_content_a");
assert_eq(str_contains_cstr(bayan_pdf_page_extract_text(pr, pr_pg), "one"), 1, "pdf: page_extract_text");
assert_eq(str_contains_cstr(bayan_pdf_page_extract_text_a(pa, pr, pr_pg), "one"), 1, "pdf: page_extract_text_a");
assert_eq(str_contains_cstr(bayan_pdf_extract_text_a(pa, pr), "one"), 1, "pdf: extract_text_a");
var pr_ps[64];
assert_neq(bayan_pdf_parse_ctx(&pr_ps, str_data(pw_bytes), str_len(pw_bytes)), 0, "pdf: parse_ctx");
assert_neq(bayan_pdf_parse_ctx_a(pa, &pr_ps, str_data(pw_bytes), str_len(pw_bytes)), 0, "pdf: parse_ctx_a");
assert_neq(bayan_pdf_parse_buf(str_data(pw_bytes), str_len(pw_bytes)), 0, "pdf: parse_buf");
assert_eq(bayan_pdf_state_error_pos(&pr_ps), 0 - 1, "pdf: state_error_pos is -1 on a clean parse");
assert_eq(is_err_result(bayan_pdf_parse_file_r("build/does-not-exist.pdf")), 1, "pdf: parse_file_r on a missing file");
# A content stream is not an image; the predicate exists so a caller can tell.
var pr_c = bayan_pdf_obj_dict_get(bayan_pdf_page_dict(pr_pg), "Contents");
assert_eq(bayan_pdf_stream_is_image(pr, bayan_pdf_resolve(pr, pr_c)), 0, "pdf: stream_is_image is 0 for content");
assert_gt(str_len(bayan_pdf_stream_data(pr, bayan_pdf_resolve(pr, pr_c))), 0, "pdf: stream_data");
assert_gt(str_len(bayan_pdf_stream_data_a(pa, pr, bayan_pdf_resolve(pr, pr_c))), 0, "pdf: stream_data_a");
assert_gt(bayan_pdf_last_error_pos(), 0 - 2, "pdf: last_error_pos is readable");

var r = assert_summary();
