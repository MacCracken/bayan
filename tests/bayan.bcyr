# bayan benchmarks
#
# Until 1.5.0 this file measured a no-op and reported `noop: 2ns avg`, so the
# CI bench gate was a false green and docs/benchmarks.md did not exist. It now
# measures the operations a consumer actually pays for: the PDF object grammar,
# font metric measurement, metric word wrap, whole-document serialisation, and
# whole-document parse + text extraction. 1.5.7 adds the f64 parser, once per
# tier, because making it correctly rounded moved cost onto the hard inputs.
# 1.6.0 adds the cyml parse, after a consumer found it twice as slow as it
# had been since 1.5.1, a change no row here could have shown. 1.6.1 adds a
# single-entry cyml document with a long header, for the --- search. 1.9.0 adds
# markdown parse and render, through an arena reset between documents, the
# pattern a consumer rendering notes one after another uses.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop ->
# bench_report. For sub-microsecond operations use a batch of >= 1000 to
# amortise the ~240 ns clock_gettime start/stop overhead on x86_64 Linux; the
# document-level benchmarks below are far above that, so they use small batches.
#
# NOTE: a file carrying include directives skips the [deps].stdlib
# auto-prepend, so the stdlib prerequisites are listed explicitly.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/slice.cyr"
include "lib/math.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/unicode/categories.cyr"
include "lib/unicode/casefold.cyr"

include "src/pdf.cyr"
include "src/dtoa.cyr"
include "src/cyml.cyr"
include "src/toml.cyr"
include "src/json.cyr"
include "src/toml_tree.cyr"
include "src/markdown_entities.cyr"
include "src/markdown.cyr"

var B_DICT = "<</Type/Page/Parent 2 0 R/MediaBox[0 0 595 842]/Contents 5 0 R/Resources<</Font<</F1 3 0 R>>>>>>";
var B_PROSE = "The quick brown fox jumps over the lazy dog and keeps on running well past the right edge of any column you care to name";

fn main(): i64 {
    alloc_init();
    bench_report_clock();

    # --- the object grammar -------------------------------------------------
    # A page dictionary is the shape the reader meets most often: nested dicts,
    # an array, and three indirect references, each of which costs the
    # three-token "N G R" lookahead with backtracking.
    var b1 = bench_new("pdf_obj_parse (page dict, 97 bytes)");
    var n1 = strlen(B_DICT);
    bench_batch_start(b1);
    var i = 0;
    while (i < 10000) { bayan_pdf_obj_parse_buf(B_DICT, n1); i = i + 1; }
    bench_batch_stop(b1, 10000);
    bench_report(b1);

    # --- font metrics -------------------------------------------------------
    # Measured width is what makes wrapping correct, so it sits in the inner
    # loop of every laid-out paragraph. It sums 1/1000-em widths and scales
    # once, so it is one pass over the bytes plus one multiply-divide.
    var b2 = bench_new("pdf_text_width (120 chars, Helvetica)");
    var prose = str_from(B_PROSE);
    bench_batch_start(b2);
    i = 0;
    while (i < 100000) { bayan_pdf_text_width(PDF_FONT_HELVETICA, 11000, prose); i = i + 1; }
    bench_batch_stop(b2, 100000);
    bench_report(b2);

    # --- metric word wrap ---------------------------------------------------
    var b3 = bench_new("pdf_wrap (120 chars into a 200pt column)");
    bench_batch_start(b3);
    i = 0;
    while (i < 10000) { bayan_pdf_wrap(PDF_FONT_HELVETICA, 11000, 200000, prose); i = i + 1; }
    bench_batch_stop(b3, 10000);
    bench_report(b3);

    # --- WinAnsi transcode --------------------------------------------------
    var b4 = bench_new("pdf_winansi (120 chars, ASCII fast path)");
    var st[16];
    bench_batch_start(b4);
    i = 0;
    while (i < 100000) { bayan_pdf_winansi(prose, PDF_WINANSI_SUBSTITUTE, &st); i = i + 1; }
    bench_batch_stop(b4, 100000);
    bench_report(b4);

    # --- whole-document write -----------------------------------------------
    # 50 text runs on one page, which is roughly a full page of body copy.
    var doc = bayan_pdf_new();
    var pg = bayan_pdf_add_page(doc, bayan_pdf_page_size_w(PDF_PAGE_A4), bayan_pdf_page_size_h(PDF_PAGE_A4));
    i = 0;
    while (i < 50) {
        bayan_pdf_text_at(pg, PDF_FONT_HELVETICA, 11000, 72000, 760000 - i * 14000, prose);
        i = i + 1;
    }
    var b5 = bench_new("pdf_to_bytes (1 page, 50 text runs)");
    bench_batch_start(b5);
    i = 0;
    while (i < 1000) { bayan_pdf_to_bytes(doc); i = i + 1; }
    bench_batch_stop(b5, 1000);
    bench_report(b5);

    # --- whole-document read ------------------------------------------------
    # Parse and extract from what we just wrote, so the two halves are measured
    # against the same content rather than against different fixtures.
    var bytes = bayan_pdf_to_bytes(doc);
    var b6 = bench_new("pdf_parse (1 page, ~6KB)");
    bench_batch_start(b6);
    i = 0;
    while (i < 1000) { bayan_pdf_parse(bytes); i = i + 1; }
    bench_batch_stop(b6, 1000);
    bench_report(b6);

    var rd = bayan_pdf_parse(bytes);
    var b7 = bench_new("pdf_extract_text (1 page, 50 runs)");
    bench_batch_start(b7);
    i = 0;
    while (i < 1000) { bayan_pdf_extract_text(rd); i = i + 1; }
    bench_batch_stop(b7, 1000);
    bench_report(b7);

    # --- f64 parsing, one input per tier (1.5.7) ----------------------------
    # Tier 1 (Clinger) is one IEEE multiply; tier 2 (DiyFp) answers most other
    # inputs; tier 3 (the exact decimal) runs only inside tier 2's error window,
    # ~0.6% of shortest-repr inputs and ~1.8% of arbitrary ones. The two tier 3
    # rows are the cost of being right where the old parser was not: the first
    # is issue 2026-09-22's vector 1, the second an exact binary tie.
    var b8 = bench_new("f64_parse (tier 1: 2.718281828459045)");
    bench_batch_start(b8);
    i = 0;
    while (i < 100000) { bayan_f64_parse("2.718281828459045", 17); i = i + 1; }
    bench_batch_stop(b8, 100000);
    bench_report(b8);

    var b9 = bench_new("f64_parse (tier 2: 1.7976931348623157e308)");
    bench_batch_start(b9);
    i = 0;
    while (i < 100000) { bayan_f64_parse("1.7976931348623157e308", 22); i = i + 1; }
    bench_batch_stop(b9, 100000);
    bench_report(b9);

    var b10 = bench_new("f64_parse (tier 3: 1.621274542797433e-9, a near-tie)");
    bench_batch_start(b10);
    i = 0;
    while (i < 10000) { bayan_f64_parse("1.621274542797433e-9", 20); i = i + 1; }
    bench_batch_stop(b10, 10000);
    bench_report(b10);

    var b11 = bench_new("f64_parse (tier 3: 9007199254740993, an exact tie)");
    bench_batch_start(b11);
    i = 0;
    while (i < 10000) { bayan_f64_parse("9007199254740993", 16); i = i + 1; }
    bench_batch_stop(b11, 10000);
    bench_report(b11);

    # --- cyml parse (1.6.0) --------------------------------------------------
    # A font-shaped document, the shape bannermanor parses on every render: a
    # [font] header, then 95 entries of an 8-row glyph each (8,816 bytes, the
    # size of its fonts/clean.cyml). 1.5.1 - 1.5.14 tested every byte for a
    # marker, twice; a row here would have shown that at 1.5.1.
    var cyb = str_builder_new();
    str_builder_add_cstr(cyb, "# a comment line\n\n[font]\nschema = 1\nname = \"t\"\nwidth = 7\nheight = 8\ngap = 1\n");
    i = 0;
    while (i < 95) {
        str_builder_add_cstr(cyb, "\n[[entries]]\nchar = \"A\"\n---\n");
        var row = 0;
        while (row < 8) { str_builder_add_cstr(cyb, ".#.#.#.\n"); row = row + 1; }
        i = i + 1;
    }
    var cys = str_builder_build(cyb);
    var b12 = bench_new("cyml_parse (95-entry font, 8.8KB)");
    bench_batch_start(b12);
    i = 0;
    while (i < 1000) { bayan_cyml_parse(str_data(cys), str_len(cys)); i = i + 1; }
    bench_batch_stop(b12, 1000);
    bench_report(b12);

    # --- cyml parse, one long header (1.6.1) -----------------------------------
    # One entry: a 200-line TOML header, a ---, a short body (6,922 bytes). A
    # font entry's header is one line, so the row above barely reaches the ---
    # search; this one is nearly all of it. 1.0.0 - 1.6.0 tested every byte
    # for the delimiter: 0.40x of that here.
    var cdb = str_builder_new();
    i = 0;
    while (i < 200) {
        str_builder_add_cstr(cdb, "key_");
        str_builder_add_int(cdb, i);
        str_builder_add_cstr(cdb, " = \"a value of some length\"\n");
        i = i + 1;
    }
    str_builder_add_cstr(cdb, "---\n# Body\n\nSome markdown text.\n");
    var cds = str_builder_build(cdb);
    var b13 = bench_new("cyml_parse (one entry, 200-line header, 6.9KB)");
    bench_batch_start(b13);
    i = 0;
    while (i < 1000) { bayan_cyml_parse(str_data(cds), str_len(cds)); i = i + 1; }
    bench_batch_stop(b13, 1000);
    bench_report(b13);

    # --- markdown -------------------------------------------------------------
    # A note-shaped document: 12 sections of a heading, a paragraph with emphasis,
    # a code span, an inline and a reference link, a tight list, a fenced block,
    # a block quote and a GFM table, then the definitions. Each document gets a
    # fresh arena (reset_via), so the heap does not grow with the batch.
    var mdb = str_builder_new();
    i = 0;
    while (i < 12) {
        str_builder_add_cstr(mdb, "## Section ");
        str_builder_add_int(mdb, i);
        str_builder_add_cstr(mdb, "\n\nSome *emphasised* and **strong** prose with `code`, a [link](https://example.org/a?b=c) and a [reference][r");
        str_builder_add_int(mdb, i);
        str_builder_add_cstr(mdb, "], running on for a line or two so the inline scan has text to cross &amp; entities to decode.\n\n");
        str_builder_add_cstr(mdb, "- first item\n- second item with _underscores_\n- third ~~item~~\n\n```cyr\nfn f(): i64 { return 1; }\n```\n\n");
        str_builder_add_cstr(mdb, "> quoted line one\n> quoted line two\n\n| key | value |\n| --- | ---: |\n| a | 1 |\n| b | 2 |\n\n");
        i = i + 1;
    }
    i = 0;
    while (i < 12) {
        str_builder_add_cstr(mdb, "[r");
        str_builder_add_int(mdb, i);
        str_builder_add_cstr(mdb, "]: https://example.org/ref \"Title\"\n");
        i = i + 1;
    }
    var mds = str_builder_build(mdb);
    var mar = arena_allocator(4194304);
    var b14 = bench_new("markdown_parse (12-section note, GFM, 5.4KB)");
    bench_batch_start(b14);
    i = 0;
    while (i < 200) {
        reset_via(mar);
        bayan_markdown_parse_a(mar, mds, MD_EXT_GFM);
        i = i + 1;
    }
    bench_batch_stop(b14, 200);
    bench_report(b14);

    reset_via(mar);
    var mtree = bayan_markdown_parse_a(mar, mds, MD_EXT_GFM);
    var mhar = arena_allocator(1048576);
    var b15 = bench_new("markdown_to_html (the same note's tree)");
    bench_batch_start(b15);
    i = 0;
    while (i < 200) {
        reset_via(mhar);
        bayan_markdown_to_html_a(mhar, mtree);
        i = i + 1;
    }
    bench_batch_stop(b15, 200);
    bench_report(b15);

    var b16 = bench_new("markdown parse + render (the same note)");
    bench_batch_start(b16);
    i = 0;
    while (i < 200) {
        reset_via(mar);
        bayan_markdown_to_html_a(mar, bayan_markdown_parse_a(mar, mds, MD_EXT_GFM));
        i = i + 1;
    }
    bench_batch_stop(b16, 200);
    bench_report(b16);

    # --- toml (1.11.0) ----------------------------------------------------------
    # A Cargo-shaped manifest: a package table, 30 inline-table dependencies with arrays, 10
    # [[bin]] entries, a dotted-key profile and a server table with a float and a date-time. The
    # tree parse runs on an arena reset between documents; the flat parse beside it, for scale.
    var tsb = str_builder_new();
    str_builder_add_cstr(tsb, "[package]\nname = \"example\"\nversion = \"1.2.3\"\nauthors = [\"A <a@x.org>\", \"B <b@x.org>\"]\nedition = \"2021\"\n\n[dependencies]\n");
    i = 0;
    while (i < 30) {
        str_builder_add_cstr(tsb, "dep");
        str_builder_add_int(tsb, i);
        str_builder_add_cstr(tsb, " = { version = \"1.0\", features = [\"alloc\", \"std\"], optional = false }\n");
        i = i + 1;
    }
    i = 0;
    while (i < 10) {
        str_builder_add_cstr(tsb, "\n[[bin]]\nname = \"tool");
        str_builder_add_int(tsb, i);
        str_builder_add_cstr(tsb, "\"\npath = 'src/bin/tool.rs'  # the entry\n");
        i = i + 1;
    }
    str_builder_add_cstr(tsb, "\n[profile]\nrelease.opt-level = 3\nrelease.lto = true\n\n[server]\nhost = \"0.0.0.0\"\nport = 8_080\ntimeout = 30.5\nstarted = 1979-05-27T07:32:00Z\n");
    var tds = str_builder_build(tsb);
    var tar = arena_allocator(1048576);
    var tb = bench_new("toml_v_parse (Cargo-shaped manifest, 3.1KB)");
    bench_batch_start(tb);
    i = 0;
    while (i < 1000) {
        reset_via(tar);
        bayan_toml_v_parse_a(tar, tds);
        i = i + 1;
    }
    bench_batch_stop(tb, 1000);
    bench_report(tb);

    var tf = bench_new("toml_parse, flat (the same manifest)");
    bench_batch_start(tf);
    i = 0;
    while (i < 1000) {
        bayan_toml_parse(tds);
        i = i + 1;
    }
    bench_batch_stop(tf, 1000);
    bench_report(tf);
    if (bayan_toml_v_parse(tds) == 0) {
        print("toml bench: the manifest did not parse\n", 39);
        return 1;
    }
    print("toml manifest: ", 15);
    fmt_int(str_len(tds));
    print(" bytes\n", 7);

    return 0;
}

var r = main();
syscall(60, r);
