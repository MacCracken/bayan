# tests/parse_scaling.cyr — the json, yaml and flat toml parsers' cost must grow with their input,
# not with its square (1.11.1).
#
# Each of these parsers has to refuse a duplicate key on every key it reads. Done by walking the
# object's keys, that is O(n) a key and O(n^2) a document: yaml's mapping parser did exactly that
# until 1.11.1, and 40,000 keys (480 KB) took 14.4 s. json's three parsers refuse duplicates from
# 1.11.1 through a key set (src/json.cyr, "Duplicate object keys") that answers in O(1), and so
# does yaml now. The flat toml parser found a dotted key's table by walking every table opened
# since the header (20,000 dotted keys, 300 KB, took 4.0 s) and indexes them by name from 1.11.1.
# A wrong answer cannot show that a set or an index is gone or broken, only the cost can, so it is
# checked here by tests/toml_scaling.cyr's method.
#
# Each row times one family at two sizes, eight times apart, in the same process: the FASTEST of
# several runs at each, since load can slow a run down but never speed one up. The row's figure is
# the time ratio over the input ratio: about 1 for a linear path, about 8 for a quadratic one. A
# row fails above 3, three attempts running.
#
#   cyrius build tests/parse_scaling.cyr build/parse-scaling && ./build/parse-scaling
#   cyrius build --aarch64 tests/parse_scaling.cyr build/parse-scaling-a64
#   qemu-aarch64 build/parse-scaling-a64
#
# Exit code = the number of rows over the limit.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/slice.cyr"
include "lib/math.cyr"
include "lib/fnptr.cyr"
include "lib/mmap.cyr"
include "lib/chrono.cyr"

include "src/dtoa.cyr"
include "src/json.cyr"
include "src/yaml.cyr"
include "src/toml.cyr"

var LIMIT10 = 30;       # the limit, x10: 3.0
var ROUNDS = 3;
const CAP = 16777216;
var g_buf = 0;
var g_h = 0;

fn say(m: cstring): i64 { print(m, strlen(m)); return 0; }

fn put(at, s): i64 {
    var n = strlen(s);
    memcpy(g_buf + at, s, n);
    return at + n;
}

fn put_int(at, v): i64 {
    var b[24];
    var l = fmt_int_buf(v, &b);
    memcpy(g_buf + at, &b, l);
    return at + l;
}

# Family f at size k into g_buf; its length.
fn build(f, k): i64 {
    var n = 0;
    var i = 0;
    if (f == 0) {                       # yaml: one mapping of k keys
        while (i < k) { n = put(n, "k"); n = put_int(n, 1000000 + i); n = put(n, ": 1\n"); i = i + 1; }
    } elif (f == 4) {                   # flat toml: k dotted keys, each its own table
        while (i < k) { n = put(n, "k"); n = put_int(n, 1000000 + i); n = put(n, ".x = 1\n"); i = i + 1; }
    } else {                            # json: one object of k keys
        n = put(n, "{");
        while (i < k) {
            if (i > 0) { n = put(n, ","); }
            n = put(n, "\"k");
            n = put_int(n, 1000000 + i);
            n = put(n, "\":1");
            i = i + 1;
        }
        n = put(n, "}");
    }
    return n;
}

# Parse g_buf[0..n) by row f's parser: 1 when it parsed.
fn parse(f, n): i64 {
    if (f == 0) { return bayan_yaml_parse_buf(g_buf, n) != 0; }
    if (f == 1) { return bayan_json_v_parse_buf(g_buf, n) != 0; }
    if (f == 2) { return bayan_json_parse(str_new(g_buf, n)) != 0; }
    if (f == 4) { return bayan_toml_parse(str_new(g_buf, n)) != 0; }
    return bayan_json_stream_parse(g_buf, n, g_h) == 0;
}

# The fastest of ROUNDS parses of g_buf[0..n), in ns. A parse that fails is a failed row.
fn best(f, n): i64 {
    var b = 0;
    var r = 0;
    while (r < ROUNDS) {
        alloc_reset();
        var t0 = clock_now_ns();
        var ok = parse(f, n);
        var dt = clock_now_ns() - t0;
        if (ok == 0) {
            say("  the document did not parse\n");
            return 0 - 1;
        }
        if (r == 0 || dt < b) { b = dt; }
        r = r + 1;
    }
    if (b < 1) { b = 1; }
    return b;
}

# One measurement of family f: 1 when over the limit.
fn attempt(f, label: cstring, k1, k2): i64 {
    var fb = f;
    if (fb == 2 || fb == 3) { fb = 1; }
    var n1 = build(fb, k1);
    var t1 = best(f, n1);
    var n2 = build(fb, k2);
    var t2 = best(f, n2);
    if (t1 < 0 || t2 < 0) { return 1; }
    var x10 = (t2 * 10 * n1) / (t1 * n2);       # (t2 / t1) / (n2 / n1), one decimal
    var over = 0;
    if (x10 > LIMIT10) { over = 1; }
    if (over == 1) { say("  SLOW  "); } else { say("  ok    "); }
    say(label);
    fmt_int(x10 / 10); say("."); fmt_int(x10 % 10); say(" (");
    fmt_int(n1); say(" bytes in "); fmt_int(t1 / 1000); say(" us, ");
    fmt_int(n2); say(" in "); fmt_int(t2 / 1000); say(" us), limit 3.0\n");
    return over;
}

fn row(f, label: cstring, k1, k2): i64 {
    var a = 0;
    while (a < 3) {
        if (attempt(f, label, k1, k2) == 0) { return 0; }
        a = a + 1;
    }
    return 1;
}

fn main(): i64 {
    alloc_init();
    g_buf = mmap_anon(CAP);
    if (g_buf == 0) { say("parse scaling: mmap failed\n"); return 99; }
    # A handler with every callback 0, outside the heap alloc_reset rewinds.
    g_h = mmap_anon(4096);
    if (g_h == 0) { say("parse scaling: mmap failed\n"); return 99; }
    say("bayan's parsers: time ratio over input ratio, between two sizes of each input\n");
    var slow = 0;
    slow = slow + row(0, "yaml: keys in one mapping         ", 2000, 16000);
    slow = slow + row(1, "json tree: keys in one object     ", 4000, 32000);
    slow = slow + row(2, "json flat: keys in one object     ", 4000, 32000);
    slow = slow + row(3, "json stream: keys in one object   ", 4000, 32000);
    slow = slow + row(4, "flat toml: dotted keys            ", 2000, 16000);
    return slow;
}

var r = main();
syscall(SYS_EXIT, r);
